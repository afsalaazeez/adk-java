        when(recording1.toolRecording()).thenReturn(Optional.of(toolRecording1));
        when(recording1.llmRecording()).thenReturn(Optional.empty());
        when(recording2.agentName()).thenReturn(agentName);
        when(recording2.userMessageIndex()).thenReturn(7);
        when(recording2.toolRecording()).thenReturn(Optional.of(toolRecording2));
        when(recording2.llmRecording()).thenReturn(Optional.empty());
        Recordings recordings = mock(Recordings.class);
        when(recordings.recordings()).thenReturn((List<Recording>) List.of(recording1, recording2));
        replayPlugin.invocationStates.put(invocationId, new InvocationReplayState("dirMulti", 7, recordings));
        // First call
        replayPlugin.beforeToolCallback(baseTool, toolArgs, toolContext);
        Assertions.assertEquals(1, ((InvocationReplayState)replayPlugin.invocationStates.get(invocationId)).getAgentReplayIndex(agentName));
        // Second call
        replayPlugin.beforeToolCallback(baseTool, toolArgs, toolContext);
        Assertions.assertEquals(2, ((InvocationReplayState)replayPlugin.invocationStates.get(invocationId)).getAgentReplayIndex(agentName));
    }
    // FakeToolResponse is for test, mimics toolResponse().get().response().get()
    public static class FakeToolResponse {
        private final Map<String, Object> response;
        public FakeToolResponse(Map<String, Object> response) {
            this.response = response;
        }
        public Optional<Map<String, Object>> response() {
            return Optional.ofNullable(response);
        }
    }
}