        when(recording2.agentName()).thenReturn("agent2");
        when(recording2.userMessageIndex()).thenReturn(0);
        when(recording2.toolRecording()).thenReturn(Optional.of(toolRecording2));
        when(recording2.llmRecording()).thenReturn(Optional.empty());
        when(toolRecording2.toolCall()).thenReturn(Optional.empty());
        when(toolRecording2.toolResponse()).thenReturn(Optional.of(response2));
        recordings.add(recording2);
        
