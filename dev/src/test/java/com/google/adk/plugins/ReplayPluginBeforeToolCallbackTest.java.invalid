    @Test
    @Tag("boundary")
    void nonAgentToolRunAsyncReturnsNull_handlesGracefully() {
        Map<String, Object> sessionState = new HashMap<>();
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", "/test/path");
        replayConfig.put("user_message_index", 0);
        sessionState.put("_adk_replay_config", replayConfig);
        
        Map<String, Object> recordedResponse = new HashMap<>();
        recordedResponse.put("result", "recorded");
        
        List<Recording> recordings = new ArrayList<>();
        Recording recording = mock(Recording.class);
        when(recording.agentName()).thenReturn("test_agent");
        when(recording.userMessageIndex()).thenReturn(0);
        when(recording.toolRecording()).thenReturn(Optional.of(mockToolRecording));
        when(recording.llmRecording()).thenReturn(Optional.empty());
        recordings.add(recording);
        
        when(mockRecordings.recordings()).thenReturn(recordings);
        when(mockToolRecording.toolCall()).thenReturn(Optional.empty());
        when(mockToolRecording.toolResponse()).thenReturn(Optional.of(recordedResponse));
        
        InvocationReplayState state = new InvocationReplayState("/test/path", 0, mockRecordings);
        replayPlugin.invocationStates.put("test-invocation-id", state);
        
        when(mockToolContext.state()).thenReturn(sessionState);
        when(mockToolContext.invocationId()).thenReturn("test-invocation-id");
        when(mockToolContext.agentName()).thenReturn("test_agent");
        when(mockTool.name()).thenReturn("test_tool");
        when(mockTool.runAsync(any(), any())).thenReturn(Single.just(null));
        
        Maybe<Map<String, Object>> result = replayPlugin.beforeToolCallback(mockTool, new HashMap<>(), mockToolContext);
        
        Map<String, Object> resultMap = result.blockingGet();
        assertNotNull(resultMap);
        assertEquals("recorded", resultMap.get("result"));
    }
