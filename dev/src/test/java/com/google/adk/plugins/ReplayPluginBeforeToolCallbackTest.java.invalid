import com.google.adk.plugins.recordings.Recordings;
import com.google.adk.plugins.recordings.ToolRecording;
import com.google.adk.tools.AgentTool;
import com.google.adk.tools.BaseTool;
import com.google.adk.tools.ToolContext;
import com.google.genai.types.FunctionCall;
import io.reactivex.rxjava3.core.Maybe;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Optional;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.junit.jupiter.api.*;
import com.google.adk.agents.CallbackContext;
import com.google.adk.agents.InvocationContext;
import com.google.adk.models.LlmRequest;
import com.google.adk.models.LlmResponse;
import com.google.adk.plugins.recordings.LlmRecording;
import com.google.adk.plugins.recordings.RecordingsLoader;
import com.google.genai.types.Content;
import io.reactivex.rxjava3.core.Completable;
import java.io.IOException;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.concurrent.ConcurrentHashMap;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

class ReplayPluginBeforeToolCallbackTest {
    private ReplayPlugin replayPlugin;
    @Mock
    private BaseTool mockTool;
    @Mock
    private AgentTool mockAgentTool;
    @Mock
    private ToolContext mockToolContext;
    @Mock
    private InvocationReplayState mockState;
    @Mock
    private ToolRecording mockToolRecording;
    @Mock
    private Recordings mockRecordings;
    @Mock
    private Recording mockRecording;
    private Map<String, Object> toolArgs;
    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        replayPlugin = new ReplayPlugin();
        toolArgs = new HashMap<>();
        toolArgs.put("param1", "value1");
        toolArgs.put("param2", 123);
    }
    @Test
    @Tag("valid")
    void replayModeOffReturnsEmptyMaybe() {
        when(mockToolContext.state()).thenReturn(new HashMap<>());
        Maybe<Map<String, Object>> result = replayPlugin.beforeToolCallback(mockTool, toolArgs, mockToolContext);
        assertTrue(result.isEmpty().blockingGet());
    }
    @Test
    @Tag("invalid")
    void replayModeOnWithNullInvocationStateThrowsReplayConfigError() {
        Map<String, Object> sessionState = new HashMap<>();
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", "/test/dir");
        replayConfig.put("user_message_index", 0);
        sessionState.put("_adk_replay_config", replayConfig);
        when(mockToolContext.state()).thenReturn(sessionState);
        when(mockToolContext.invocationId()).thenReturn("invocation-123");
        ReplayConfigError exception = assertThrows(ReplayConfigError.class, () -> {
            replayPlugin.beforeToolCallback(mockTool, toolArgs, mockToolContext);
        });
        assertTrue(exception.getMessage().contains("Replay state not initialized"));
        assertTrue(exception.getMessage().contains("Ensure beforeRunCallback created it"));
    }
    @Test
    @Tag("valid")
    void successfulReplayWithNonAgentToolAndValidRecording() {
        Map<String, Object> sessionState = new HashMap<>();
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", "/test/dir");
        replayConfig.put("user_message_index", 0);
        sessionState.put("_adk_replay_config", replayConfig);
        Map<String, Object> expectedResponse = new HashMap<>();
        expectedResponse.put("result", "success");
        when(mockToolContext.state()).thenReturn(sessionState);
        when(mockToolContext.invocationId()).thenReturn("invocation-123");
        when(mockToolContext.agentName()).thenReturn("testAgent");
        when(mockTool.name()).thenReturn("testTool");
        when(mockTool.runAsync(eq(toolArgs), eq(mockToolContext))).thenReturn(Maybe.just(expectedResponse));
        when(mockToolRecording.toolResponse()).thenReturn(Optional.of(expectedResponse));
        replayPlugin.invocationStates.put("invocation-123", mockState);
        when(mockState.getAgentReplayIndex("testAgent")).thenReturn(0);
        when(mockState.getUserMessageIndex()).thenReturn(0);
        when(mockState.getRecordings()).thenReturn(mockRecordings);
        when(mockRecordings.recordings()).thenReturn(List.of(mockRecording));
        when(mockRecording.agentName()).thenReturn("testAgent");
        when(mockRecording.userMessageIndex()).thenReturn(0);
        when(mockRecording.toolRecording()).thenReturn(Optional.of(mockToolRecording));
        when(mockRecording.llmRecording()).thenReturn(Optional.empty());
        Maybe<Map<String, Object>> result = replayPlugin.beforeToolCallback(mockTool, toolArgs, mockToolContext);
        assertFalse(result.isEmpty().blockingGet());
        assertEquals(expectedResponse, result.blockingGet());
        verify(mockTool, times(1)).runAsync(eq(toolArgs), eq(mockToolContext));
    }
    @Test
    @Tag("valid")
    void successfulReplayWithAgentToolNotExecutedLive() {
        Map<String, Object> sessionState = new HashMap<>();
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", "/test/dir");
        replayConfig.put("user_message_index", 0);
