    @Test
    @Tag("integration")
    void concurrentInvocationsWithDifferentIds_maintainSeparateStates() {
        Map<String, Object> sessionState1 = new HashMap<>();
        Map<String, Object> replayConfig1 = new HashMap<>();
        replayConfig1.put("dir", "/test/path1");
        replayConfig1.put("user_message_index", 0);
