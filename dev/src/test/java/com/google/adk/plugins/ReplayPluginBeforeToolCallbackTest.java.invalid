        when(toolContext1.state()).thenReturn(sessionState);
        when(toolContext1.invocationId()).thenReturn("test-invocation-id");
        when(toolContext1.agentName()).thenReturn("agent1");
        
        ToolContext toolContext2 = mock(ToolContext.class);
        when(toolContext2.state()).thenReturn(sessionState);
        when(toolContext2.invocationId()).thenReturn("test-invocation-id");
        when(toolContext2.agentName()).thenReturn("agent2");
        
        BaseTool tool1 = mock(BaseTool.class);
        when(tool1.name()).thenReturn("tool1");
        
        BaseTool tool2 = mock(BaseTool.class);
        when(tool2.name()).thenReturn("tool2");
        
        Maybe<Map<String, Object>> result1 = replayPlugin.beforeToolCallback(tool1, toolArgs1, toolContext1);
        Maybe<Map<String, Object>> result2 = replayPlugin.beforeToolCallback(tool2, toolArgs2, toolContext2);
        
        Map<String, Object> resultMap1 = result1.blockingGet();
        Map<String, Object> resultMap2 = result2.blockingGet();
        
        assertNotNull(resultMap1);
        assertEquals("agent1_response", resultMap1.get("agent"));
        
        assertNotNull(resultMap2);
        assertEquals("agent2_response", resultMap2.get("agent"));
    }
    
