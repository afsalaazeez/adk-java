        replayConfig2.put("dir", "/test/path2");
        replayConfig2.put("user_message_index", 0);
        sessionState2.put("_adk_replay_config", replayConfig2);
        
        Map<String, Object> response1 = new HashMap<>();
        response1.put("invocation", "1");
        
        Map<String, Object> response2 = new HashMap<>();
        response2.put("invocation", "2");
        
        Recordings recordings1 = mock(Recordings.class);
        List<Recording> recordingList1 = new ArrayList<>();
        Recording recording1 = mock(Recording.class);
        ToolRecording toolRecording1 = mock(ToolRecording.class);
        when(recording1.agentName()).thenReturn("agent1");
        when(recording1.userMessageIndex()).thenReturn(0);
        when(recording1.toolRecording()).thenReturn(Optional.of(toolRecording1));
        when(recording1.llmRecording()).thenReturn(Optional.empty());
        when(toolRecording1.toolCall()).thenReturn(Optional.empty());
        when(toolRecording1.toolResponse()).thenReturn(Optional.of(response1));
        recordingList1.add(recording1);
        when(recordings1.recordings()).thenReturn(recordingList1);
        
        Recordings recordings2 = mock(Recordings.class);
        List<Recording> recordingList2 = new ArrayList<>();
        Recording recording2 = mock(Recording.class);
        ToolRecording toolRecording2 = mock(ToolRecording.class);
        when(recording2.agentName()).thenReturn("agent2");
        when(recording2.userMessageIndex()).thenReturn(0);
        when(recording2.toolRecording()).thenReturn(Optional.of(toolRecording2));
        when(recording2.llmRecording()).thenReturn(Optional.empty());
        when(toolRecording2.toolCall()).thenReturn(Optional.empty());
        when(toolRecording2.toolResponse()).thenReturn(Optional.of(response2));
        recordingList2.add(recording2);
        when(recordings2.recordings()).thenReturn(recordingList2);
        
        InvocationReplayState state1 = new InvocationReplayState("/test/path1", 0, recordings1);
        InvocationReplayState state2 = new InvocationReplayState("/test/path2", 0, recordings2);
        
        replayPlugin.invocationStates.put("invocation-1", state1);
        replayPlugin.invocationStates.put("invocation-2", state2);
        
        ToolContext toolContext1 = mock(ToolContext.class);
        when(toolContext1.state()).thenReturn(sessionState1);
        when(toolContext1.invocationId()).thenReturn("invocation-1");
        when(toolContext1.agentName()).thenReturn("agent1");
        
        ToolContext toolContext2 = mock(ToolContext.class);
        when(toolContext2.state()).thenReturn(sessionState2);
        when(toolContext2.invocationId()).thenReturn("invocation-2");
        when(toolContext2.agentName()).thenReturn("agent2");
        
        BaseTool tool1 = mock(BaseTool.class);
        when(tool1.name()).thenReturn("tool1");
        
        BaseTool tool2 = mock(BaseTool.class);
        when(tool2.name()).thenReturn("tool2");
        
        Maybe<Map<String, Object>> result1 = replayPlugin.beforeToolCallback(tool1, new HashMap<>(), toolContext1);
        Maybe<Map<String, Object>> result2 = replayPlugin.beforeToolCallback(tool2, new HashMap<>(), toolContext2);
        
        Map<String, Object> resultMap1 = result1.blockingGet();
        Map<String, Object> resultMap2 = result2.blockingGet();
        
        assertNotNull(resultMap1);
        assertEquals("1", resultMap1.get("invocation"));
        
        assertNotNull(resultMap2);
        assertEquals("2", resultMap2.get("invocation"));
    }
    
