    @Test
    @Tag("valid")
    void afterRunCallbackMultipleSequentialCallsShouldWorkCorrectly() {
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", "/test/recordings");
        replayConfig.put("user_message_index", 0);
        sessionState.put(REPLAY_CONFIG_KEY, replayConfig);
        
        String invocationId1 = "sequential-1";
        String invocationId2 = "sequential-2";
        
        InvocationContext context1 = mock(InvocationContext.class);
        InvocationContext context2 = mock(InvocationContext.class);
        
        when(context1.invocationId()).thenReturn(invocationId1);
        when(context1.session()).thenReturn(new MockSession(sessionState));
        when(context2.invocationId()).thenReturn(invocationId2);
        when(context2.session()).thenReturn(new MockSession(sessionState));
        
        InvocationReplayState state1 = new InvocationReplayState("/test/path1", 0, recordings);
        InvocationReplayState state2 = new InvocationReplayState("/test/path2", 1, recordings);
        
        replayPlugin.invocationStates.put(invocationId1, state1);
        replayPlugin.invocationStates.put(invocationId2, state2);
        
        replayPlugin.afterRunCallback(context1).blockingAwait();
        assertFalse(replayPlugin.invocationStates.containsKey(invocationId1));
        assertTrue(replayPlugin.invocationStates.containsKey(invocationId2));
        
        replayPlugin.afterRunCallback(context2).blockingAwait();
        assertFalse(replayPlugin.invocationStates.containsKey(invocationId2));
        assertTrue(replayPlugin.invocationStates.isEmpty());
    }
    
    // Mock Session class to replace the missing Session import
    private static class MockSession {
        private final Map<String, Object> state;
        
        public MockSession(Map<String, Object> state) {
            this.state = state;
        }
        
        public Map<String, Object> state() {
            return state;
        }
    }
}