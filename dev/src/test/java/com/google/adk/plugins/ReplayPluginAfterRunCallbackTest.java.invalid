/**
 * Test class ReplayPluginAfterRunCallbackTest ReplayPlugin.afterRunCallback covering multiple scenarios.
 */
class ReplayPluginAfterRunCallbackTest {
    private ReplayPlugin replayPlugin;
    @BeforeEach
    public void setup() {
        replayPlugin = new ReplayPlugin("adk_replay");
    }
    @Test
    @Tag("valid")
    public void testAfterRunReturnsCompleteWhenNotInReplayMode() {
        // Arrange
        InvocationContext ctx = mock(InvocationContext.class);
        // session().state() returns empty
        when(ctx.session()).thenReturn(new CallbackContext() {
            @Override
            public Map<String, Object> state() {
                return new HashMap<>();
            }
        });
        // isReplayModeOn returns false, so afterRunCallback should just return Completable.complete()
        Completable completable = replayPlugin.afterRunCallback(ctx);
        // Act & Assert
        completable.blockingAwait(); // Await for completion (emits nothing)
        assertTrue(((ConcurrentHashMap<?,?>)getInvocationStates(replayPlugin)).isEmpty());
    }
    @Test
    @Tag("valid")
    public void testInvocationStateIsRemovedWhenReplayModeOn() {
        // Arrange
        String invocationId = "test-invocation-id";
        Map<String, Object> config = new HashMap<>();
        config.put("_adk_replay_config", Map.of("dir", "dummyDir", "user_message_index", 1));
        InvocationContext ctx = mock(InvocationContext.class);
        when(ctx.session()).thenReturn(new CallbackContext() {
            @Override
            public Map<String, Object> state() {
                return config;
            }
        });
        when(ctx.invocationId()).thenReturn(invocationId);
        Recordings recordings = mock(Recordings.class);
        InvocationReplayState state = new InvocationReplayState("dummyDir", 1, recordings);
        @SuppressWarnings("unchecked")
        ConcurrentHashMap<String, InvocationReplayState> statesMap =
                (ConcurrentHashMap<String, InvocationReplayState>) getInvocationStates(replayPlugin);
        statesMap.put(invocationId, state);
        // Act
        Completable completable = replayPlugin.afterRunCallback(ctx);
        completable.blockingAwait(); // Await for completion
        // Assert
        assertFalse(statesMap.containsKey(invocationId));
    }
    @Test
    @Tag("boundary")
    public void testMissingInvocationStateIsNotError() {
        // Arrange
        String invocationId = "not-present-id";
        Map<String, Object> config = new HashMap<>();
        config.put("_adk_replay_config", Map.of("dir", "dummyDir", "user_message_index", 2));
        InvocationContext ctx = mock(InvocationContext.class);
        when(ctx.session()).thenReturn(new CallbackContext() {
            @Override
            public Map<String, Object> state() {
                return config;
            }
        });
        when(ctx.invocationId()).thenReturn(invocationId);
        // Remove entry if there is by chance (should be empty anyway)
        @SuppressWarnings("unchecked")
        ConcurrentHashMap<String, InvocationReplayState> statesMap =
                (ConcurrentHashMap<String, InvocationReplayState>) getInvocationStates(replayPlugin);
        statesMap.remove(invocationId);
        // Act & Assert: Should complete without throwing even if the entry does not exist
        assertDoesNotThrow(() -> {
            Completable completable = replayPlugin.afterRunCallback(ctx);
            completable.blockingAwait();
        });
        assertFalse(statesMap.containsKey(invocationId));
    }
    @Test
    @Tag("boundary")
    public void testInvocationIdIsNullAndReplayModeOn() {
        // Arrange
        Map<String, Object> config = new HashMap<>();
        config.put("_adk_replay_config", Map.of("dir", "dirValue", "user_message_index", 3));
        InvocationContext ctx = mock(InvocationContext.class);
        when(ctx.session()).thenReturn(new CallbackContext() {
            @Override
            public Map<String, Object> state() {
                return config;
            }
        });
        when(ctx.invocationId()).thenReturn(null);
        @SuppressWarnings("unchecked")
        ConcurrentHashMap<String, InvocationReplayState> statesMap =
                (ConcurrentHashMap<String, InvocationReplayState>) getInvocationStates(replayPlugin);
        // Optionally prepopulate with a null key for edge case
        statesMap.put(null, new InvocationReplayState("dirValue", 3, mock(Recordings.class)));
        // Act & Assert
        assertDoesNotThrow(() -> {
            Completable completable = replayPlugin.afterRunCallback(ctx);
            completable.blockingAwait();
        });
        assertFalse(statesMap.containsKey(null));
    }
    @Test
    @Tag("integration")
    public void testLoggerDebugIsCalledOnCleanup() {
        // Arrange
        String invocationId = "log-cleanup-id";
        Map<String, Object> config = new HashMap<>();
        config.put("_adk_replay_config", Map.of("dir", "dirVal", "user_message_index", 4));
        InvocationContext ctx = mock(InvocationContext.class);
        when(ctx.session()).thenReturn(new CallbackContext() {
            @Override
            public Map<String, Object> state() {
                return config;
            }
        });
        when(ctx.invocationId()).thenReturn(invocationId);
        Recordings recordings = mock(Recordings.class);
        InvocationReplayState state = new InvocationReplayState("dirVal", 4, recordings);
        @SuppressWarnings("unchecked")
        ConcurrentHashMap<String, InvocationReplayState> statesMap =
                (ConcurrentHashMap<String, InvocationReplayState>) getInvocationStates(replayPlugin);
        statesMap.put(invocationId, state);
        // Spy on logger using Mockito's static mocking
        try (MockedStatic<LoggerFactory> mockedLoggerFactory = Mockito.mockStatic(LoggerFactory.class)) {
            Logger mockLogger = mock(Logger.class);
            mockedLoggerFactory.when(() -> LoggerFactory.getLogger(ReplayPlugin.class)).thenReturn(mockLogger);
            // Create new ReplayPlugin to capture logger in constructor
            ReplayPlugin pluginWithMockLogger = new ReplayPlugin("adk_replay");
            ((ConcurrentHashMap<String, InvocationReplayState>) getInvocationStates(pluginWithMockLogger)).put(invocationId, state);
            // Act
            Completable completable = pluginWithMockLogger.afterRunCallback(ctx);
            completable.blockingAwait();
            // Assert logger.debug called at least once referencing invocationId
            verify(mockLogger, atLeastOnce()).debug(contains("Cleaned up replay state for invocation"), eq(invocationId));
        }
    }
    // Helper: Reflection access for invocationStates (only permitted in tests)
    private Object getInvocationStates(ReplayPlugin plugin) {
        try {
            java.lang.reflect.Field field = ReplayPlugin.class.getDeclaredField("invocationStates");
            field.setAccessible(true);
            return field.get(plugin);
        } catch (Exception e) {
            throw new RuntimeException("Cannot access invocationStates field", e);
        }
    }
}