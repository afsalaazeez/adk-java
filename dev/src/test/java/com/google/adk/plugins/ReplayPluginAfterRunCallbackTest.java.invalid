    void afterRunCallbackWhenReplayModeOffShouldCompleteWithoutCleanup() {
        String invocationId = "test-invocation-off";
        when(invocationContext.invocationId()).thenReturn(invocationId);
        when(invocationContext.session()).thenReturn(new MockSession(sessionState));
        
        InvocationReplayState testState = new InvocationReplayState("/test/path", 0, recordings);
        replayPlugin.invocationStates.put(invocationId, testState);
        
        Completable result = replayPlugin.afterRunCallback(invocationContext);
        TestObserver<Void> testObserver = result.test();
        
        testObserver.assertComplete();
        testObserver.assertNoErrors();
        assertTrue(replayPlugin.invocationStates.containsKey(invocationId));
        assertEquals(testState, replayPlugin.invocationStates.get(invocationId));
    }
    
