    @Test
    @Tag("valid")
    void multipleInvocationsMaintainSeparateStates() throws IOException {
        // Arrange
        String invocationId1 = "test-invocation-201";
        String invocationId2 = "test-invocation-202";
        
        String recordingsContent = "recordings:\n" +
                "  - user_message_index: 0\n" +
                "    agent_name: test-agent\n" +
                "    llm_recording:\n" +
                "      llm_request: {}\n" +
                "      llm_response: {}";
        
        Path recordingsFile = tempDir.resolve("generated-recordings.yaml");
        Files.writeString(recordingsFile, recordingsContent);
        
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", tempDir.toString());
        replayConfig.put("user_message_index", 0);
        sessionState.put("_adk_replay_config", replayConfig);
        
        InvocationContext context1 = mock(InvocationContext.class);
        InvocationContext context2 = mock(InvocationContext.class);
        
        when(context1.session()).thenReturn(new MockSession(sessionState));
        when(context2.session()).thenReturn(new MockSession(sessionState));
        when(context1.invocationId()).thenReturn(invocationId1);
        when(context2.invocationId()).thenReturn(invocationId2);
        // Act
        Maybe<Content> result1 = replayPlugin.beforeRunCallback(context1);
        Maybe<Content> result2 = replayPlugin.beforeRunCallback(context2);
        // Assert
        assertNotNull(result1);
        assertNotNull(result2);
        assertTrue(result1.isEmpty().blockingGet());
        assertTrue(result2.isEmpty().blockingGet());
        
        assertEquals(2, replayPlugin.invocationStates.size());
        assertTrue(replayPlugin.invocationStates.containsKey(invocationId1));
        assertTrue(replayPlugin.invocationStates.containsKey(invocationId2));
        
        InvocationReplayState state1 = replayPlugin.invocationStates.get(invocationId1);
        InvocationReplayState state2 = replayPlugin.invocationStates.get(invocationId2);
        assertNotNull(state1);
        assertNotNull(state2);
        assertNotSame(state1, state2);
    }
