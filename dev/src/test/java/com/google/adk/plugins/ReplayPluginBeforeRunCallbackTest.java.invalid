    @Test
    @Tag("integration")
    public void testHandlesConcurrentInvocationsWithDistinctStates() throws IOException {
        ReplayPlugin toTest = new ReplayPlugin("adk_replay");
        String dir = "case-dir";
        Path recordingsFile = Paths.get(dir, "generated-recordings.yaml");
        try (var filesMocked = Mockito.mockStatic(Files.class);
             var loaderMocked = Mockito.mockStatic(RecordingsLoader.class)) {
            filesMocked.when(() -> Files.exists(recordingsFile)).thenReturn(true);
            Recordings fakeRecordings = Mockito.mock(Recordings.class);
            loaderMocked.when(() -> RecordingsLoader.load(recordingsFile)).thenReturn(fakeRecordings);
            InvocationContext ctx1 = Mockito.mock(InvocationContext.class);
            String id1 = "invocation1";
            Map<String, Object> config1 = Map.of("dir", dir, "user_message_index", 10);
            Map<String, Object> state1 = new HashMap<>();
            state1.put("_adk_replay_config", config1);
            Mockito.when(ctx1.session()).thenReturn(new DummySession(state1));
            Mockito.when(ctx1.invocationId()).thenReturn(id1);
            InvocationContext ctx2 = Mockito.mock(InvocationContext.class);
            String id2 = "invocation2";
            Map<String, Object> config2 = Map.of("dir", dir, "user_message_index", 20);
            Map<String, Object> state2 = new HashMap<>();
            state2.put("_adk_replay_config", config2);
            Mockito.when(ctx2.session()).thenReturn(new DummySession(state2));
            Mockito.when(ctx2.invocationId()).thenReturn(id2);
            toTest.beforeRunCallback(ctx1);
            toTest.beforeRunCallback(ctx2);
            Map<String, Object> invocationStates;
            try {
                var field = ReplayPlugin.class.getDeclaredField("invocationStates");
                field.setAccessible(true);
                invocationStates = (Map<String, Object>) field.get(toTest);
            } catch (Exception e) {
                invocationStates = Collections.emptyMap();
            }
            assertTrue(invocationStates.containsKey(id1));
            assertTrue(invocationStates.containsKey(id2));
            assertNotNull(invocationStates.get(id1));
            assertNotNull(invocationStates.get(id2));
            assertNotSame(invocationStates.get(id1), invocationStates.get(id2));
        }
    }
    // --- Dummy classes for test setup ---
    static class DummySession {
        private final Map<String, Object> sessionState;
