import java.util.Map;

public class ReplayPluginBeforeRunCallbackTest extends BasePlugin {
    public ReplayPluginBeforeRunCallbackTest() {
        super("adk_replay");
    }
    @Test
    @Tag("valid")
    public void testReturnsEmptyMaybeWhenReplayModeIsOff() {
        InvocationContext mockInvocationContext = Mockito.mock(InvocationContext.class);
        Object mockSession = Mockito.mock(Object.class); // Use Object as a dummy type for session
        // The only thing expected from session is: ".state()" returning a Map<String,Object>
        Mockito.when(mockInvocationContext.session()).thenReturn(mockSession);
        Mockito.when(((Map<String, Object>)Mockito.mock(Map.class)).state()).thenReturn(Collections.emptyMap());
        Mockito.when(mockSession.getClass().getMethod("state")).thenReturn(Collections.emptyMap()); // Defensive: session.state() returns empty map
        // Use lambda for session.state() if session is not an ADK object
        ReplayPlugin plugin = new ReplayPlugin();
        Maybe<Content> result = plugin.beforeRunCallback(mockInvocationContext);
        // Fix: .isEmpty() returns boolean, so we need to call result.isEmpty().blockingGet() or test .test().assertComplete().assertNoValues()
        assertTrue(result.isEmpty().blockingGet(), "Expected Maybe.empty() when replay mode is off");
    }
    // TODO: Add more scenarios for beforeRunCallback if more logic gets added in future.
}