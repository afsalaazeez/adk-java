            mockedLoader.when(() -> RecordingsLoader.load(recordingsFile)).thenReturn(mockRecordings);
            Maybe<Content> result1 = replayPlugin.beforeRunCallback(mockInvocationContext);
            Maybe<Content> result2 = replayPlugin.beforeRunCallback(mockInvocationContext);
            assertTrue(result1.isEmpty().blockingGet());
            assertTrue(result2.isEmpty().blockingGet());
            mockedLoader.verify(() -> RecordingsLoader.load(recordingsFile), times(2));
        }
    }
    
