    @Test
    @Tag("integration")
    void beforeRunCallbackHandlesConcurrentCallsWithSameInvocationId() throws IOException, InterruptedException {
        String testDir = tempDir.toString();
        Path recordingsFile = tempDir.resolve(RECORDINGS_FILENAME);
        Files.createFile(recordingsFile);
        Files.writeString(recordingsFile, "recordings: []");
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", testDir);
        replayConfig.put("user_message_index", 1);
        sessionState.put(REPLAY_CONFIG_KEY, replayConfig);
        Recordings mockRecordings = mock(Recordings.class);
        when(mockRecordings.recordings()).thenReturn(new ArrayList<>());
        int threadCount = 5;
        ExecutorService executorService = Executors.newFixedThreadPool(threadCount);
        CountDownLatch latch = new CountDownLatch(threadCount);
        try (MockedStatic<RecordingsLoader> mockedLoader = mockStatic(RecordingsLoader.class)) {
            mockedLoader.when(() -> RecordingsLoader.load(recordingsFile)).thenReturn(mockRecordings);
            for (int i = 0; i < threadCount; i++) {
                executorService.submit(() -> {
                    try {
                        Maybe<Content> result = replayPlugin.beforeRunCallback(mockInvocationContext);
                        assertTrue(result.isEmpty().blockingGet());
                    } finally {
                        latch.countDown();
                    }
                });
            }
            assertTrue(latch.await(10, TimeUnit.SECONDS));
            executorService.shutdown();
        }
    }
    
