    @Test
    @Tag("invalid")
    void beforeRunCallbackThrowsReplayConfigErrorWhenRecordingsFileHasInvalidYaml() throws IOException {
        String testDir = tempDir.toString();
        Path recordingsFile = tempDir.resolve(RECORDINGS_FILENAME);
        Files.createFile(recordingsFile);
        Files.writeString(recordingsFile, "invalid: yaml: content:");
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", testDir);
        replayConfig.put("user_message_index", 1);
        sessionState.put(REPLAY_CONFIG_KEY, replayConfig);
        IOException ioException = new IOException("YAML parsing error");
        try (MockedStatic<RecordingsLoader> mockedLoader = mockStatic(RecordingsLoader.class)) {
            mockedLoader.when(() -> RecordingsLoader.load(recordingsFile)).thenThrow(ioException);
            ReplayConfigError exception = assertThrows(ReplayConfigError.class, () -> {
                replayPlugin.beforeRunCallback(mockInvocationContext);
            });
            assertTrue(exception.getMessage().contains("Failed to load recordings from"));
            assertEquals(ioException, exception.getCause());
        }
    }
    
