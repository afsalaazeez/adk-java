class ReplayPluginBeforeRunCallbackTest {
    private ReplayPlugin replayPlugin;
    private InvocationContext mockInvocationContext;
    private Map<String, Object> sessionState;
    @TempDir
    Path tempDir;
    private static final String REPLAY_CONFIG_KEY = "_adk_replay_config";
    private static final String RECORDINGS_FILENAME = "generated-recordings.yaml";
    
    @BeforeEach
    void setUp() {
        replayPlugin = new ReplayPlugin();
        mockInvocationContext = mock(InvocationContext.class);
        sessionState = new HashMap<>();
        
        // Mock the session() method to return a mock that provides state()
        InvocationContext.Session mockSession = mock(InvocationContext.Session.class);
        when(mockInvocationContext.session()).thenReturn(mockSession);
        when(mockSession.state()).thenReturn(sessionState);
        when(mockInvocationContext.invocationId()).thenReturn("test-invocation-id");
    }
    
    @Test
    @Tag("valid")
    void beforeRunCallbackReturnsEmptyWhenReplayModeIsOff() {
        Maybe<Content> result = replayPlugin.beforeRunCallback(mockInvocationContext);
        assertTrue(result.isEmpty().blockingGet());
        assertNull(result.blockingGet());
    }
    
    @Test
    @Tag("valid")
    void beforeRunCallbackLoadsInvocationStateWhenReplayModeIsOn() throws IOException {
        String testDir = tempDir.toString();
        Path recordingsFile = tempDir.resolve(RECORDINGS_FILENAME);
        Files.createFile(recordingsFile);
        Files.writeString(recordingsFile, "recordings: []");
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", testDir);
        replayConfig.put("user_message_index", 1);
        sessionState.put(REPLAY_CONFIG_KEY, replayConfig);
        Recordings mockRecordings = mock(Recordings.class);
        when(mockRecordings.recordings()).thenReturn(new ArrayList<>());
        try (MockedStatic<RecordingsLoader> mockedLoader = mockStatic(RecordingsLoader.class)) {
            mockedLoader.when(() -> RecordingsLoader.load(recordingsFile)).thenReturn(mockRecordings);
            Maybe<Content> result = replayPlugin.beforeRunCallback(mockInvocationContext);
            assertTrue(result.isEmpty().blockingGet());
            mockedLoader.verify(() -> RecordingsLoader.load(recordingsFile), times(1));
        }
    }
    
