class ReplayPluginBeforeRunCallbackTest {
    private ReplayPlugin replayPlugin;
    private InvocationContext invocationContext;
    private Map<String, Object> sessionState;
    
    @TempDir
    Path tempDir;
    @BeforeEach
    void setUp() {
        replayPlugin = new ReplayPlugin();
        invocationContext = mock(InvocationContext.class);
        sessionState = new HashMap<>();
        
        when(invocationContext.session()).thenReturn(new MockSession(sessionState));
    }
    @AfterEach
    void tearDown() {
        replayPlugin = null;
        invocationContext = null;
        sessionState = null;
    }
    @Test
    @Tag("valid")
    void replayModeOnLoadsInvocationState() throws IOException {
        // Arrange
        String invocationId = "test-invocation-123";
        String recordingsContent = "recordings:\n" +
                "  - user_message_index: 0\n" +
                "    agent_name: test-agent\n" +
                "    llm_recording:\n" +
                "      llm_request: {}\n" +
                "      llm_response: {}";
        
        Path recordingsFile = tempDir.resolve("generated-recordings.yaml");
        Files.writeString(recordingsFile, recordingsContent);
        
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", tempDir.toString());
        replayConfig.put("user_message_index", 0);
        sessionState.put("_adk_replay_config", replayConfig);
        
        when(invocationContext.invocationId()).thenReturn(invocationId);
        // Act
        Maybe<Content> result = replayPlugin.beforeRunCallback(invocationContext);
        // Assert
        assertNotNull(result);
        assertTrue(result.isEmpty().blockingGet());
        assertNotNull(replayPlugin.invocationStates);
        assertTrue(replayPlugin.invocationStates.containsKey(invocationId));
        
        InvocationReplayState state = replayPlugin.invocationStates.get(invocationId);
        assertNotNull(state);
        assertEquals(tempDir.toString(), state.getTestCasePath());
        assertEquals(0, state.getUserMessageIndex());
        assertNotNull(state.getRecordings());
    }
    @Test
    @Tag("valid")
    void replayModeOffDoesNotLoadState() {
        // Arrange
        String invocationId = "test-invocation-456";
        when(invocationContext.invocationId()).thenReturn(invocationId);
        // Act
        Maybe<Content> result = replayPlugin.beforeRunCallback(invocationContext);
        // Assert
        assertNotNull(result);
        assertTrue(result.isEmpty().blockingGet());
        assertTrue(replayPlugin.invocationStates.isEmpty());
    }
    @Test
    @Tag("invalid")
    void missingReplayConfigThrowsException() {
        // Arrange
        String invocationId = "test-invocation-789";
        sessionState.put("_adk_replay_config", null);
        when(invocationContext.invocationId()).thenReturn(invocationId);
        // Act & Assert
        ReplayConfigError exception = assertThrows(ReplayConfigError.class, () -> {
            replayPlugin.beforeRunCallback(invocationContext);
        });
        
        assertEquals("Replay parameters are missing from session state", exception.getMessage());
    }
    @Test
    @Tag("invalid")
    void missingDirectoryParameterThrowsException() {
        // Arrange
        String invocationId = "test-invocation-101";
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("user_message_index", 0);
        sessionState.put("_adk_replay_config", replayConfig);
        when(invocationContext.invocationId()).thenReturn(invocationId);
        // Act & Assert
        ReplayConfigError exception = assertThrows(ReplayConfigError.class, () -> {
            replayPlugin.beforeRunCallback(invocationContext);
        });
        
        assertEquals("Replay parameters are missing from session state", exception.getMessage());
    }
    @Test
    @Tag("invalid")
    void missingUserMessageIndexThrowsException() {
        // Arrange
        String invocationId = "test-invocation-102";
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", tempDir.toString());
        sessionState.put("_adk_replay_config", replayConfig);
        when(invocationContext.invocationId()).thenReturn(invocationId);
        // Act & Assert
        ReplayConfigError exception = assertThrows(ReplayConfigError.class, () -> {
            replayPlugin.beforeRunCallback(invocationContext);
        });
        
        assertEquals("Replay parameters are missing from session state", exception.getMessage());
    }
    @Test
    @Tag("invalid")
    void nonExistentRecordingsFileThrowsException() {
        // Arrange
        String invocationId = "test-invocation-103";
        Path nonExistentDir = tempDir.resolve("non-existent");
        
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", nonExistentDir.toString());
        replayConfig.put("user_message_index", 0);
        sessionState.put("_adk_replay_config", replayConfig);
        when(invocationContext.invocationId()).thenReturn(invocationId);
        // Act & Assert
        ReplayConfigError exception = assertThrows(ReplayConfigError.class, () -> {
            replayPlugin.beforeRunCallback(invocationContext);
        });
        
        assertTrue(exception.getMessage().contains("Recordings file not found"));
        assertTrue(exception.getMessage().contains("generated-recordings.yaml"));
    }
