    @Test
    @Tag("integration")
    public void testAddsInvocationStateToMapWhenReplayModeEnabled() throws IOException {
        ReplayPlugin toTest = new ReplayPlugin("adk_replay");
        InvocationContext ctx = Mockito.mock(InvocationContext.class);
        String invocationId = "invocation7";
        String dir = "test-dir";
        Integer msgIndex = 3;
        Map<String, Object> config = Map.of("dir", dir, "user_message_index", msgIndex);
        Map<String, Object> sessionState = new HashMap<>();
        sessionState.put("_adk_replay_config", config);
        Mockito.when(ctx.session()).thenReturn(new DummySession(sessionState));
        Mockito.when(ctx.invocationId()).thenReturn(invocationId);
        Path recordingsFile = Paths.get(dir, "generated-recordings.yaml");
        try (var filesMocked = Mockito.mockStatic(Files.class);
             var loaderMocked = Mockito.mockStatic(RecordingsLoader.class)) {
            filesMocked.when(() -> Files.exists(recordingsFile)).thenReturn(true);
            Recordings fakeRecordings = Mockito.mock(Recordings.class);
            loaderMocked.when(() -> RecordingsLoader.load(recordingsFile)).thenReturn(fakeRecordings);
            toTest.beforeRunCallback(ctx);
            Map<String, Object> invocationStates;
            try {
                var field = ReplayPlugin.class.getDeclaredField("invocationStates");
                field.setAccessible(true);
                invocationStates = (Map<String, Object>) field.get(toTest);
            } catch (Exception e) {
                invocationStates = Collections.emptyMap();
            }
            assertTrue(invocationStates.containsKey(invocationId));
            assertNotNull(invocationStates.get(invocationId));
            assertEquals(invocationId, ((InvocationContext)ctx).invocationId());
        }
    }
