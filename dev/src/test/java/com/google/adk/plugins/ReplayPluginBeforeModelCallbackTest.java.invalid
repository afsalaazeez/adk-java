        return mock(LlmResponse.class);
    }
    private Recording buildDummyRecording(String agentName, int userMessageIndex, Optional<LlmRecording> llmRecording, Optional<ToolRecording> toolRecording) {
        Recording rec = mock(Recording.class);
        when(rec.agentName()).thenReturn(agentName);
        when(rec.userMessageIndex()).thenReturn(userMessageIndex);
        when(rec.llmRecording()).thenReturn(llmRecording);
        when(rec.toolRecording()).thenReturn(toolRecording);
        return rec;
