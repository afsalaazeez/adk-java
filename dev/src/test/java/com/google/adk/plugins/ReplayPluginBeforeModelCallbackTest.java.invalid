    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        replayPlugin = new ReplayPlugin();
        sessionState = new HashMap<>();
        invocationStates = new ConcurrentHashMap<>();
        
        java.lang.reflect.Field field;
        try {
            field = ReplayPlugin.class.getDeclaredField("invocationStates");
            field.setAccessible(true);
