    @Test
    @Tag("boundary")
    public void testIsolatesReplayStatePerInvocationId() {
        String inv1 = "inv-1";
        String inv2 = "inv-2";
        String agent1 = "AgentA";
        String agent2 = "AgentB";
        Map<String, Object> config1 = Map.of("_adk_replay_config", Map.of("dir", CASE_DIR, "user_message_index", MESSAGE_INDEX));
        Map<String, Object> config2 = Map.of("_adk_replay_config", Map.of("dir", CASE_DIR, "user_message_index", MESSAGE_INDEX));
        LlmRequest req1 = buildDummyLlmRequest();
        LlmRequest req2 = buildDummyLlmRequest();
        LlmResponse resp1 = buildDummyLlmResponse();
        LlmResponse resp2 = buildDummyLlmResponse();
        LlmRecording rec1 = mock(LlmRecording.class);
        when(rec1.llmRequest()).thenReturn(Optional.of(req1));
        when(rec1.llmResponse()).thenReturn(Optional.of(resp1));
        Recording r1 = buildDummyRecording(agent1, MESSAGE_INDEX, Optional.of(rec1), Optional.empty());
        Recordings recordings1 = buildDummyRecordings(List.of(r1));
        InvocationReplayState state1 = buildReplayState(CASE_DIR, MESSAGE_INDEX, recordings1, Map.of(agent1, 0));
        LlmRecording rec2 = mock(LlmRecording.class);
        when(rec2.llmRequest()).thenReturn(Optional.of(req2));
        when(rec2.llmResponse()).thenReturn(Optional.of(resp2));
        Recording r2 = buildDummyRecording(agent2, MESSAGE_INDEX, Optional.of(rec2), Optional.empty());
        Recordings recordings2 = buildDummyRecordings(List.of(r2));
        InvocationReplayState state2 = buildReplayState(CASE_DIR, MESSAGE_INDEX, recordings2, Map.of(agent2, 0));
        replayPlugin.getClass().getDeclaredField("invocationStates").setAccessible(true);
        Map<String, InvocationReplayState> statesMap = (Map<String, InvocationReplayState>) replayPlugin.getClass()
                .getDeclaredField("invocationStates").get(replayPlugin);
        statesMap.put(inv1, state1);
        statesMap.put(inv2, state2);
        CallbackContext contextForInv1 = buildMockCallbackContext(inv1, agent1, config1);
        CallbackContext contextForInv2 = buildMockCallbackContext(inv2, agent2, config2);
        assertSame(resp1, replayPlugin.beforeModelCallback(contextForInv1, req1).blockingGet());
        assertSame(resp2, replayPlugin.beforeModelCallback(contextForInv2, req2).blockingGet());
    }
    @Test
    @Tag("boundary")
    public void testThrowsErrorWhenNoAvailableRecordings() {
        Map<String, Object> config = Map.of("_adk_replay_config", Map.of("dir", CASE_DIR, "user_message_index", MESSAGE_INDEX));
        CallbackContext context = buildMockCallbackContext(INVOCATION_ID, AGENT_NAME, config);
        List<Recording> recordingsList = Collections.emptyList();
        Recordings recordings = buildDummyRecordings(recordingsList);
        Map<String, Integer> indices = Map.of(AGENT_NAME, 0);
        InvocationReplayState state = buildReplayState(CASE_DIR, MESSAGE_INDEX, recordings, indices);
        replayPlugin.getClass().getDeclaredField("invocationStates").setAccessible(true);
        ((Map<String, InvocationReplayState>) replayPlugin.getClass().getDeclaredField("invocationStates")
                .get(replayPlugin)).put(INVOCATION_ID, state);
        Exception ex = assertThrows(ReplayVerificationError.class, () -> replayPlugin.beforeModelCallback(context, buildDummyLlmRequest()));
        assertTrue(ex.getMessage().contains(AGENT_NAME), "Error should reference agent in absence of recordings");
        assertTrue(ex.getMessage().contains(String.valueOf(MESSAGE_INDEX)));
    }
