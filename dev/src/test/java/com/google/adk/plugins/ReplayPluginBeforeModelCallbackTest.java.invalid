        replayConfig.put("user_message_index", 0);
        sessionState.put("_adk_replay_config", replayConfig);
        
        when(callbackContext.state()).thenReturn(sessionState);
        when(callbackContext.invocationId()).thenReturn("test-invocation-id");
        
        ReplayConfigError exception = assertThrows(ReplayConfigError.class, () -> {
            replayPlugin.beforeModelCallback(callbackContext, llmRequest);
        });
        
        assertEquals("Replay state not initialized. Ensure beforeRunCallback created it.", exception.getMessage());
    }
    
