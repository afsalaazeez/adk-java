        Recording rec = createLlmRecording(agentName, userMessageIndex, Optional.of(llmRec), Optional.empty());
        List<Recording> recList = Collections.singletonList(rec);
        InvocationReplayState state = createInvocationReplayState("/tmp/p14", userMessageIndex, recList);
        replayPlugin.invocationStates.put(invocationId, state);
        CallbackContext ctx = createCallbackContext(true, invocationId, agentName, null);
        LlmRequest req = createDummyRequest(71);
        Maybe<LlmResponse> result = replayPlugin.beforeModelCallback(ctx, req);
        LlmResponse actualResponse = (LlmResponse) result.blockingGet();
        assertNotNull(actualResponse);
        assertEquals(expectedResponse.getClass(), actualResponse.getClass());
        assertEquals(expectedResponse, actualResponse);
    }
}