    @Test
    @Tag("valid")
    void beforeModelCallback_multipleAgentsSequential_returnsCorrectResponses() {
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", "/test/path");
        replayConfig.put("user_message_index", 0);
        sessionState.put("_adk_replay_config", replayConfig);
        
        String invocationId = "test-invocation-id";
        
        LlmResponse responseA1 = mock(LlmResponse.class);
        LlmResponse responseB1 = mock(LlmResponse.class);
        LlmResponse responseA2 = mock(LlmResponse.class);
        
        LlmRecording recordingA1 = mock(LlmRecording.class);
        LlmRecording recordingB1 = mock(LlmRecording.class);
        LlmRecording recordingA2 = mock(LlmRecording.class);
        
        Recording recA1 = mock(Recording.class);
        Recording recB1 = mock(Recording.class);
        Recording recA2 = mock(Recording.class);
        
        when(recA1.agentName()).thenReturn("agent_a");
        when(recA1.userMessageIndex()).thenReturn(0);
        when(recA1.llmRecording()).thenReturn(Optional.of(recordingA1));
        when(recA1.toolRecording()).thenReturn(Optional.empty());
        
        when(recB1.agentName()).thenReturn("agent_b");
        when(recB1.userMessageIndex()).thenReturn(0);
        when(recB1.llmRecording()).thenReturn(Optional.of(recordingB1));
        when(recB1.toolRecording()).thenReturn(Optional.empty());
        
        when(recA2.agentName()).thenReturn("agent_a");
        when(recA2.userMessageIndex()).thenReturn(0);
        when(recA2.llmRecording()).thenReturn(Optional.of(recordingA2));
        when(recA2.toolRecording()).thenReturn(Optional.empty());
        
        when(recordingA1.llmRequest()).thenReturn(Optional.empty());
        when(recordingA1.llmResponse()).thenReturn(Optional.of(responseA1));
        
        when(recordingB1.llmRequest()).thenReturn(Optional.empty());
        when(recordingB1.llmResponse()).thenReturn(Optional.of(responseB1));
        
        when(recordingA2.llmRequest()).thenReturn(Optional.empty());
        when(recordingA2.llmResponse()).thenReturn(Optional.of(responseA2));
        
        List<Recording> recordingsList = new ArrayList<>();
        recordingsList.add(recA1);
        recordingsList.add(recB1);
        recordingsList.add(recA2);
        
        when(recordings.recordings()).thenReturn(recordingsList);
        
        InvocationReplayState state = new InvocationReplayState("/test/path", 0, recordings);
        invocationStates.put(invocationId, state);
        
        when(callbackContext.state()).thenReturn(sessionState);
        when(callbackContext.invocationId()).thenReturn(invocationId);
        
        when(callbackContext.agentName()).thenReturn("agent_a");
        LlmResponse result1 = replayPlugin.beforeModelCallback(callbackContext, llmRequest).blockingGet();
        assertEquals(responseA1, result1);
        
        when(callbackContext.agentName()).thenReturn("agent_b");
        LlmResponse result2 = replayPlugin.beforeModelCallback(callbackContext, llmRequest).blockingGet();
        assertEquals(responseB1, result2);
        
        when(callbackContext.agentName()).thenReturn("agent_a");
        LlmResponse result3 = replayPlugin.beforeModelCallback(callbackContext, llmRequest).blockingGet();
        assertEquals(responseA2, result3);
    }
    
    @Test
    @Tag("valid")
    void beforeModelCallback_sameAgentMultipleRequests_advancesIndexCorrectly() {
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", "/test/path");
        replayConfig.put("user_message_index", 0);
        sessionState.put("_adk_replay_config", replayConfig);
        
        String invocationId = "test-invocation-id";
        String agentName = "test-agent";
        
        LlmResponse response1 = mock(LlmResponse.class);
        LlmResponse response2 = mock(LlmResponse.class);
        
        LlmRecording recording1 = mock(LlmRecording.class);
        LlmRecording recording2 = mock(LlmRecording.class);
        
        Recording rec1 = mock(Recording.class);
        Recording rec2 = mock(Recording.class);
        
        when(rec1.agentName()).thenReturn(agentName);
        when(rec1.userMessageIndex()).thenReturn(0);
        when(rec1.llmRecording()).thenReturn(Optional.of(recording1));
        when(rec1.toolRecording()).thenReturn(Optional.empty());
        
        when(rec2.agentName()).thenReturn(agentName);
        when(rec2.userMessageIndex()).thenReturn(0);
        when(rec2.llmRecording()).thenReturn(Optional.of(recording2));
        when(rec2.toolRecording()).thenReturn(Optional.empty());
        
        when(recording1.llmRequest()).thenReturn(Optional.empty());
        when(recording1.llmResponse()).thenReturn(Optional.of(response1));
        
        when(recording2.llmRequest()).thenReturn(Optional.empty());
        when(recording2.llmResponse()).thenReturn(Optional.of(response2));
        
        List<Recording> recordingsList = new ArrayList<>();
        recordingsList.add(rec1);
        recordingsList.add(rec2);
        
        when(recordings.recordings()).thenReturn(recordingsList);
        
        InvocationReplayState state = new InvocationReplayState("/test/path", 0, recordings);
        invocationStates.put(invocationId, state);
        
        when(callbackContext.state()).thenReturn(sessionState);
        when(callbackContext.invocationId()).thenReturn(invocationId);
        when(callbackContext.agentName()).thenReturn(agentName);
        
        LlmResponse result1 = replayPlugin.beforeModelCallback(callbackContext, llmRequest).blockingGet();
        assertEquals(response1, result1);
        assertEquals(1, state.getAgentReplayIndex(agentName));
        
        LlmResponse result2 = replayPlugin.beforeModelCallback(callbackContext, llmRequest).blockingGet();
        assertEquals(response2, result2);
        assertEquals(2, state.getAgentReplayIndex(agentName));
    }
    
