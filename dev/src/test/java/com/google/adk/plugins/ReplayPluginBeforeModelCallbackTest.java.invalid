        when(callbackContext.agentName()).thenReturn(agentName);
        
        Maybe<LlmResponse> result = replayPlugin.beforeModelCallback(callbackContext, llmRequest);
        
        assertNotNull(result);
        LlmResponse actualResponse = result.blockingGet();
        assertNotNull(actualResponse);
        assertEquals(llmResponse, actualResponse);
    }
    
