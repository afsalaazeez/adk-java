    public void testReturnsCorrectResponseForMultipleAgents() {
        String agentA = "AgentA";
        String agentB = "AgentB";
        Map<String, Object> configA = Map.of("_adk_replay_config", Map.of("dir", CASE_DIR, "user_message_index", MESSAGE_INDEX));
        CallbackContext contextA = buildMockCallbackContext(INVOCATION_ID, agentA, configA);
        LlmRequest llmRequestA = buildDummyLlmRequest();
        LlmResponse responseA = buildDummyLlmResponse();
        LlmRecording llmRecordingA = mock(LlmRecording.class);
        when(llmRecordingA.llmRequest()).thenReturn(Optional.of(llmRequestA));
        when(llmRecordingA.llmResponse()).thenReturn(Optional.of(responseA));
        LlmRecording llmRecordingB = mock(LlmRecording.class);
        when(llmRecordingB.llmRequest()).thenReturn(Optional.empty());
        when(llmRecordingB.llmResponse()).thenReturn(Optional.of(buildDummyLlmResponse()));
        Recording recA = buildDummyRecording(agentA, MESSAGE_INDEX, Optional.of(llmRecordingA), Optional.empty());
        Recording recB = buildDummyRecording(agentB, MESSAGE_INDEX, Optional.of(llmRecordingB), Optional.empty());
        Recordings recordings = buildDummyRecordings(List.of(recA, recB));
        Map<String, Integer> indices = Map.of(agentA, 0, agentB, 0);
        InvocationReplayState state = buildReplayState(CASE_DIR, MESSAGE_INDEX, recordings, indices);
        replayPlugin.getClass().getDeclaredField("invocationStates").setAccessible(true);
        ((Map<String, InvocationReplayState>) replayPlugin.getClass().getDeclaredField("invocationStates")
                .get(replayPlugin)).put(INVOCATION_ID, state);
        Maybe<LlmResponse> resultA = replayPlugin.beforeModelCallback(contextA, llmRequestA);
        assertTrue(resultA.blockingOptional().isPresent(), "Response should be returned for intended agent");
        assertSame(responseA, resultA.blockingGet());
    }
    @Test
    @Tag("boundary")
    public void testReturnsLlmResponseAfterSkippingNonLlmRecordings() {
        ToolRecording toolRecording = mock(ToolRecording.class);
        LlmRecording llmRecording = mock(LlmRecording.class);
        LlmResponse response = buildDummyLlmResponse();
        when(llmRecording.llmRequest()).thenReturn(Optional.empty());
        when(llmRecording.llmResponse()).thenReturn(Optional.of(response));
        Recording toolRec = buildDummyRecording(AGENT_NAME, MESSAGE_INDEX, Optional.empty(), Optional.of(toolRecording));
        Recording llmRec = buildDummyRecording(AGENT_NAME, MESSAGE_INDEX, Optional.of(llmRecording), Optional.empty());
        List<Recording> recordingsList = Arrays.asList(toolRec, llmRec);
        Recordings recordings = buildDummyRecordings(recordingsList);
        Map<String, Integer> indices = Map.of(AGENT_NAME, 0);
        InvocationReplayState state = buildReplayState(CASE_DIR, MESSAGE_INDEX, recordings, indices);
        replayPlugin.getClass().getDeclaredField("invocationStates").setAccessible(true);
        ((Map<String, InvocationReplayState>) replayPlugin.getClass().getDeclaredField("invocationStates")
                .get(replayPlugin)).put(INVOCATION_ID, state);
        Map<String, Object> config = Map.of("_adk_replay_config", Map.of("dir", CASE_DIR, "user_message_index", MESSAGE_INDEX));
        CallbackContext context = buildMockCallbackContext(INVOCATION_ID, AGENT_NAME, config);
        LlmRequest llmRequest = buildDummyLlmRequest();
        Exception ex = assertThrows(ReplayVerificationError.class, () -> replayPlugin.beforeModelCallback(context, llmRequest));
        assertTrue(ex.getMessage().contains("Expected LLM recording"), "Should error for tool recording");
        state.incrementAgentReplayIndex(AGENT_NAME);
        Maybe<LlmResponse> result = replayPlugin.beforeModelCallback(context, llmRequest);
        assertTrue(result.blockingOptional().isPresent(), "Should return LLM response after skipping tool recordings");
        assertSame(response, result.blockingGet());
    }
    @Test
    @Tag("valid")
    public void testReplaysInCorrectSequenceForAgentIndex() {
        LlmRecording llmRecording1 = mock(LlmRecording.class);
        LlmRecording llmRecording2 = mock(LlmRecording.class);
        LlmResponse resp1 = buildDummyLlmResponse();
        LlmResponse resp2 = buildDummyLlmResponse();
        when(llmRecording1.llmRequest()).thenReturn(Optional.empty());
        when(llmRecording1.llmResponse()).thenReturn(Optional.of(resp1));
        when(llmRecording2.llmRequest()).thenReturn(Optional.empty());
        when(llmRecording2.llmResponse()).thenReturn(Optional.of(resp2));
        Recording rec1 = buildDummyRecording(AGENT_NAME, MESSAGE_INDEX, Optional.of(llmRecording1), Optional.empty());
        Recording rec2 = buildDummyRecording(AGENT_NAME, MESSAGE_INDEX, Optional.of(llmRecording2), Optional.empty());
        List<Recording> recordingsList = Arrays.asList(rec1, rec2);
        Recordings recordings = buildDummyRecordings(recordingsList);
        Map<String, Integer> indices = Map.of(AGENT_NAME, 0);
        InvocationReplayState state = buildReplayState(CASE_DIR, MESSAGE_INDEX, recordings, indices);
        replayPlugin.getClass().getDeclaredField("invocationStates").setAccessible(true);
        ((Map<String, InvocationReplayState>) replayPlugin.getClass().getDeclaredField("invocationStates")
                .get(replayPlugin)).put(INVOCATION_ID, state);
        Map<String, Object> config = Map.of("_adk_replay_config", Map.of("dir", CASE_DIR, "user_message_index", MESSAGE_INDEX));
        CallbackContext context = buildMockCallbackContext(INVOCATION_ID, AGENT_NAME, config);
        LlmRequest llmRequest = buildDummyLlmRequest();
        Maybe<LlmResponse> result1 = replayPlugin.beforeModelCallback(context, llmRequest);
        assertTrue(result1.blockingOptional().isPresent(), "First response should be present");
        assertSame(resp1, result1.blockingGet());
        state.incrementAgentReplayIndex(AGENT_NAME);
        Maybe<LlmResponse> result2 = replayPlugin.beforeModelCallback(context, llmRequest);
        assertTrue(result2.blockingOptional().isPresent(), "Second response should be present");
        assertSame(resp2, result2.blockingGet());
    }
    @Test
    @Tag("valid")
    public void testIgnoresIrrelevantFieldsInRequestComparison() {
        Map<String, Object> config = Map.of("_adk_replay_config", Map.of("dir", CASE_DIR, "user_message_index", MESSAGE_INDEX));
        CallbackContext context = buildMockCallbackContext(INVOCATION_ID, AGENT_NAME, config);
        LlmRequest recordedRequest = buildDummyLlmRequest();
        LlmRequest currentRequest = buildDummyLlmRequest();
        LlmResponse response = buildDummyLlmResponse();
        LlmRecording llmRecording = mock(LlmRecording.class);
        when(llmRecording.llmRequest()).thenReturn(Optional.of(recordedRequest));
        when(llmRecording.llmResponse()).thenReturn(Optional.of(response));
        Recording rec = buildDummyRecording(AGENT_NAME, MESSAGE_INDEX, Optional.of(llmRecording), Optional.empty());
        Recordings recordings = buildDummyRecordings(List.of(rec));
        Map<String, Integer> indices = Map.of(AGENT_NAME, 0);
        InvocationReplayState state = buildReplayState(CASE_DIR, MESSAGE_INDEX, recordings, indices);
        replayPlugin.getClass().getDeclaredField("invocationStates").setAccessible(true);
        ((Map<String, InvocationReplayState>) replayPlugin.getClass().getDeclaredField("invocationStates")
                .get(replayPlugin)).put(INVOCATION_ID, state);
        Maybe<LlmResponse> result = replayPlugin.beforeModelCallback(context, currentRequest);
        assertTrue(result.blockingOptional().isPresent());
        assertEquals(response, result.blockingGet());
    }
