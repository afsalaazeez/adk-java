        when(callbackContext.invocationContext()).thenReturn(invocationContext);
        doReturn(true).when(replayPlugin).isReplayModeOn(invocationContext);
        when(callbackContext.invocationId()).thenReturn(invocationId);
        when(callbackContext.agentName()).thenReturn(null);
        
        invocationStates.put(invocationId, invocationReplayState);
        
        // Act & Assert
        assertThrows(Exception.class, () -> {
            replayPlugin.beforeModelCallback(callbackContext, llmRequest);
        });
    }
    
    @Test
    @Tag("boundary")
    public void beforeModelCallbackHandlesEmptyAgentName() throws Exception {
        // Arrange
        String invocationId = "invocation-empty-agent";
        String agentName = "";
        
        when(callbackContext.invocationContext()).thenReturn(invocationContext);
        doReturn(true).when(replayPlugin).isReplayModeOn(invocationContext);
        when(callbackContext.invocationId()).thenReturn(invocationId);
        when(callbackContext.agentName()).thenReturn(agentName);
        
        invocationStates.put(invocationId, invocationReplayState);
        
        when(llmRecording.llmResponse()).thenReturn(Optional.empty());
        when(recording.llmRecording()).thenReturn(Optional.of(llmRecording));
        when(llmRecording.llmRequest()).thenReturn(Optional.empty());
        
        doReturn(recording).when(replayPlugin).getNextRecordingForAgent(invocationReplayState, agentName);
        
        // Act
        Maybe<LlmResponse> result = replayPlugin.beforeModelCallback(callbackContext, llmRequest);
        
        // Assert
        assertNotNull(result);
        verify(replayPlugin).getNextRecordingForAgent(invocationReplayState, agentName);
    }
    
    @Test
    @Tag("integration")
    public void beforeModelCallbackHandlesConcurrentInvocationsCorrectly() throws Exception {
        // Arrange
        String invocationId1 = "inv-1";
        String invocationId2 = "inv-2";
        String agentName = "ConcurrentAgent";
        
        CallbackContext context1 = mock(CallbackContext.class);
        CallbackContext context2 = mock(CallbackContext.class);
        
        InvocationReplayState state1 = mock(InvocationReplayState.class);
        InvocationReplayState state2 = mock(InvocationReplayState.class);
        
        when(context1.invocationContext()).thenReturn(invocationContext);
        when(context2.invocationContext()).thenReturn(invocationContext);
        doReturn(true).when(replayPlugin).isReplayModeOn(invocationContext);
        when(context1.invocationId()).thenReturn(invocationId1);
        when(context1.agentName()).thenReturn(agentName);
        when(context2.invocationId()).thenReturn(invocationId2);
        when(context2.agentName()).thenReturn(agentName);
        
        invocationStates.put(invocationId1, state1);
        invocationStates.put(invocationId2, state2);
        
        LlmResponse response1 = mock(LlmResponse.class);
        LlmResponse response2 = mock(LlmResponse.class);
        LlmRecording recording1 = mock(LlmRecording.class);
        LlmRecording recording2 = mock(LlmRecording.class);
        Recording rec1 = mock(Recording.class);
        Recording rec2 = mock(Recording.class);
        
        when(recording1.llmResponse()).thenReturn(Optional.of(response1));
        when(recording2.llmResponse()).thenReturn(Optional.of(response2));
        when(recording1.llmRequest()).thenReturn(Optional.empty());
        when(recording2.llmRequest()).thenReturn(Optional.empty());
        when(rec1.llmRecording()).thenReturn(Optional.of(recording1));
        when(rec2.llmRecording()).thenReturn(Optional.of(recording2));
        
        doReturn(rec1).when(replayPlugin).getNextRecordingForAgent(state1, agentName);
        doReturn(rec2).when(replayPlugin).getNextRecordingForAgent(state2, agentName);
        
        // Act
        Maybe<LlmResponse> result1 = replayPlugin.beforeModelCallback(context1, llmRequest);
        Maybe<LlmResponse> result2 = replayPlugin.beforeModelCallback(context2, llmRequest);
        
        // Assert
        assertEquals(response1, result1.blockingGet());
        assertEquals(response2, result2.blockingGet());
        verify(replayPlugin).getNextRecordingForAgent(state1, agentName);
        verify(replayPlugin).getNextRecordingForAgent(state2, agentName);
    }
    
    @Test
    @Tag("valid")
    public void beforeModelCallbackChecksReplayModeBeforeOtherOperations() {
        // Arrange
        when(callbackContext.invocationContext()).thenReturn(invocationContext);
        doReturn(false).when(replayPlugin).isReplayModeOn(invocationContext);
        
        // Act
        Maybe<LlmResponse> result = replayPlugin.beforeModelCallback(callbackContext, llmRequest);
        
        // Assert
        assertNotNull(result);
        assertTrue(result.isEmpty().blockingGet());
        verify(callbackContext, never()).invocationId();
        verify(callbackContext, never()).agentName();
    }
    
    private void setPrivateField(Object target, String fieldName, Object value) {
        try {
            java.lang.reflect.Field field = target.getClass().getDeclaredField(fieldName);
            field.setAccessible(true);
            field.set(target, value);
        } catch (Exception e) {
            throw new RuntimeException("Failed to set private field: " + fieldName, e);
        }
    }
}