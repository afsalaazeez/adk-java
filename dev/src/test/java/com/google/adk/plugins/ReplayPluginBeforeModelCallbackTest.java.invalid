            throw new RuntimeException(e);
        }
    }
    
    @Test
    @Tag("valid")
    void beforeModelCallback_replayModeOff_returnsEmpty() {
        when(callbackContext.state()).thenReturn(sessionState);
        
        Maybe<LlmResponse> result = replayPlugin.beforeModelCallback(callbackContext, llmRequest);
        
        assertNotNull(result);
        assertNull(result.blockingGet());
    }
    
    @Test
    @Tag("invalid")
    void beforeModelCallback_stateNotInitialized_throwsReplayConfigError() {
        Map<String, Object> replayConfig = new HashMap<>();
