        when(ctx.invocationId()).thenReturn(invocationId);
        when(ctx.agentName()).thenReturn(agentName);
        HashMap<String, Object> state = new HashMap<>();
        if (replayMode) {
            state.put("_adk_replay_config", replayConfig != null ? replayConfig :
                    Map.of("dir", "/tmp/testcase", "user_message_index", 42));
        }
        when(ctx.state()).thenAnswer(i -> state); // Use thenAnswer for mutable state
        return ctx;
    }
