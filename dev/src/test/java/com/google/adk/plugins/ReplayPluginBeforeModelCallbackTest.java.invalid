    @Test
    @Tag("invalid")
    public void testThrowsErrorForUnknownInvocationId() {
        Map<String, Object> config = Map.of("_adk_replay_config", Map.of("dir", CASE_DIR, "user_message_index", MESSAGE_INDEX));
        CallbackContext context = buildMockCallbackContext("unknown-invocationId", AGENT_NAME, config);
        LlmRecording llmRecording = mock(LlmRecording.class);
        when(llmRecording.llmRequest()).thenReturn(Optional.empty());
        when(llmRecording.llmResponse()).thenReturn(Optional.of(buildDummyLlmResponse()));
        Recording rec = buildDummyRecording(AGENT_NAME, MESSAGE_INDEX, Optional.of(llmRecording), Optional.empty());
        Recordings recordings = buildDummyRecordings(List.of(rec));
        // Do NOT insert into invocationStates map
        assertThrows(ReplayConfigError.class, () -> replayPlugin.beforeModelCallback(context, buildDummyLlmRequest()),
            "ReplayConfigError should be thrown for unknown invocationId");
    }
