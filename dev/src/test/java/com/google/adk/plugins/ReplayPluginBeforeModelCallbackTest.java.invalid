    @Test
    @Tag("integration")
    void beforeModelCallback_concurrentInvocationsDifferentIds_maintainsSeparateState() {
        Map<String, Object> replayConfig = new HashMap<>();
        replayConfig.put("dir", "/test/path");
        replayConfig.put("user_message_index", 0);
        
        String invocationId1 = "invocation-1";
        String invocationId2 = "invocation-2";
        String agentName = "test-agent";
        
        LlmResponse response1a = mock(LlmResponse.class);
        LlmResponse response1b = mock(LlmResponse.class);
        LlmResponse response2a = mock(LlmResponse.class);
        
        LlmRecording recording1a = mock(LlmRecording.class);
        LlmRecording recording1b = mock(LlmRecording.class);
        LlmRecording recording2a = mock(LlmRecording.class);
        
        Recording rec1a = mock(Recording.class);
        Recording rec1b = mock(Recording.class);
        Recording rec2a = mock(Recording.class);
        
        when(rec1a.agentName()).thenReturn(agentName);
        when(rec1a.userMessageIndex()).thenReturn(0);
        when(rec1a.llmRecording()).thenReturn(Optional.of(recording1a));
        when(rec1a.toolRecording()).thenReturn(Optional.empty());
        
        when(rec1b.agentName()).thenReturn(agentName);
        when(rec1b.userMessageIndex()).thenReturn(0);
        when(rec1b.llmRecording()).thenReturn(Optional.of(recording1b));
        when(rec1b.toolRecording()).thenReturn(Optional.empty());
        
        when(rec2a.agentName()).thenReturn(agentName);
        when(rec2a.userMessageIndex()).thenReturn(0);
        when(rec2a.llmRecording()).thenReturn(Optional.of(recording2a));
        when(rec2a.toolRecording()).thenReturn(Optional.empty());
        
        when(recording1a.llmRequest()).thenReturn(Optional.empty());
        when(recording1a.llmResponse()).thenReturn(Optional.of(response1a));
        
        when(recording1b.llmRequest()).thenReturn(Optional.empty());
        when(recording1b.llmResponse()).thenReturn(Optional.of(response1b));
        
        when(recording2a.llmRequest()).thenReturn(Optional.empty());
        when(recording2a.llmResponse()).thenReturn(Optional.of(response2a));
        
        List<Recording> recordingsList = new ArrayList<>();
        recordingsList.add(rec1a);
        recordingsList.add(rec1b);
        recordingsList.add(rec2a);
        
        Recordings recordings1 = mock(Recordings.class);
        Recordings recordings2 = mock(Recordings.class);
        when(recordings1.recordings()).thenReturn(recordingsList);
        when(recordings2.recordings()).thenReturn(recordingsList);
        
        InvocationReplayState state1 = new InvocationReplayState("/test/path", 0, recordings1);
        InvocationReplayState state2 = new InvocationReplayState("/test/path", 0, recordings2);
        invocationStates.put(invocationId1, state1);
        invocationStates.put(invocationId2, state2);
        
        Map<String, Object> sessionState1 = new HashMap<>();
        sessionState1.put("_adk_replay_config", replayConfig);
        Map<String, Object> sessionState2 = new HashMap<>();
        sessionState2.put("_adk_replay_config", replayConfig);
        
        CallbackContext context1 = mock(CallbackContext.class);
        CallbackContext context2 = mock(CallbackContext.class);
        
        when(context1.state()).thenReturn(sessionState1);
        when(context1.invocationId()).thenReturn(invocationId1);
        when(context1.agentName()).thenReturn(agentName);
        
        when(context2.state()).thenReturn(sessionState2);
        when(context2.invocationId()).thenReturn(invocationId2);
        when(context2.agentName()).thenReturn(agentName);
        
        LlmResponse result1 = replayPlugin.beforeModelCallback(context1, llmRequest).blockingGet();
        assertEquals(response1a, result1);
        
        LlmResponse result2 = replayPlugin.beforeModelCallback(context2, llmRequest).blockingGet();
        assertEquals(response1a, result2);
        
        LlmResponse result3 = replayPlugin.beforeModelCallback(context1, llmRequest).blockingGet();
        assertEquals(response1b, result3);
        
        assertEquals(2, state1.getAgentReplayIndex(agentName));
        assertEquals(1, state2.getAgentReplayIndex(agentName));
    }
    
