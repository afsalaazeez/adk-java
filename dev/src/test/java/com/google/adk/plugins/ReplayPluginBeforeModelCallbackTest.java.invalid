        Recordings recordings = mock(Recordings.class);
        // The 'recordings' method returns ImmutableList<Recording>, but List<Recording> should suffice for mocks
        when(recordings.recordings()).thenReturn(recordingsList == null ? List.of() : recordingsList);
        return recordings;
    }
    private InvocationReplayState buildReplayState(String testCasePath, int userMessageIndex, Recordings recordings, Map<String, Integer> agentReplayIndices) {
        InvocationReplayState state = new InvocationReplayState(testCasePath, userMessageIndex, recordings);
        if (agentReplayIndices != null) {
            for (Map.Entry<String, Integer> entry : agentReplayIndices.entrySet()) {
                state.setAgentReplayIndex(entry.getKey(), entry.getValue());
            }
        }
        return state;
    }
