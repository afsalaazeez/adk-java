/**
 * GeminiBuilderTest overrides connect(LlmRequest) because BaseLlm is abstract and requires this method.
 * The implementation is a stub as builder tests do not require the actual connection logic.
 */
public class GeminiBuilderTest extends BaseLlm {
    public GeminiBuilderTest() {
        super("test-model"); // TODO: Change "test-model" if specific model is required
    }
    @Override
    public BaseLlmConnection connect(LlmRequest llmRequest) {
        // Stub implementation to satisfy abstract method requirement.
        // Tests in this class do not require connection logic.
        return null;
    }
    @Test
    @Tag("valid")
    public void testBuilderReturnsNewBuilderInstance() {
        Gemini.Builder builder = Gemini.builder();
        assertNotNull((Object) builder, "Gemini.builder() should not return null");
        assertTrue((builder instanceof Gemini.Builder), "Gemini.builder() should return a Gemini.Builder instance");
    }
    @Test
    @Tag("boundary")
    public void testBuilderReturnsDistinctInstances() {
        Gemini.Builder builderA = Gemini.builder();
        Gemini.Builder builderB = Gemini.builder();
        assertNotSame((Object) builderA, (Object) builderB, "Gemini.builder() should return distinct Builder instances on each call");
    }
    @Test
    @Tag("boundary")
    public void testDifferentBuilderInstancesAreStateIsolated() {
        Gemini.Builder builderA = Gemini.builder().modelName("test-model-a");
        Gemini.Builder builderB = Gemini.builder();
        Gemini geminiA = builderA.apiKey("dummy-key").build();
        Gemini geminiB = builderB.apiKey("dummy-key-b").modelName("test-model-b").build();
        assertNotEquals(
            (Object) geminiA.model(),
            (Object) geminiB.model(),
            "Builder instances should be state isolated"
        );
    }
    @Test
    @Tag("integration")
    public void testBuilderCanBeUsedToBuildGeminiInstance() {
        Gemini.Builder builder = Gemini.builder().modelName("integration-test-model").apiKey("dummy-key");
        Gemini gemini = builder.build();
        assertNotNull((Object) gemini, "Builder should build a non-null Gemini instance");
        assertEquals(
            (Object) "integration-test-model",
            (Object) gemini.model(),
            "Gemini instance should have the correct model name"
        );
    }
    @Test
    @Tag("valid")
    public void testBuilderDocumentationMatchesBehavior() {
        // Check method signature properties
        try {
            java.lang.reflect.Method builderMethod = Gemini.class.getDeclaredMethod("builder");
            assertTrue(java.lang.reflect.Modifier.isStatic(builderMethod.getModifiers()), "builder() should be static");
            assertTrue(java.lang.reflect.Modifier.isPublic(builderMethod.getModifiers()), "builder() should be public");
            assertEquals(
                (Object) Gemini.Builder.class,
                (Object) builderMethod.getReturnType(),
                "builder() should return Gemini.Builder"
            );
            assertEquals(
                0,
                builderMethod.getParameterCount(),
                "builder() should be parameterless"
            );
        } catch (NoSuchMethodException e) {
            fail("Gemini should contain a public, static, parameterless builder() method");
        }
    }
}