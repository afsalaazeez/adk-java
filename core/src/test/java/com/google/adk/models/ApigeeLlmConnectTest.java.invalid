        Assertions.assertThrows(IllegalArgumentException.class, () -> apigeeLlm.connect(mockLlmRequest));
    }
    @Test
    @Tag("valid")
    @DisplayName("modelStringWithVersionNoProvider")
    public void testModelStringWithVersionNoProvider() {
        Gemini mockGemini = Mockito.mock(Gemini.class);
        BaseLlmConnection mockConnection = Mockito.mock(BaseLlmConnection.class);
        Mockito.when(mockGemini.connect(Mockito.any())).thenReturn(mockConnection);
        ApigeeLlm apigeeLlm = new ApigeeLlm("apigee/v1/gemini-2.5-flash", mockGemini);
        LlmRequest mockLlmRequest = Mockito.mock(LlmRequest.class);
        Mockito.when(mockLlmRequest.model()).thenReturn(Optional.empty());
        Mockito.when(mockLlmRequest.toBuilder()).thenReturn(new MockLlmRequestBuilder(mockLlmRequest));
        apigeeLlm.connect(mockLlmRequest);
        ArgumentCaptor<LlmRequest> captor = ArgumentCaptor.forClass(LlmRequest.class);
        Mockito.verify(mockGemini).connect(captor.capture());
        LlmRequest forwarded = captor.getValue();
        Assertions.assertEquals("gemini-2.5-flash", (String)forwarded.model().orElse(""));
    }
    @Test
    @Tag("invalid")
    @DisplayName("malformedModelStringThrowsException")
    public void testMalformedModelStringThrowsException() {
        Gemini mockGemini = Mockito.mock(Gemini.class);
        ApigeeLlm apigeeLlm = new ApigeeLlm("apigee/gemini//gemini-2.5-flash", mockGemini);
        LlmRequest mockLlmRequest = Mockito.mock(LlmRequest.class);
        Mockito.when(mockLlmRequest.model()).thenReturn(Optional.empty());
        Mockito.when(mockLlmRequest.toBuilder()).thenReturn(new MockLlmRequestBuilder(mockLlmRequest));
        Assertions.assertThrows(IllegalArgumentException.class, () -> apigeeLlm.connect(mockLlmRequest));
        ApigeeLlm apigeeLlm2 = new ApigeeLlm("apigee//v1/gemini-2.5-flash", mockGemini);
        LlmRequest mockLlmRequest2 = Mockito.mock(LlmRequest.class);
        Mockito.when(mockLlmRequest2.model()).thenReturn(Optional.empty());
        Mockito.when(mockLlmRequest2.toBuilder()).thenReturn(new MockLlmRequestBuilder(mockLlmRequest2));
        Assertions.assertThrows(IllegalArgumentException.class, () -> apigeeLlm2.connect(mockLlmRequest2));
    }
    // --- Helper Mock Classes ---
    static class MockLlmRequestBuilder extends LlmRequest.Builder {
        String configString;
        String liveConnectConfigString;
        Optional<String> modelField;
        LlmRequest original;
        MockLlmRequestBuilder(LlmRequest original) {
            this.original = original;
            this.configString = null;
            this.liveConnectConfigString = null;
            this.modelField = Optional.empty();
        }
        @Override
        public MockLlmRequestBuilder model(String model) {
            this.modelField = Optional.ofNullable(model);
            return this;
        }
        // Content, GenerateContentConfig, LiveConnectConfig, BaseTool not available so methods are no-ops/dummy
        @Override
        public MockLlmRequestBuilder contents(List contents) { return this; }
        @Override
        public MockLlmRequestBuilder config(Object config) { return this; }
        @Override
        public MockLlmRequestBuilder liveConnectConfig(Object liveConnectConfig) { return this; }
        @Override
        public MockLlmRequestBuilder tools(Map tools) { return this; }
        @Override
        public MockLlmRequest build() {
            return new MockLlmRequest(modelField, configString, liveConnectConfigString);
        }
    }
    static class MockLlmRequest extends LlmRequest {
        Optional<String> modelValue;
        String configString;
        String liveConnectConfigString;
        MockLlmRequest(Optional<String> model, String configString, String liveConnectConfigString) {
            this.modelValue = model;
            this.configString = configString;
            this.liveConnectConfigString = liveConnectConfigString;
        }
        @Override public Optional<String> model() { return this.modelValue; }
        // Return dummy or empty objects for abstract methods since dependent types are not available.
        @Override public List contents() { return List.of(); }
        @Override public Optional config() { return Optional.empty(); }
        @Override public Object liveConnectConfig() { return null; }
        @Override public Map tools() { return Map.of(); }
        @Override public LlmRequest.Builder toBuilder() { return new MockLlmRequestBuilder(this); }
    }
}