    @Test
    @Tag("boundary")
    void sendRealtimeWithLargeBlobData() throws Exception {
        // Arrange
        CompletableFuture<AsyncSession> sessionFuture = CompletableFuture.completedFuture(mockSession);
        when(mockApiClient.async.live.connect(anyString(), any(LiveConnectConfig.class)))
                .thenReturn(sessionFuture);
        
        byte[] largeData = new byte[1024 * 1024]; // 1MB
        for (int i = 0; i < largeData.length; i++) {
            largeData[i] = (byte) (i % 256);
        }
        
        Blob largeBlob = Blob.builder()
                .mimeType("audio/pcm")
                .data(largeData)
                .build();
        
        when(mockSession.sendRealtimeInput(any(LiveSendRealtimeInputParameters.class)))
                .thenReturn(CompletableFuture.completedFuture(null));
        when(mockSession.receive(any())).thenReturn(CompletableFuture.completedFuture(null));
        when(mockSession.close()).thenReturn(CompletableFuture.completedFuture(null));
        GeminiLlmConnection connection = new GeminiLlmConnection(mockApiClient, modelName, connectConfig);
        Thread.sleep(100); // Allow connection setup
        // Act
        Completable completable = connection.sendRealtime(largeBlob);
        TestObserver<Void> testObserver = completable.test();
        // Assert
        testObserver.await(10, TimeUnit.SECONDS);
        testObserver.assertComplete();
        testObserver.assertNoErrors();
        
        ArgumentCaptor<LiveSendRealtimeInputParameters> captor = 
                ArgumentCaptor.forClass(LiveSendRealtimeInputParameters.class);
        verify(mockSession, times(1)).sendRealtimeInput(captor.capture());
        
        assertEquals(largeData.length, captor.getValue().media().get().data().length);
        
        connection.close();
    }
}