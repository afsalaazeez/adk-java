    @Test
    @Tag("integration")
    void concurrentSendRealtimeBlobOperations() throws Exception {
        // Arrange
        CompletableFuture<AsyncSession> sessionFuture = CompletableFuture.completedFuture(mockSession);
        AtomicInteger sendCount = new AtomicInteger(0);
        
        when(mockSession.sendRealtimeInput(any(LiveSendRealtimeInputParameters.class)))
                .thenAnswer(invocation -> {
                    sendCount.incrementAndGet();
                    return CompletableFuture.completedFuture(null);
                });
        when(mockSession.receive(any())).thenReturn(CompletableFuture.completedFuture(null));
        GeminiLlmConnection connection = createConnectionWithSession(sessionFuture);
        int numThreads = 5;
        ExecutorService executor = Executors.newFixedThreadPool(numThreads);
        CountDownLatch startLatch = new CountDownLatch(1);
        CountDownLatch completionLatch = new CountDownLatch(numThreads);
        // Act
        for (int i = 0; i < numThreads; i++) {
            final int index = i;
            executor.submit(() -> {
                try {
                    startLatch.await();
                    Blob blob = Blob.builder()
                            .mimeType("audio/pcm")
                            .data(new byte[]{(byte) index})
                            .build();
                    connection.sendRealtime(blob).blockingAwait(5, TimeUnit.SECONDS);
                } catch (Exception e) {
                    // Handle exception
                } finally {
                    completionLatch.countDown();
                }
            });
        }
        startLatch.countDown();
        boolean completed = completionLatch.await(10, TimeUnit.SECONDS);
        executor.shutdown();
        // Assert
        assert completed : "Not all threads completed in time";
        assert sendCount.get() == numThreads : "Expected " + numThreads + " sends but got " + sendCount.get();
    }
