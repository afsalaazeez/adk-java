// Fixed import for VertexCredentials (should be in com.google.adk.models or imported according to actual location)
public class BuilderApiKeyTest {
    // Helper method to instantiate Gemini.Builder cleanly
    private Gemini.Builder newBuilder() {
        // Gemini builder is a non-parameterized constructor
        return new Gemini.Builder();
    }
    @Test
    @Tag("valid")
    public void testApiKeySetsValidApiKeyString() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        String key = "test-api-key";
        builder.apiKey(key);
        assertEquals(key, (String) ((Gemini.Builder) builder).apiKey);
    }
    @Test
    @Tag("boundary")
    public void testApiKeyAcceptsNullValue() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        builder.apiKey(null);
        assertNull((String) ((Gemini.Builder) builder).apiKey);
    }
    @Test
    @Tag("boundary")
    public void testApiKeyAcceptsEmptyString() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        builder.apiKey("");
        assertEquals("", (String) ((Gemini.Builder) builder).apiKey);
    }
    @Test
    @Tag("valid")
    public void testApiKeyOverridesPreviousValue() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        builder.apiKey("old-key");
        builder.apiKey("new-key");
        assertEquals("new-key", (String) ((Gemini.Builder) builder).apiKey);
    }
    @Test
    @Tag("integration")
    public void testApiKeySupportsMethodChaining() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        // Use dummy values for VertexCredentials as required
        VertexCredentials creds = VertexCredentials.builder().build();
        Gemini.Builder chain = (Gemini.Builder) builder.modelName("test-model").apiKey("some-key").vertexCredentials(creds);
        assertSame(builder, chain);
        assertEquals("some-key", (String) ((Gemini.Builder) builder).apiKey);
    }
    @Test
    @Tag("valid")
    public void testApiKeyAssignmentWhenApiClientPresent() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        Client client = Client.builder().httpOptions(HttpOptions.builder().build()).build();
        builder.apiClient(client).apiKey("dummy-key");
        assertEquals("dummy-key", (String) ((Gemini.Builder) builder).apiKey);
    }
    @Test
    @Tag("valid")
    public void testApiKeyAssignmentWhenVertexCredentialsPresent() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        VertexCredentials creds = VertexCredentials.builder().build();
        builder.vertexCredentials(creds).apiKey("abc-key");
        assertEquals("abc-key", (String) ((Gemini.Builder) builder).apiKey);
        assertSame(creds, ((Gemini.Builder) builder).vertexCredentials);
    }
    @Test
    @Tag("boundary")
    public void testApiKeyAcceptsWhitespaceOnly() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        String whitespaces = "   ";
        builder.apiKey(whitespaces);
        assertEquals(whitespaces, (String) ((Gemini.Builder) builder).apiKey);
    }
    @Test
    @Tag("integration")
    public void testApiKeyReturnsBuilderInstance() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        Gemini.Builder result = (Gemini.Builder) builder.apiKey("some-key");
        assertSame(builder, result);
    }
    @Test
    @Tag("boundary")
    public void testApiKeyAcceptsLargeString() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        String largeKey = "X".repeat(10000); // 10,000 characters
        builder.apiKey(largeKey);
        assertEquals(largeKey, (String) ((Gemini.Builder) builder).apiKey);
    }
    @Test
    @Tag("valid")
    public void testApiKeyAcceptsUnicodeAndSpecialChars() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        String specialKey = "kéy-✓-测试-☂️-$!";
        builder.apiKey(specialKey);
        assertEquals(specialKey, (String) ((Gemini.Builder) builder).apiKey);
    }
    @Test
    @Tag("integration")
    public void testApiKeyBeforeModelNameAssignment() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        builder.apiKey("first-key");
        builder.modelName("gemini-model");
        assertEquals("first-key", (String) ((Gemini.Builder) builder).apiKey);
        assertEquals("gemini-model", (String) ((Gemini.Builder) builder).modelName);
    }
    @Test
    @Tag("integration")
    public void testApiKeyAllowsAssignmentPostBuild() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        builder.apiKey("old-key");
        builder.modelName("after-old-key");
        builder.build();
        builder.apiKey("new-key");
        assertEquals("new-key", (String) ((Gemini.Builder) builder).apiKey);
    }
    @Test
    @Tag("boundary")
    public void testApiKeySetToNullOverwritesPrevious() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        builder.apiKey("not-null-key");
        builder.apiKey(null);
        assertNull((String) ((Gemini.Builder) builder).apiKey);
    }
    @Test
    @Tag("boundary")
    public void testApiKeyHandlesSingleCharacter() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        builder.apiKey("A");
        assertEquals("A", (String) ((Gemini.Builder) builder).apiKey);
    }
    @Test
    @Tag("valid")
    public void testApiKeyAllowsRedundantAssignment() {
        Gemini.Builder builder = (Gemini.Builder) newBuilder();
        builder.apiKey("repeat-key");
        builder.apiKey("repeat-key");
        assertEquals("repeat-key", (String) ((Gemini.Builder) builder).apiKey);
    }
}