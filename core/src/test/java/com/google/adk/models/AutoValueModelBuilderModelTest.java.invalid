package com.google.adk.models;import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import java.util.Optional;
import javax.annotation.processing.Generated;

// Use the real BaseLlm interface from the actual package
public class AutoValueModelBuilderModelTest {
    // Provide a minimal dummy BaseLlm implementation that is visible for type assignment
    static class DummyBaseLlm implements BaseLlm {
        private final String name;
        DummyBaseLlm(String name) { this.name = name; }
        @Override
        public String toString() { return name; }
    }
    // Helper to create a new Builder instance
    private Model.Builder newBuilder() {
        return new AutoValue_Model.Builder();
    }
    @Test
    @Tag("valid")
    public void testModelSetsValidBaseLlmInstance() {
        Model.Builder builder = newBuilder();
        BaseLlm baseLlm = new DummyBaseLlm("BaseLlmInstance");
        builder.model(baseLlm);
        Model model = builder.build();
        assertTrue(((Optional<BaseLlm>) model.model()).isPresent());
        assertSame(baseLlm, ((Optional<BaseLlm>) model.model()).get());
    }
    @Test
    @Tag("valid")
    public void testModelReplacesPreviousValueWhenCalledMultipleTimes() {
        Model.Builder builder = newBuilder();
        BaseLlm first = new DummyBaseLlm("First");
        BaseLlm second = new DummyBaseLlm("Second");
        builder.model(first);
        builder.model(second);
        Model model = builder.build();
        assertTrue(((Optional<BaseLlm>) model.model()).isPresent());
        assertSame(second, ((Optional<BaseLlm>) model.model()).get());
    }
    @Test
    @Tag("invalid")
    public void testModelThrowsExceptionOnNullInput() {
        Model.Builder builder = newBuilder();
        assertThrows(NullPointerException.class, () -> builder.model((BaseLlm) null));
    }
    @Test
    @Tag("integration")
    public void testModelDoesNotAffectBuiltModelImmutability() {
        Model.Builder builder = newBuilder();
        BaseLlm llm1 = new DummyBaseLlm("Immutable1");
        BaseLlm llm2 = new DummyBaseLlm("Immutable2");
        builder.model(llm1);
        Model builtModel = builder.build();
        builder.model(llm2);
        // The built model should be unaffected by further builder mutation.
        assertTrue(((Optional<BaseLlm>) builtModel.model()).isPresent());
        assertSame(llm1, ((Optional<BaseLlm>) builtModel.model()).get());
    }
    @Test
    @Tag("valid")
    public void testModelSupportsFluentChainingWithModelName() {
        Model.Builder builder = newBuilder();
        BaseLlm llm = new DummyBaseLlm("ChainedLlm");
        String expectedName = "TestModel";
        builder.model(llm).modelName(expectedName);
        Model model = builder.build();
        assertTrue(((Optional<BaseLlm>) model.model()).isPresent());
        assertSame(llm, ((Optional<BaseLlm>) model.model()).get());
        assertTrue(((Optional<String>) model.modelName()).isPresent());
        assertEquals(expectedName, ((Optional<String>) model.modelName()).get());
    }
    @Test
    @Tag("valid")
    public void testModelReplacesEmptyOptionalWithProvidedInstance() {
        Model.Builder builder = newBuilder();
        BaseLlm llm = new DummyBaseLlm("NonEmpty");
        Model modelBefore = builder.build();
        assertFalse(((Optional<BaseLlm>) modelBefore.model()).isPresent());
        builder.model(llm);
        Model modelAfter = builder.build();
        assertTrue(((Optional<BaseLlm>) modelAfter.model()).isPresent());
        assertSame(llm, ((Optional<BaseLlm>) modelAfter.model()).get());
    }
    @Test
    @Tag("integration")
    public void testModelValueReflectedInToStringOutput() {
        Model.Builder builder = newBuilder();
        BaseLlm llm = new DummyBaseLlm("ForToString");
        builder.model(llm);
        Model model = builder.build();
        String toStringValue = model.toString();
        assertNotNull(toStringValue);
        assertTrue(toStringValue.contains("ForToString"), "toString should contain the model's string representation");
    }
}