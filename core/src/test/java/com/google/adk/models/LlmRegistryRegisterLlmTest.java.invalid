    @Test
    @Tag("valid")
    void registerMultipleLlmFactoriesWithDifferentPatterns() throws Exception {
        // Arrange
        String pattern1 = "model-a";
        String pattern2 = "model-b";
        String pattern3 = "model-c";
        BaseLlm llm1 = mock(BaseLlm.class);
        BaseLlm llm2 = mock(BaseLlm.class);
        BaseLlm llm3 = mock(BaseLlm.class);
        LlmRegistry.LlmFactory factory1 = mock(LlmRegistry.LlmFactory.class);
        LlmRegistry.LlmFactory factory2 = mock(LlmRegistry.LlmFactory.class);
        LlmRegistry.LlmFactory factory3 = mock(LlmRegistry.LlmFactory.class);
        when(factory1.create(pattern1)).thenReturn(llm1);
        when(factory2.create(pattern2)).thenReturn(llm2);
        when(factory3.create(pattern3)).thenReturn(llm3);
        // Act
        LlmRegistry.registerLlm(pattern1, factory1);
        LlmRegistry.registerLlm(pattern2, factory2);
        LlmRegistry.registerLlm(pattern3, factory3);
        // Assert
        Map<String, LlmRegistry.LlmFactory> factories = getLlmFactoriesMap();
        assertThat(factories).hasSize(3);
        assertThat(factories).containsKey(pattern1);
        assertThat(factories).containsKey(pattern2);
        assertThat(factories).containsKey(pattern3);
        assertThat(LlmRegistry.getLlm(pattern1)).isEqualTo(llm1);
        assertThat(LlmRegistry.getLlm(pattern2)).isEqualTo(llm2);
        assertThat(LlmRegistry.getLlm(pattern3)).isEqualTo(llm3);
