    @Test
    @Tag("valid")
    void registerLlmWithSpecialRegexCharactersInPattern() throws Exception {
        // Arrange
        String specialPattern = "model\\.v[0-9]+";
        when(mockFactory.create("model.v1")).thenReturn(mockBaseLlm);
        when(mockFactory.create("model.v99")).thenReturn(mockBaseLlm);
        // Act
        LlmRegistry.registerLlm(specialPattern, mockFactory);
        // Assert
        Map<String, LlmRegistry.LlmFactory> factories = getLlmFactoriesMap();
        assertThat(factories).containsKey(specialPattern);
        BaseLlm result1 = LlmRegistry.getLlm("model.v1");
        BaseLlm result2 = LlmRegistry.getLlm("model.v99");
        assertThat(result1).isEqualTo(mockBaseLlm);
        assertThat(result2).isEqualTo(mockBaseLlm);
    }
    @Test
    @Tag("integration")
    void registerLlmIsThreadSafe() throws Exception {
        // Arrange
        int threadCount = 10;
        ExecutorService executor = Executors.newFixedThreadPool(threadCount);
        CountDownLatch startLatch = new CountDownLatch(1);
        CountDownLatch completionLatch = new CountDownLatch(threadCount);
        // Act
        for (int i = 0; i < threadCount; i++) {
            final int index = i;
            executor.submit(() -> {
                try {
                    startLatch.await();
                    String pattern = "thread-model-" + index;
                    LlmRegistry.LlmFactory factory = mock(LlmRegistry.LlmFactory.class);
                    LlmRegistry.registerLlm(pattern, factory);
                } catch (InterruptedException e) {
                    Thread.currentThread().interrupt();
                } finally {
                    completionLatch.countDown();
                }
            });
        }
        startLatch.countDown();
        boolean completed = completionLatch.await(5, TimeUnit.SECONDS);
        executor.shutdown();
        // Assert
        assertThat(completed).isTrue();
        Map<String, LlmRegistry.LlmFactory> factories = getLlmFactoriesMap();
        assertThat(factories).hasSize(threadCount);
        for (int i = 0; i < threadCount; i++) {
            assertThat(factories).containsKey("thread-model-" + i);
        }
    }
    @Test
    @Tag("valid")
    void registerLlmOverridesDefaultGeminiFactory() throws Exception {
        // Arrange
        String geminiPattern = "gemini-.*";
        BaseLlm customGeminiLlm = mock(BaseLlm.class);
        LlmRegistry.LlmFactory customFactory = mock(LlmRegistry.LlmFactory.class);
        when(customFactory.create("gemini-pro")).thenReturn(customGeminiLlm);
        // Act
        LlmRegistry.registerLlm(geminiPattern, customFactory);
        // Assert
        Map<String, LlmRegistry.LlmFactory> factories = getLlmFactoriesMap();
        assertThat(factories.get(geminiPattern)).isEqualTo(customFactory);
        BaseLlm result = LlmRegistry.getLlm("gemini-pro");
        assertThat(result).isEqualTo(customGeminiLlm);
        verify(customFactory).create("gemini-pro");
    }
}