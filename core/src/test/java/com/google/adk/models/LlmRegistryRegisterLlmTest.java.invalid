@ExtendWith(MockitoExtension.class)
class LlmRegistryRegisterLlmTest {
    @Mock
    private BaseLlm mockBaseLlm;
    @Mock
    private LlmRegistry.LlmFactory mockFactory;
    @BeforeEach
    void setUp() throws Exception {
        // Clear the llmFactories and instances maps before each test
        clearStaticMaps();
    }
    private void clearStaticMaps() throws Exception {
        Field factoriesField = LlmRegistry.class.getDeclaredField("llmFactories");
        factoriesField.setAccessible(true);
        @SuppressWarnings("unchecked")
        Map<String, LlmRegistry.LlmFactory> factories = (Map<String, LlmRegistry.LlmFactory>) factoriesField.get(null);
        factories.clear();
        Field instancesField = LlmRegistry.class.getDeclaredField("instances");
        instancesField.setAccessible(true);
        @SuppressWarnings("unchecked")
        Map<String, BaseLlm> instances = (Map<String, BaseLlm>) instancesField.get(null);
        instances.clear();
    }
    @SuppressWarnings("unchecked")
    private Map<String, LlmRegistry.LlmFactory> getLlmFactoriesMap() throws Exception {
        Field factoriesField = LlmRegistry.class.getDeclaredField("llmFactories");
        factoriesField.setAccessible(true);
        return (Map<String, LlmRegistry.LlmFactory>) factoriesField.get(null);
    }
    @Test
    @Tag("valid")
    void registerLlmWithSimpleModelNamePattern() throws Exception {
        // Arrange
        String modelNamePattern = "custom-model";
        when(mockFactory.create(modelNamePattern)).thenReturn(mockBaseLlm);
        // Act
        LlmRegistry.registerLlm(modelNamePattern, mockFactory);
        // Assert
        Map<String, LlmRegistry.LlmFactory> factories = getLlmFactoriesMap();
        assertThat(factories).containsKey(modelNamePattern);
        assertThat(factories.get(modelNamePattern)).isEqualTo(mockFactory);
        BaseLlm result = LlmRegistry.getLlm(modelNamePattern);
        assertThat(result).isEqualTo(mockBaseLlm);
        verify(mockFactory).create(modelNamePattern);
    }
    @Test
    @Tag("valid")
    void registerLlmWithRegexPattern() throws Exception {
        // Arrange
        String regexPattern = "custom-.*";
        when(mockFactory.create("custom-v1")).thenReturn(mockBaseLlm);
        when(mockFactory.create("custom-v2")).thenReturn(mockBaseLlm);
        // Act
        LlmRegistry.registerLlm(regexPattern, mockFactory);
        // Assert
        Map<String, LlmRegistry.LlmFactory> factories = getLlmFactoriesMap();
        assertThat(factories).containsKey(regexPattern);
        BaseLlm result1 = LlmRegistry.getLlm("custom-v1");
        BaseLlm result2 = LlmRegistry.getLlm("custom-v2");
        assertThat(result1).isEqualTo(mockBaseLlm);
        assertThat(result2).isEqualTo(mockBaseLlm);
        verify(mockFactory).create("custom-v1");
        verify(mockFactory).create("custom-v2");
    }
    @Test
    @Tag("valid")
    void registerLlmOverridesExistingFactory() throws Exception {
        // Arrange
        String modelNamePattern = "test-model";
        BaseLlm firstLlm = mock(BaseLlm.class);
        BaseLlm secondLlm = mock(BaseLlm.class);
        LlmRegistry.LlmFactory firstFactory = mock(LlmRegistry.LlmFactory.class);
        LlmRegistry.LlmFactory secondFactory = mock(LlmRegistry.LlmFactory.class);
        when(secondFactory.create(modelNamePattern)).thenReturn(secondLlm);
        // Act
        LlmRegistry.registerLlm(modelNamePattern, firstFactory);
        LlmRegistry.registerLlm(modelNamePattern, secondFactory);
        // Assert
        Map<String, LlmRegistry.LlmFactory> factories = getLlmFactoriesMap();
        assertThat(factories.get(modelNamePattern)).isEqualTo(secondFactory);
        BaseLlm result = LlmRegistry.getLlm(modelNamePattern);
        assertThat(result).isEqualTo(secondLlm);
        verify(firstFactory, never()).create(anyString());
        verify(secondFactory).create(modelNamePattern);
    }
