    public void testConcurrentFactoryRegistrationIsThreadSafe() throws InterruptedException {
        String pattern = "concurrent-pattern";
        int threadsCount = 10; // Adjust number as needed for concurrency test
        ExecutorService executor = Executors.newFixedThreadPool(threadsCount);
        List<LlmRegistry.LlmFactory> factories = new ArrayList<>();
        for (int i = 0; i < threadsCount; i++) {
            factories.add(new TestLlmFactory("Factory-" + i));
        }
        CountDownLatch startLatch = new CountDownLatch(1);
        CountDownLatch finishLatch = new CountDownLatch(threadsCount);
        for (int i = 0; i < threadsCount; i++) {
            final int idx = i;
            executor.submit(() -> {
                try {
                    startLatch.await();
                    LlmRegistry.registerLlm(pattern, factories.get(idx));
                } catch (InterruptedException ignored) {} finally {
                    finishLatch.countDown();
                }
            });
        }
        startLatch.countDown();
        finishLatch.await();
        executor.shutdown();
        // NO ACCESS: Cannot check which factory persisted. Business logic should expose result for testability.
    }
