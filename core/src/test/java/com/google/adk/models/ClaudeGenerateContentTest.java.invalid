    @Test
    @Tag("integration")
    public void testLogsClaudeResponse() {
        Content content = buildContentWithParts(List.of(buildTextPart("Log this response")), "user");
        LlmRequest llmRequest = LlmRequest.builder()
                .contents(ImmutableList.of(content))
                .config(Optional.empty())
                .tools(ImmutableMap.of())
                .liveConnectConfig(LiveConnectConfig.builder().build())
                .build();
        Message message = buildMessageWithText("Logging test");
        when(mockInnerAnthropicMessages.create(any(MessageCreateParams.class))).thenReturn(message);
        Claude claudeWithLogger = spy(new Claude("claude-3", anthropicClient));
        doReturn(mockInnerAnthropicMessages).when(claudeWithLogger).anthropicClient.messages();
        doNothing().when(claudeWithLogger.logger).debug(anyString(), any());
        claudeWithLogger.generateContent(llmRequest, false).toList().blockingGet();
        verify(claudeWithLogger.logger, times(1)).debug(eq("Claude response: {}"), eq(message));
    }
    @Test
    @Tag("integration")
    public void testOutputFlowableHasConvertedLlmResponse() {
        Content content = buildContentWithParts(List.of(buildTextPart("Convert check")), "user");
        LlmRequest llmRequest = LlmRequest.builder()
                .contents(ImmutableList.of(content))
                .config(Optional.empty())
                .tools(ImmutableMap.of())
                .liveConnectConfig(LiveConnectConfig.builder().build())
                .build();
        Message message = buildMessageWithText("Convert me");
        LlmResponse expected = claude.convertAnthropicResponseToLlmResponse(message);
        when(mockInnerAnthropicMessages.create(any(MessageCreateParams.class))).thenReturn(message);
        Flowable<LlmResponse> result = claude.generateContent(llmRequest, false);
        List<LlmResponse> emitted = result.toList().blockingGet();
        assertEquals((int)1, emitted.size());
        assertEquals((Object)expected, emitted.get(0));
    }
    @Test
    @Tag("integration")
    public void testStreamParameterSetTrue() {
        Content content = buildContentWithParts(List.of(buildTextPart("Set stream true")), "user");
        LlmRequest llmRequest = LlmRequest.builder()
                .contents(ImmutableList.of(content))
                .config(Optional.empty())
                .tools(ImmutableMap.of())
                .liveConnectConfig(LiveConnectConfig.builder().build())
                .build();
        Message message = buildMessageWithText("Streamed output");
        when(mockInnerAnthropicMessages.create(any(MessageCreateParams.class))).thenReturn(message);
        Flowable<LlmResponse> result1 = claude.generateContent(llmRequest, false);
        Flowable<LlmResponse> result2 = claude.generateContent(llmRequest, true);
        List<LlmResponse> emitted1 = result1.toList().blockingGet();
        List<LlmResponse> emitted2 = result2.toList().blockingGet();
        assertEquals((Object)emitted1, emitted2);
    }
    @Test
    @Tag("boundary")
    public void testSystemInstructionContainsNonTextPart() {
        Part textPart = buildTextPart("Only this should join");
        Part nonTextPart = Part.builder().build(); // No text
        Content systemInstruction = Content.builder()
                .role("system")
                .parts(ImmutableList.of(textPart, nonTextPart))
                .build();
        GenerateContentConfig config = buildConfigWithSystemInstruction(systemInstruction, Optional.empty());
        Content content = buildContentWithParts(List.of(buildTextPart("Test")), "user");
        LlmRequest llmRequest = LlmRequest.builder()
                .contents(ImmutableList.of(content))
                .config(Optional.of(config))
                .tools(ImmutableMap.of())
                .liveConnectConfig(LiveConnectConfig.builder().build())
                .build();
        Message message = buildMessageWithText("Should see only text part in system");
        when(mockInnerAnthropicMessages.create(any(MessageCreateParams.class))).thenReturn(message);
        Flowable<LlmResponse> result = claude.generateContent(llmRequest, false);
        ArgumentCaptor<MessageCreateParams> captor = ArgumentCaptor.forClass(MessageCreateParams.class);
        verify(mockInnerAnthropicMessages).create(captor.capture());
        MessageCreateParams params = captor.getValue();
        assertEquals((Object)"Only this should join", params.system());
        assertEquals((Object)claude.convertAnthropicResponseToLlmResponse(message), result.toList().blockingGet().get(0));
    }
