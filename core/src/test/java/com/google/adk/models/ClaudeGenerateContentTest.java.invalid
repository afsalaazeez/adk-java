/**
 * Test class ClaudeGenerateContentTest Claude.generateContent
 */
@ExtendWith(MockitoExtension.class)
class ClaudeGenerateContentTest {
    @Mock
    private AnthropicClient anthropicClient;
    // Cannot mock AnthropicClient.Messages as there is no symbol in the interface; need to mock concrete api for messages()
    @Mock
    private AnthropicClient.MessagesApi anthropicMessages;
    @Mock
    private Logger mockLogger;
    private static final String DUMMY_MODEL = "claude-3";
    private static final int DUMMY_MAX_TOKENS = 4096;
    private Claude claude;
    @BeforeEach
    void setup() {
        // adjust: use the proper API object for anthropicClient.messages()
        when(anthropicClient.messages()).thenReturn(anthropicMessages);
        claude = new Claude(DUMMY_MODEL, anthropicClient, DUMMY_MAX_TOKENS);
    }
    @Test
    @Tag("valid")
    void testGenerateContentWithTextContentAndDefaultConfig() {
        // Arrange
        // Prepare part (text)
        String textContent = "Hello, Anthropic!";
        Part textPart = Part.builder().text(textContent).build();
        // Prepare Content with a single text part, role is "user"
        Content content = Content.builder()
                .role("user")
                .parts(Optional.of(ImmutableList.of(textPart)))
                .build();
        // Prepare mock LlmRequest
        LlmRequest llmRequest = mock(LlmRequest.class);
        when(llmRequest.contents()).thenReturn(ImmutableList.of(content));
        when(llmRequest.config()).thenReturn(Optional.empty());
        when(llmRequest.tools()).thenReturn(ImmutableMap.of());
        when(llmRequest.model()).thenReturn(Optional.empty());
        // Prepare expected parameter transformation
        MessageParam expectedMessageParam = MessageParam.builder()
                .role(Role.USER)
                .contentOfBlockParams(
                        ImmutableList.of(ContentBlockParam.ofText(
                                TextBlockParam.builder().text(textContent).build()
                        ))
                ).build();
        // Set up expected MessageCreateParams that Claude will build
        // Need to capture this when create() is called
        ArgumentCaptor<MessageCreateParams> paramsCaptor = ArgumentCaptor.forClass(MessageCreateParams.class);
        // Prepare stubbed response (simulating Anthropic API)
        String expectedGeneratedText = "Hello from Claude!";
        ContentBlock textBlock = mock(ContentBlock.class);
        when(textBlock.isText()).thenReturn(true);
        when(textBlock.asText()).thenReturn(
                com.anthropic.models.messages.TextBlock.of(expectedGeneratedText, null)
        );
        List<ContentBlock> messageBlocks = ImmutableList.of(textBlock);
        Message message = mock(Message.class);
        when(message.content()).thenReturn((List<ContentBlock>)messageBlocks);
        when(anthropicMessages.create(any())).thenReturn(message);
        // Act
        Flowable<LlmResponse> resultFlowable = claude.generateContent(llmRequest, false);
        // Assert
        LlmResponse response = resultFlowable.blockingFirst();
        assertNotNull((Object)response, "LlmResponse should not be null");
        assertNotNull((Object)response.content(), "Content should not be null");
        assertEquals((Object)"model", (Object)response.content().role(), "Returned role must be model");
        assertTrue(((Content)response.content()).parts().isPresent(), "Content parts should be present");
        List<Part> parts = ((Content)response.content()).parts().get();
        assertEquals(1, (int)parts.size(), "Should return one part");
        assertEquals((Object)expectedGeneratedText, (Object)parts.get(0).text().orElse(""), "Returned part text must match stub response");
        // Validate that correct MessageCreateParams was constructed
        verify(anthropicMessages, times(1)).create(paramsCaptor.capture());
        MessageCreateParams paramsSent = paramsCaptor.getValue();
        assertEquals((Object)DUMMY_MODEL, (Object)paramsSent.model(), "Model should be the default one set in the constructor");
        assertEquals((Object)"", (Object)paramsSent.system(), "System prompt should be empty by default");
        assertEquals((Object)ImmutableList.of(expectedMessageParam), (Object)paramsSent.messages(), "Messages list should contain one user message");
        assertEquals((int)DUMMY_MAX_TOKENS, (int)paramsSent.maxTokens(), "maxTokens should match the constructor arg");
        assertNull(paramsSent.tools(), "Tools should not be set if no tools present");
        assertNull(paramsSent.toolChoice(), "ToolChoice should not be set if no tools present");
    }
    // TODO: Add further tests for other scenarios (e.g., with tools, with system instructions, etc.)
}