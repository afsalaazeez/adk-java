// Note: BaseLlm, LlmRequest, LlmResponse, LiveConnectConfig, BaseLlmConnection, BaseTool are considered available in the package.
public class ClaudeGenerateContentTest extends BaseLlm {
    @Mock
    private AnthropicClient anthropicClient;
    // ERROR WAS HERE: AnthropicClient.Messages does not exist, so just use AnthropicClient for conversation
    // private AnthropicClient.Messages mockMessages;
    // FIX: Use interface type for .messages() invocation
    @Mock
    private AnthropicClient mockInnerAnthropicMessages;
    @Mock
    private Logger logger;
    private Claude claude;
    @BeforeEach
    public void setUp() {
        MockitoAnnotations.openMocks(this);
        claude = new Claude("claude-3", anthropicClient);
        // Patch anthropicClient.messages() to our mock
        // The AnthropicClient interface might expose a .messages() returning itself or another type
        // Here, we assume .messages() returns a AnthropicClient as it's not well defined, but no .Messages inner type
        when(anthropicClient.messages()).thenReturn(mockInnerAnthropicMessages);
    }
    // Helper to build Part with text
    private Part buildTextPart(String text) {
        return Part.builder().text(text).build();
    }
    // Helper to create Content with Parts
    private Content buildContentWithParts(List<Part> parts, String role) {
        return Content.builder().role(role).parts(ImmutableList.copyOf(parts)).build();
    }
    // Helper for GenerateContentConfig
    private GenerateContentConfig buildConfigWithSystemInstruction(Content systemInstruction, Optional<List<com.google.genai.types.Tool>> toolsOpt) {
        GenerateContentConfig.Builder builder = GenerateContentConfig.builder();
        if (systemInstruction != null) {
            builder.systemInstruction(Optional.of(systemInstruction));
        }
        if (toolsOpt.isPresent()) {
            builder.tools(toolsOpt);
        }
        return builder.build();
    }
    // Helper for FunctionDeclaration
    private FunctionDeclaration buildFunctionDeclaration(String functionName, String description) {
        return FunctionDeclaration.builder()
                .name(Optional.of(functionName))
                .description(Optional.of(description))
                .build();
    }
    // Helper for Message
    private Message buildMessageWithText(String text) {
        ContentBlock textBlock = ContentBlockParam.ofText(TextBlockParam.builder().text(text).build()).asContentBlock();
        List<ContentBlock> contentBlocks = new ArrayList<>();
        contentBlocks.add(textBlock);
        return Message.builder().content(contentBlocks).build();
    }
    // Helper for LlmResponse
    private LlmResponse buildLlmResponseWithText(String text) {
        Part part = Part.builder().text(text).build();
        Content content = Content.builder().role("model").parts(ImmutableList.of(part)).build();
        return LlmResponse.builder().content(content).build();
    }
    // ---- TESTS BELOW ----
    // Scenario 1: Valid LlmRequest with Content, No Tools
    @Test
    @Tag("valid")
    public void testValidLlmRequestWithContentNoTools() {
        List<Part> parts = List.of(buildTextPart("Hello, Claude."));
        Content content = buildContentWithParts(parts, "user");
        LlmRequest llmRequest = LlmRequest.builder()
                .contents(ImmutableList.of(content))
                .config(Optional.empty())
                .tools(ImmutableMap.of()) // no tools
                .liveConnectConfig(LiveConnectConfig.builder().build())
                .build();
        Message message = buildMessageWithText("Hi, there.");
        when(mockInnerAnthropicMessages.create(any(MessageCreateParams.class))).thenReturn(message);
        Flowable<LlmResponse> result = claude.generateContent(llmRequest, false);
        LlmResponse expected = claude.convertAnthropicResponseToLlmResponse(message);
        List<LlmResponse> responses = result.toList().blockingGet();
        assertEquals((Object)expected, responses.get(0));
    }
    // Scenario 2: Tools Provided with No Config
    @Test
    @Tag("integration")
    public void testToolsProvidedNoConfig() {
        Content content = buildContentWithParts(List.of(buildTextPart("Request with tool")), "user");
        Map<String, BaseTool> toolsMap = ImmutableMap.of("toolA", mock(BaseTool.class));
        LlmRequest llmRequest = LlmRequest.builder()
                .contents(ImmutableList.of(content))
                .config(Optional.empty())
                .tools(toolsMap)
                .liveConnectConfig(LiveConnectConfig.builder().build())
                .build();
        Message message = buildMessageWithText("Tool response");
        when(mockInnerAnthropicMessages.create(any(MessageCreateParams.class))).thenReturn(message);
        Flowable<LlmResponse> flowable = claude.generateContent(llmRequest, false);
        ArgumentCaptor<MessageCreateParams> captor = ArgumentCaptor.forClass(MessageCreateParams.class);
        verify(mockInnerAnthropicMessages, times(1)).create(captor.capture());
        MessageCreateParams params = captor.getValue();
        assertNotNull((Object)params.toolChoice());
        assertNotNull((Object)params.tools());
        List<LlmResponse> emitted = flowable.toList().blockingGet();
        assertEquals((Object)claude.convertAnthropicResponseToLlmResponse(message), emitted.get(0));
    }
    // Scenario 3: Tools Declared in Config
    @Test
    @Tag("integration")
    public void testToolsDeclaredInConfig() {
        Content content = buildContentWithParts(List.of(buildTextPart("Use declared tool")), "user");
        FunctionDeclaration declaration = buildFunctionDeclaration("fn1", "desc");
        com.google.genai.types.Tool genaiTool = com.google.genai.types.Tool.builder()
                .functionDeclarations(Optional.of(ImmutableList.of(declaration)))
                .build();
        GenerateContentConfig config = buildConfigWithSystemInstruction(
                null, Optional.of(ImmutableList.of(genaiTool)));
        LlmRequest llmRequest = LlmRequest.builder()
                .contents(ImmutableList.of(content))
                .config(Optional.of(config))
                .tools(ImmutableMap.of("toolB", mock(BaseTool.class)))
                .liveConnectConfig(LiveConnectConfig.builder().build())
                .build();
        Message message = buildMessageWithText("Handled tool declaration");
        when(mockInnerAnthropicMessages.create(any(MessageCreateParams.class))).thenReturn(message);
        Flowable<LlmResponse> flowable = claude.generateContent(llmRequest, false);
        ArgumentCaptor<MessageCreateParams> captor = ArgumentCaptor.forClass(MessageCreateParams.class);
        verify(mockInnerAnthropicMessages, times(1)).create(captor.capture());
        MessageCreateParams params = captor.getValue();
        assertNotNull((Object)params.tools());
        assertTrue(((List<ToolUnion>)params.tools()).size() >= 1);
        assertNotNull((Object)params.toolChoice());
        List<LlmResponse> emitted = flowable.toList().blockingGet();
        assertEquals((Object)claude.convertAnthropicResponseToLlmResponse(message), emitted.get(0));
    }
