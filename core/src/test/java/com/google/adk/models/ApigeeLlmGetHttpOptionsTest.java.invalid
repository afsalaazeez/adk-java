    @Test
    @Tag("valid")
    @DisplayName("Retrieve Default HttpOptions After Standard Construction")
    public void testMethod_getHttpOptionsReturnsExpectedObjectAfterStandardConstruction() {
        Map<String, String> customHeaders = Collections.singletonMap(CUSTOM_HEADER_KEY, CUSTOM_HEADER_VALUE);
        ApigeeLlm apigee = ApigeeLlm.builder()
                .modelName(TEST_MODEL_VALID)
                .proxyUrl(TEST_PROXY_URL)
                .customHeaders(customHeaders)
                .build();
        HttpOptions options = apigee.getHttpOptions();
        Assertions.assertNotNull(options, "HttpOptions must not be null after construction.");
        Assertions.assertEquals(TEST_PROXY_URL, options.baseUrl(), "HttpOptions baseUrl should match builder's proxyUrl.");
        for (Map.Entry<String, String> entry : customHeaders.entrySet()) {
            Map<String, String> headers = options.headers();
            Assertions.assertTrue(headers.containsKey(entry.getKey()), "Custom header not found.");
            Assertions.assertEquals(entry.getValue(), headers.get(entry.getKey()), "Custom header value mismatch.");
        }
    }
