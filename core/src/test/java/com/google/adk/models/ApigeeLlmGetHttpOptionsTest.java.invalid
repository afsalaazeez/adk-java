    // Utility to set environment variable for tests using reflection
    private static void setEnv(String key, String value) throws Exception {
        try {
            Map<String, String> env = System.getenv();
            Class<?> cl = env.getClass();
            Field field = cl.getDeclaredField("m");
            field.setAccessible(true);
            @SuppressWarnings("unchecked")
            Map<String, String> mutableEnv = (Map<String, String>) field.get(env);
            if (value != null) {
                mutableEnv.put(key, value);
            } else {
                mutableEnv.remove(key);
            }
        } catch (Exception ex) {
            // If cannot set, test will rely on whatever is present
        }
    }
