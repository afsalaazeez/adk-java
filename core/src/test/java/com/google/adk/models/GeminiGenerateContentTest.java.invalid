    @Test
    @Tag("valid")
    void generateContentStreamingFilterAllowsMixedContentTypes() {
        try (MockedStatic<GeminiUtil> geminiUtilMock = mockStatic(GeminiUtil.class)) {
            LlmRequest request = LlmRequest.builder()
                    .contents(Arrays.asList(Content.builder().role("user").parts(Part.fromText("Hello")).build()))
                    .build();
            geminiUtilMock.when(() -> GeminiUtil.prepareGenenerateContentRequest(any(), anyBoolean(), anyBoolean()))
                    .thenReturn(request);
            FunctionCall functionCall = FunctionCall.builder().name("testFunc").build();
            Part mixedPart = Part.builder()
                    .text("Some text")
                    .functionCall(functionCall)
                    .build();
            GenerateContentResponse response = GenerateContentResponse.builder()
                    .candidates(Arrays.asList(Candidate.builder()
                            .content(Content.builder().role("model").parts(mixedPart).build())
                            .build()))
                    .build();
            ResponseStream<GenerateContentResponse> responseStream = createMockResponseStream(Arrays.asList(response));
            CompletableFuture<ResponseStream<GenerateContentResponse>> streamFuture = CompletableFuture.completedFuture(responseStream);
            when(mockModels.generateContentStream(anyString(), anyList(), any())).thenReturn(streamFuture);
            geminiUtilMock.when(() -> GeminiUtil.getPart0FromLlmResponse(any()))
                    .thenReturn(Optional.of(mixedPart));
            geminiUtilMock.when(() -> GeminiUtil.shouldEmitAccumulatedText(any())).thenReturn(false);
            List<LlmResponse> responses = gemini.generateContent(request, true).toList().blockingGet();
            assertFalse(responses.isEmpty());
        }
    }
    private ResponseStream<GenerateContentResponse> createMockResponseStream(List<GenerateContentResponse> responses) {
        return new ResponseStream<GenerateContentResponse>() {
            @Override
            public Iterator<GenerateContentResponse> iterator() {
                return responses.iterator();
            }
        };
    }
}