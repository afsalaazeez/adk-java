package com.google.adk.models;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.*;
import static org.mockito.Mockito.*;
import com.google.genai.Client;
import com.google.genai.ResponseStream;
import com.google.genai.types.Candidate;
import com.google.genai.types.Content;
import com.google.genai.types.FinishReason;
import com.google.genai.types.FunctionCall;
import com.google.genai.types.FunctionResponse;
import com.google.genai.types.GenerateContentConfig;
import com.google.genai.types.GenerateContentResponse;
import com.google.genai.types.Part;
import io.reactivex.rxjava3.core.Flowable;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.Iterator;
import java.util.List;
import java.util.Optional;
import java.util.concurrent.CompletableFuture;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.MockedStatic;
import org.mockito.junit.jupiter.MockitoExtension;
import org.junit.jupiter.api.*;
import static com.google.common.base.StandardSystemProperty.JAVA_VERSION;
import com.google.adk.Version;
import com.google.common.collect.ImmutableMap;
import com.google.errorprone.annotations.CanIgnoreReturnValue;
import com.google.genai.types.HttpOptions;
import com.google.genai.types.LiveConnectConfig;
import java.util.Objects;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

@ExtendWith(MockitoExtension.class)
class GeminiGenerateContentTest {
    @Mock
    private Client mockClient;
    @Mock
    private Client.Async mockAsync;
    @Mock
    private Client.Async.Models mockModels;
    private Gemini gemini;
    private static final String DEFAULT_MODEL = "gemini-pro";
    private static final String CUSTOM_MODEL = "gemini-custom";
    @BeforeEach
    void setUp() {
        when(mockClient.async()).thenReturn(mockAsync);
        when(mockAsync.models()).thenReturn(mockModels);
        when(mockClient.vertexAI()).thenReturn(false);
        gemini = new Gemini(DEFAULT_MODEL, mockClient);
    }
    @Test
    @Tag("valid")
    void generateContentNonStreamingWithValidRequest() {
        try (MockedStatic<GeminiUtil> geminiUtilMock = mockStatic(GeminiUtil.class)) {
            LlmRequest request = LlmRequest.builder()
                    .contents(Arrays.asList(Content.builder().role("user").parts(Part.fromText("Hello")).build()))
                    .build();
            geminiUtilMock.when(() -> GeminiUtil.prepareGenenerateContentRequest(any(), anyBoolean(), anyBoolean()))
                    .thenReturn(request);
            GenerateContentResponse apiResponse = GenerateContentResponse.builder()
                    .candidates(Arrays.asList(Candidate.builder()
                            .content(Content.builder().role("model").parts(Part.fromText("Hi there")).build())
                            .build()))
                    .build();
            CompletableFuture<GenerateContentResponse> future = CompletableFuture.completedFuture(apiResponse);
            when(mockModels.generateContent(anyString(), anyList(), any())).thenReturn(future);
            List<LlmResponse> responses = gemini.generateContent(request, false).toList().blockingGet();
            assertEquals(1, responses.size());
            assertTrue(responses.get(0).content().isPresent());
            verify(mockModels).generateContent(eq(DEFAULT_MODEL), anyList(), isNull());
        }
    }
    @Test
    @Tag("valid")
    void generateContentStreamingWithValidRequest() {
        try (MockedStatic<GeminiUtil> geminiUtilMock = mockStatic(GeminiUtil.class)) {
            LlmRequest request = LlmRequest.builder()
                    .contents(Arrays.asList(Content.builder().role("user").parts(Part.fromText("Hello")).build()))
                    .build();
            geminiUtilMock.when(() -> GeminiUtil.prepareGenenerateContentRequest(any(), anyBoolean(), anyBoolean()))
                    .thenReturn(request);
            GenerateContentResponse response1 = GenerateContentResponse.builder()
                    .candidates(Arrays.asList(Candidate.builder()
                            .content(Content.builder().role("model").parts(Part.fromText("Hello")).build())
                            .build()))
                    .build();
            GenerateContentResponse response2 = GenerateContentResponse.builder()
                    .candidates(Arrays.asList(Candidate.builder()
                            .content(Content.builder().role("model").parts(Part.fromText(" World")).build())
                            .build()))
                    .build();
            ResponseStream<GenerateContentResponse> responseStream = createMockResponseStream(Arrays.asList(response1, response2));
            CompletableFuture<ResponseStream<GenerateContentResponse>> streamFuture = CompletableFuture.completedFuture(responseStream);
            when(mockModels.generateContentStream(anyString(), anyList(), any())).thenReturn(streamFuture);
            geminiUtilMock.when(() -> GeminiUtil.getPart0FromLlmResponse(any()))
                    .thenReturn(Optional.of(Part.fromText("Hello")))
                    .thenReturn(Optional.of(Part.fromText(" World")));
            geminiUtilMock.when(() -> GeminiUtil.shouldEmitAccumulatedText(any())).thenReturn(false);
            List<LlmResponse> responses = gemini.generateContent(request, true).toList().blockingGet();
            assertFalse(responses.isEmpty());
            verify(mockModels).generateContentStream(eq(DEFAULT_MODEL), anyList(), isNull());
        }
    }
