            assertFalse(responses.isEmpty());
        }
    }
    @Test
    @Tag("valid")
    void generateContentNonStreamingEmitsSingleResponse() {
        try (MockedStatic<GeminiUtil> geminiUtilMock = mockStatic(GeminiUtil.class)) {
            LlmRequest request = LlmRequest.builder()
                    .contents(Arrays.asList(Content.builder().role("user").parts(Part.fromText("test")).build()))
                    .build();
            geminiUtilMock.when(() -> GeminiUtil.prepareGenenerateContentRequest(any(), anyBoolean(), anyBoolean()))
                    .thenReturn(request);
            GenerateContentResponse response = GenerateContentResponse.builder()
                    .candidates(Arrays.asList(Candidate.builder()
                            .content(Content.builder().role("model").parts(Part.fromText("response")).build())
                            .build()))
                    .build();
            CompletableFuture<GenerateContentResponse> future = CompletableFuture.completedFuture(response);
            when(mockModels.generateContent(anyString(), anyList(), any())).thenReturn(future);
            Flowable<LlmResponse> result = gemini.generateContent(request, false);
            List<LlmResponse> responses = result.toList().blockingGet();
            assertEquals(1, responses.size());
            assertNotNull(responses.get(0));
        }
    }
}