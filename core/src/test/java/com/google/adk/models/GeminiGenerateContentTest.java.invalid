    @Test
    @Tag("valid")
    void generateContentStreamingProcessesMultipleResponses() {
        try (MockedStatic<GeminiUtil> geminiUtilMock = mockStatic(GeminiUtil.class)) {
            LlmRequest request = LlmRequest.builder()
                    .contents(Arrays.asList(Content.builder().role("user").parts(Part.fromText("Hello")).build()))
                    .build();
            geminiUtilMock.when(() -> GeminiUtil.prepareGenenerateContentRequest(any(), anyBoolean(), anyBoolean()))
                    .thenReturn(request);
            List<GenerateContentResponse> responses = Arrays.asList(
                    GenerateContentResponse.builder()
                            .candidates(Arrays.asList(Candidate.builder()
                                    .content(Content.builder().role("model").parts(Part.fromText("First")).build())
                                    .build()))
                            .build(),
                    GenerateContentResponse.builder()
                            .candidates(Arrays.asList(Candidate.builder()
                                    .content(Content.builder().role("model").parts(Part.fromText("Second")).build())
                                    .build()))
                            .build(),
                    GenerateContentResponse.builder()
                            .candidates(Arrays.asList(Candidate.builder()
                                    .content(Content.builder().role("model").parts(Part.fromText("Third")).build())
                                    .build()))
                            .build()
            );
            ResponseStream<GenerateContentResponse> responseStream = createMockResponseStream(responses);
            CompletableFuture<ResponseStream<GenerateContentResponse>> streamFuture = CompletableFuture.completedFuture(responseStream);
            when(mockModels.generateContentStream(anyString(), anyList(), any())).thenReturn(streamFuture);
            geminiUtilMock.when(() -> GeminiUtil.getPart0FromLlmResponse(any()))
                    .thenReturn(Optional.of(Part.fromText("First")))
                    .thenReturn(Optional.of(Part.fromText("Second")))
                    .thenReturn(Optional.of(Part.fromText("Third")));
            geminiUtilMock.when(() -> GeminiUtil.shouldEmitAccumulatedText(any())).thenReturn(false);
            List<LlmResponse> result = gemini.generateContent(request, true).toList().blockingGet();
            assertFalse(result.isEmpty());
        }
    }
