    @Test
    @Tag("valid")
    void generateContentWithStreamingEnabledReturnsFilteredFlowable() {
        try (MockedStatic<GeminiUtil> geminiUtilMock = mockStatic(GeminiUtil.class)) {
            LlmRequest request = LlmRequest.builder()
                    .contents(Arrays.asList(Content.builder().role("user").parts(Part.fromText("test")).build()))
                    .build();
            geminiUtilMock.when(() -> GeminiUtil.prepareGenenerateContentRequest(any(), anyBoolean(), anyBoolean()))
                    .thenReturn(request);
            GenerateContentResponse response = GenerateContentResponse.builder()
                    .candidates(Arrays.asList(Candidate.builder()
                            .content(Content.builder().role("model").parts(Part.fromText("response")).build())
                            .build()))
                    .build();
            ResponseStream<GenerateContentResponse> responseStream = () -> Arrays.asList(response).iterator();
            CompletableFuture<ResponseStream<GenerateContentResponse>> future = CompletableFuture.completedFuture(responseStream);
            when(mockModels.generateContentStream(anyString(), anyList(), any())).thenReturn(future);
            geminiUtilMock.when(() -> GeminiUtil.getPart0FromLlmResponse(any()))
                    .thenReturn(Optional.of(Part.fromText("response")));
            Flowable<LlmResponse> result = gemini.generateContent(request, true);
            assertNotNull(result);
            List<LlmResponse> responses = result.toList().blockingGet();
            assertFalse(responses.isEmpty());
            verify(mockModels).generateContentStream(eq(TEST_MODEL), anyList(), isNull());
        }
    }
