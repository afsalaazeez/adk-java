    @Test
    @Tag("valid")
    void generateContentStreamingIncludesFunctionCallResponses() {
        try (MockedStatic<GeminiUtil> geminiUtilMock = mockStatic(GeminiUtil.class)) {
            LlmRequest request = LlmRequest.builder()
                    .contents(Arrays.asList(Content.builder().role("user").parts(Part.fromText("Call function")).build()))
                    .build();
            geminiUtilMock.when(() -> GeminiUtil.prepareGenenerateContentRequest(any(), anyBoolean(), anyBoolean()))
                    .thenReturn(request);
            FunctionCall functionCall = FunctionCall.builder().name("testFunction").build();
            Part functionCallPart = Part.builder().functionCall(functionCall).build();
            GenerateContentResponse functionResponse = GenerateContentResponse.builder()
                    .candidates(Arrays.asList(Candidate.builder()
                            .content(Content.builder().role("model").parts(functionCallPart).build())
                            .build()))
                    .build();
            ResponseStream<GenerateContentResponse> responseStream = createMockResponseStream(Arrays.asList(functionResponse));
            CompletableFuture<ResponseStream<GenerateContentResponse>> streamFuture = CompletableFuture.completedFuture(responseStream);
            when(mockModels.generateContentStream(anyString(), anyList(), any())).thenReturn(streamFuture);
            geminiUtilMock.when(() -> GeminiUtil.getPart0FromLlmResponse(any()))
                    .thenReturn(Optional.of(functionCallPart));
            geminiUtilMock.when(() -> GeminiUtil.shouldEmitAccumulatedText(any())).thenReturn(true);
            List<LlmResponse> responses = gemini.generateContent(request, true).toList().blockingGet();
            assertFalse(responses.isEmpty());
            assertTrue(responses.stream().anyMatch(r -> r.content().flatMap(Content::parts)
                    .map(parts -> parts.stream().anyMatch(p -> p.functionCall().isPresent())).orElse(false)));
        }
    }
