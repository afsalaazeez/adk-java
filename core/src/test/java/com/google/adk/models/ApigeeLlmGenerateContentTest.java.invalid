        LlmRequest builtRequest = mock(LlmRequest.class);
        when(mockRequest.toBuilder()).thenReturn(mockBuilder);
        when(mockBuilder.model("my-model")).thenReturn(mockBuilder);
        when(mockBuilder.build()).thenReturn(builtRequest);
        Flowable<LlmResponse> expectedFlowable = Flowable.just(mock(LlmResponse.class));
        when(mockGeminiDelegate.generateContent(builtRequest, false)).thenReturn(expectedFlowable);
        ApigeeLlm apigee = new ApigeeLlm(validModelString, mockGeminiDelegate);
        Flowable<LlmResponse> actualFlowable = apigee.generateContent(mockRequest, false);
        Assertions.assertEquals(expectedFlowable, actualFlowable);
        verify(mockGeminiDelegate, times(1)).generateContent(builtRequest, false);
        verify(mockBuilder, times(1)).model("my-model");
    }
