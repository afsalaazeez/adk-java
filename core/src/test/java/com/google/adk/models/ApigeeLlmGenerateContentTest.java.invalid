    @Test
    @Tag("integration")
    public void testIsThreadSafeForConcurrentInvocations() throws InterruptedException {
        String modelString = "apigee/vertex_ai/v1/my-model";
        ApigeeLlm apigee = new ApigeeLlm(modelString, mockGeminiDelegate);
        LlmRequest mockRequest1 = mock(LlmRequest.class);
        LlmRequest.Builder builder1 = mock(LlmRequest.Builder.class);
        LlmRequest builtRequest1 = mock(LlmRequest.class);
        when(mockRequest1.model()).thenReturn(Optional.of(modelString));
        when(mockRequest1.toBuilder()).thenReturn(builder1);
        when(builder1.model("my-model")).thenReturn(builder1);
        when(builder1.build()).thenReturn(builtRequest1);
        LlmRequest mockRequest2 = mock(LlmRequest.class);
        LlmRequest.Builder builder2 = mock(LlmRequest.Builder.class);
        LlmRequest builtRequest2 = mock(LlmRequest.class);
        when(mockRequest2.model()).thenReturn(Optional.of(modelString));
        when(mockRequest2.toBuilder()).thenReturn(builder2);
        when(builder2.model("my-model")).thenReturn(builder2);
        when(builder2.build()).thenReturn(builtRequest2);
        Flowable<LlmResponse> flowable1 = Flowable.just(mock(LlmResponse.class));
        Flowable<LlmResponse> flowable2 = Flowable.just(mock(LlmResponse.class));
        when(mockGeminiDelegate.generateContent(builtRequest1, false)).thenReturn(flowable1);
        when(mockGeminiDelegate.generateContent(builtRequest2, false)).thenReturn(flowable2);
        Thread t1 = new Thread(() -> {
            Flowable<LlmResponse> result = apigee.generateContent(mockRequest1, false);
            Assertions.assertEquals(flowable1, result);
        });
        Thread t2 = new Thread(() -> {
            Flowable<LlmResponse> result = apigee.generateContent(mockRequest2, false);
            Assertions.assertEquals(flowable2, result);
        });
        t1.start();
        t2.start();
        t1.join();
        t2.join();
        verify(mockGeminiDelegate, times(1)).generateContent(builtRequest1, false);
        verify(mockGeminiDelegate, times(1)).generateContent(builtRequest2, false);
    }
    @Test
    @Tag("integration")
    public void testUsesDefaultModelFromInstanceWhenRequestModelAbsent() {
        String subclassModel = "apigee/vertex_ai/v1/subclass-model";
        LlmRequest mockRequest = mock(LlmRequest.class);
        LlmRequest.Builder builder = mock(LlmRequest.Builder.class);
        LlmRequest builtRequest = mock(LlmRequest.class);
        when(mockRequest.model()).thenReturn(Optional.empty());
        when(mockRequest.toBuilder()).thenReturn(builder);
        when(builder.model("subclass-model")).thenReturn(builder);
        when(builder.build()).thenReturn(builtRequest);
        Flowable<LlmResponse> expectedFlowable = Flowable.just(mock(LlmResponse.class));
        ApigeeLlm apigee = new ApigeeLlm(subclassModel, mockGeminiDelegate);
        when(mockGeminiDelegate.generateContent(builtRequest, false)).thenReturn(expectedFlowable);
        Flowable<LlmResponse> result = apigee.generateContent(mockRequest, false);
        Assertions.assertEquals(expectedFlowable, result);
        verify(builder).model("subclass-model");
    }
    @Test
    @Tag("boundary")
    public void testThrowsExceptionOnOversizedModelString() {
        StringBuilder sb = new StringBuilder();
        sb.append("apigee/vertex_ai/v2/");
        for (int i = 0; i < 10000; i++) { sb.append("X"); }
        String longModelString = sb.toString();
        LlmRequest mockRequest = mock(LlmRequest.class);
        when(mockRequest.model()).thenReturn(Optional.of(longModelString));
        ApigeeLlm apigee = new ApigeeLlm("apigee/vertex_ai/v2/default", mockGeminiDelegate);
        Assertions.assertThrows(IllegalArgumentException.class, () -> {
            apigee.generateContent(mockRequest, false);
        });
        verify(mockGeminiDelegate, never()).generateContent(any(), anyBoolean());
    }
}