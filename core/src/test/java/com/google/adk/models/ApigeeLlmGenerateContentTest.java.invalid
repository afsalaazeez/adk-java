        when(builder.model("my-model")).thenReturn(builder);
        when(builder.build()).thenReturn(builtRequest);
        Flowable<LlmResponse> expectedFlowableTrue = Flowable.just(mock(LlmResponse.class));
        Flowable<LlmResponse> expectedFlowableFalse = Flowable.just(mock(LlmResponse.class));
        ApigeeLlm apigee = new ApigeeLlm(validModelString, mockGeminiDelegate);
        when(mockGeminiDelegate.generateContent(builtRequest, true)).thenReturn(expectedFlowableTrue);
        when(mockGeminiDelegate.generateContent(builtRequest, false)).thenReturn(expectedFlowableFalse);
        Flowable<LlmResponse> flowableTrue = apigee.generateContent(mockRequest, true);
        Flowable<LlmResponse> flowableFalse = apigee.generateContent(mockRequest, false);
        Assertions.assertEquals(expectedFlowableTrue, flowableTrue);
        Assertions.assertEquals(expectedFlowableFalse, flowableFalse);
        verify(mockGeminiDelegate, times(1)).generateContent(builtRequest, true);
        verify(mockGeminiDelegate, times(1)).generateContent(builtRequest, false);
    }
