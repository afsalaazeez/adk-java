package com.google.adk.models;
import static com.google.common.truth.Truth.assertThat;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertThrows;
import io.reactivex.rxjava3.core.Flowable;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.*;

class BaseLlmConnectTest {
    private static final String TEST_MODEL_NAME = "gemini-1.5-flash";
    private static final String TEST_MODEL_VARIANT = "gemini-1.5-flash-001";
    private TestBaseLlm baseLlm;
    private TestBaseLlm baseLlmVariant;
    private LlmRequest validLlmRequest;
    private LlmRequest emptyLlmRequest;
    private LlmRequest complexLlmRequest;
    @BeforeEach
    void setUp() {
        baseLlm = new TestBaseLlm(TEST_MODEL_NAME);
        baseLlmVariant = new TestBaseLlm(TEST_MODEL_VARIANT);
        
        validLlmRequest = LlmRequest.builder()
                .model(TEST_MODEL_NAME)
                .build();
        
        emptyLlmRequest = LlmRequest.builder().build();
        
        complexLlmRequest = LlmRequest.builder()
                .model(TEST_MODEL_NAME)
                .build();
    }
    @Test
    @Tag("valid")
    void connectWithValidLlmRequest() {
        BaseLlmConnection connection = baseLlm.connect(validLlmRequest);
        
        assertNotNull(connection);
    }
    @Test
    @Tag("invalid")
    void connectWithNullLlmRequest() {
        assertThrows(NullPointerException.class, () -> {
            baseLlm.connect(null);
        });
    }
    @Test
    @Tag("boundary")
    void connectWithEmptyLlmRequest() {
        BaseLlmConnection connection = baseLlm.connect(emptyLlmRequest);
        
        assertNotNull(connection);
    }
    @Test
    @Tag("valid")
    void connectMultipleSequentialConnections() {
        LlmRequest firstRequest = LlmRequest.builder()
                .model(TEST_MODEL_NAME)
                .build();
        
        LlmRequest secondRequest = LlmRequest.builder()
                .model(TEST_MODEL_NAME)
                .build();
        
        BaseLlmConnection firstConnection = baseLlm.connect(firstRequest);
        BaseLlmConnection secondConnection = baseLlm.connect(secondRequest);
        
        assertNotNull(firstConnection);
        assertNotNull(secondConnection);
        assertThat(firstConnection).isNotSameInstanceAs(secondConnection);
    }
    @Test
    @Tag("valid")
    void connectWithModelNameVerification() {
        BaseLlmConnection connection = baseLlm.connect(validLlmRequest);
        
        assertNotNull(connection);
        assertThat(baseLlm.model()).isEqualTo(TEST_MODEL_NAME);
    }
    @Test
    @Tag("valid")
    void connectReturnsBaseLlmConnectionType() {
        BaseLlmConnection connection = baseLlm.connect(validLlmRequest);
        
        assertNotNull(connection);
        assertThat(connection).isInstanceOf(BaseLlmConnection.class);
    }
    @Test
    @Tag("valid")
    void connectWithComplexLlmRequest() {
        BaseLlmConnection connection = baseLlm.connect(complexLlmRequest);
        
        assertNotNull(connection);
    }
    @Test
    @Tag("valid")
    void connectIdempotencyWithSameLlmRequest() {
        BaseLlmConnection firstConnection = baseLlm.connect(validLlmRequest);
        BaseLlmConnection secondConnection = baseLlm.connect(validLlmRequest);
        
        assertNotNull(firstConnection);
        assertNotNull(secondConnection);
        assertThat(firstConnection).isNotSameInstanceAs(secondConnection);
    }
    @Test
    @Tag("valid")
    void connectWithDifferentModelVariants() {
        LlmRequest requestForVariant = LlmRequest.builder()
                .model(TEST_MODEL_VARIANT)
                .build();
        
        BaseLlmConnection connectionOriginal = baseLlm.connect(validLlmRequest);
        BaseLlmConnection connectionVariant = baseLlmVariant.connect(requestForVariant);
        
        assertNotNull(connectionOriginal);
        assertNotNull(connectionVariant);
        assertThat(baseLlm.model()).isEqualTo(TEST_MODEL_NAME);
        assertThat(baseLlmVariant.model()).isEqualTo(TEST_MODEL_VARIANT);
    }
    @Test
    @Tag("valid")
    void connectStateIndependence() {
        String modelNameBefore = baseLlm.model();
        
        BaseLlmConnection connection = baseLlm.connect(validLlmRequest);
        
        String modelNameAfter = baseLlm.model();
        
        assertNotNull(connection);
        assertThat(modelNameBefore).isEqualTo(modelNameAfter);
        assertThat(modelNameAfter).isEqualTo(TEST_MODEL_NAME);
    }
    private static class TestBaseLlm extends BaseLlm {
        
        public TestBaseLlm(String model) {
            super(model);
        }
        @Override
        public Flowable<LlmResponse> generateContent(LlmRequest llmRequest, boolean stream) {
            return Flowable.empty();
        }
        @Override
        public BaseLlmConnection connect(LlmRequest llmRequest) {
            if (llmRequest == null) {
                throw new NullPointerException("LlmRequest cannot be null");
            }
            return new TestBaseLlmConnection();
        }
    }
    private static class TestBaseLlmConnection implements BaseLlmConnection {
        
        @Override
        public Flowable<LlmResponse> send(LlmRequest llmRequest) {
            return Flowable.empty();
        }
        @Override
        public void close() {
        }
    }
}