    @Tag("valid")
    @DisplayName("Multiple BaseLlm instances should create independent connections")
    void multipleBaseLlmInstancesCreateIndependentConnections() {
        // Arrange
        TestBaseLlm llm1 = new TestBaseLlm("model-1");
        TestBaseLlm llm2 = new TestBaseLlm("model-2");
