    void connectWithLlmRequestContainingContents() {
        // Arrange
        LlmRequest requestWithContents = LlmRequest.builder()
                .contents(ImmutableList.of())
                .tools(ImmutableMap.of())
                .build();
        // Act
        BaseLlmConnection connection = baseLlm.connect(requestWithContents);
        // Assert
        assertNotNull(connection);
    }
