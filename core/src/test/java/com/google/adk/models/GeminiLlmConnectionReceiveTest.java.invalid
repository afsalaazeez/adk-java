        when(mockSession.receive(any())).thenReturn(CompletableFuture.completedFuture(null));
        when(mockSession.close()).thenReturn(CompletableFuture.completedFuture(null));
        GeminiLlmConnection connection = new GeminiLlmConnection(mockClient, modelName, connectConfig);
        Thread.sleep(100);
        
        TestSubscriber<LlmResponse> testSubscriber = connection.receive().test();
        
        connection.close();
        
        testSubscriber.await(2, TimeUnit.SECONDS);
        testSubscriber.assertComplete();
        testSubscriber.assertNoValues();
        testSubscriber.assertNoErrors();
    }
}