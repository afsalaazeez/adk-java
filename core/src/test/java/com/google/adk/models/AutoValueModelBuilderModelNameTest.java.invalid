    public void testModelNameHandlesSpecialCharacters() {
        // Arrange
        AutoValue_Model.Builder builder = newBuilder();
        String specialName = "Mödel#42 @2024"; // TODO: Replace with desired special char string if required
        // Act
        builder.modelName(specialName);
        // Assert
        Model model = builder.build();
        assertEquals((Optional<String>) Optional.of(specialName), (Optional<String>) model.modelName());
    }
    @Test
    @Tag("integration")
    public void testModelNameBuilderAndModelConsistency() {
        // Arrange
        AutoValue_Model.Builder builder = newBuilder();
        String value = "Consistent";
        // Act
        builder.modelName(value);
        Model model = builder.build();
        // Assert
        assertEquals((Optional<String>) Optional.of(value), (Optional<String>) model.modelName());
    }
    @Test
    @Tag("valid")
    public void testModelNameDoesNotAffectOtherFields() {
