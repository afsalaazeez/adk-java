package com.google.adk.models;import java.util.Optional;
import javax.annotation.processing.Generated;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Assertions;
import com.google.adk.models.AutoValue_Model;
import com.google.adk.models.AutoValue_Model.Builder;
import com.google.adk.models.Model;
import com.google.adk.models.BaseLlm;
import org.junit.jupiter.api.*;

public class AutoValueModelBuilderModelNameTest {
    // Scenario 1: Setting a legitimate model name value
    @Test
    @Tag("valid")
    public void testModelNameSetsValidString() {
        Builder builder = new AutoValue_Model.Builder();
        String expectedName = "OpenAI";
        builder.modelName(expectedName);
        // Cannot access builder.modelName directly (private), so test by building the model
        Model model = builder.build();
        Assertions.assertEquals(
            (Optional<String>) Optional.of(expectedName),
            (Optional<String>) model.modelName(),
            "Built Model.modelName should contain Optional.of('OpenAI')"
        );
    }
    // Scenario 2: Handling null as model name
    @Test
    @Tag("invalid")
    public void testModelNameThrowsExceptionOnNullInput() {
        Builder builder = new AutoValue_Model.Builder();
        Assertions.assertThrows(
            NullPointerException.class,
            () -> builder.modelName(null),
            "Setting modelName(null) should throw NullPointerException"
        );
    }
    // Scenario 3: Accepting an empty string as model name
    @Test
    @Tag("boundary")
    public void testModelNameAcceptsEmptyString() {
        Builder builder = new AutoValue_Model.Builder();
        builder.modelName("");
        // Cannot access builder.modelName directly (private), so test by building the model
        Model model = builder.build();
        Assertions.assertEquals(
            (Optional<String>) Optional.of(""),
            (Optional<String>) model.modelName(),
            "Built Model.modelName should contain Optional.of(\"\")"
        );
    }
    // Scenario 4: Chaining modelName calls
    @Test
    @Tag("valid")
    public void testModelNameAllowsFluentChaining() {
        Builder builder = new AutoValue_Model.Builder();
        Builder returned = (Builder) builder.modelName("Alpha").modelName("Beta");
        Assertions.assertSame(
            (Object) builder,
            (Object) returned,
            "modelName should return the same Builder instance (support chaining)"
        );
        // Test only through building, not via direct access
        Model model = builder.build();
        Assertions.assertEquals(
            (Optional<String>) Optional.of("Beta"),
            (Optional<String>) model.modelName(),
            "The last value should be set in built Model.modelName"
        );
    }
    // Scenario 5: Ensuring initial modelName is Optional.empty()
    @Test
    @Tag("boundary")
    public void testModelNameInitialIsEmpty() {
        Builder builder = new AutoValue_Model.Builder();
        // Cannot access private builder.modelName; build model to check
        Model model = builder.build();
        Assertions.assertEquals(
            (Optional<String>) Optional.empty(),
            (Optional<String>) model.modelName(),
            "Initial built Model.modelName should be Optional.empty()"
        );
    }
    // Scenario 6: Overwriting previously set modelName
    @Test
    @Tag("valid")
    public void testModelNameOverridesPreviousValue() {
        Builder builder = new AutoValue_Model.Builder();
        builder.modelName("First");
        builder.modelName("Second");
        // Only test through building as builder fields are private
        Model model = builder.build();
        Assertions.assertEquals(
            (Optional<String>) Optional.of("Second"),
            (Optional<String>) model.modelName(),
            "Built Model.modelName should be overwritten with the last value"
        );
    }
    // Scenario 7: Building the Model after setting modelName
    @Test
    @Tag("integration")
    public void testBuildAssignsModelNameCorrectly() {
        Builder builder = new AutoValue_Model.Builder();
        builder.modelName("FinalName");
        Model model = builder.build(); // build() returns a Model instance
        Assertions.assertEquals(
            (Optional<String>) Optional.of("FinalName"),
            (Optional<String>) model.modelName(),
            "Built Model.modelName should reflect the set value"
        );
    }
    // Scenario 8: Setting modelName with special characters
    @Test
    @Tag("boundary")
    public void testModelNameHandlesSpecialCharacters() {
        Builder builder = new AutoValue_Model.Builder();
        String specialName = "Mödel#42 @2024";
        builder.modelName(specialName);
        // Only test through built Model
        Model model = builder.build();
        Assertions.assertEquals(
            (Optional<String>) Optional.of(specialName),
