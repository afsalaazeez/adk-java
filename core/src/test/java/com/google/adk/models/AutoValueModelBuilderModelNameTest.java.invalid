package com.google.adk.models;import java.util.Optional;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import javax.annotation.processing.Generated;
import com.google.adk.models.Model;
import com.google.adk.models.AutoValue_Model;
import org.junit.jupiter.api.*;

// Assuming Model, AutoValue_Model, and Model.Builder are accessible and correctly imported.
public class AutoValueModelBuilderModelNameTest {
    // Helper method to access the builder for testing
    private AutoValue_Model.Builder newBuilder() {
        return new AutoValue_Model.Builder();
    }
    @Test
    @Tag("valid")
    public void testModelNameSetsValidString() {
        // Arrange
        AutoValue_Model.Builder builder = newBuilder();
        String modelName = "OpenAI"; // TODO: Change to required model name if specification changes
        // Act
        builder.modelName(modelName);
        // Assert
        Model model = builder.build();
        assertEquals((Optional<String>) Optional.of(modelName), (Optional<String>) model.modelName());
    }
    @Test
    @Tag("invalid")
    public void testModelNameThrowsExceptionOnNullInput() {
        // Arrange
        AutoValue_Model.Builder builder = newBuilder();
        // Act & Assert
        assertThrows(NullPointerException.class, () -> {
            builder.modelName(null);
        });
    }
    @Test
    @Tag("boundary")
    public void testModelNameAcceptsEmptyString() {
        // Arrange
        AutoValue_Model.Builder builder = newBuilder();
        // Act
        builder.modelName("");
        // Assert
        Model model = builder.build();
        assertEquals((Optional<String>) Optional.of(""), (Optional<String>) model.modelName());
    }
    @Test
    @Tag("valid")
    public void testModelNameAllowsFluentChaining() {
        // Arrange
        AutoValue_Model.Builder builder = newBuilder();
        // Act
        AutoValue_Model.Builder result = builder.modelName("Alpha").modelName("Beta");
        // Assert
        assertSame(builder, result, "modelName should return the same builder instance for chaining");
        Model model = builder.build();
        assertEquals((Optional<String>) Optional.of("Beta"), (Optional<String>) model.modelName());
    }
    @Test
    @Tag("boundary")
    public void testModelNameInitialIsEmpty() {
        // Arrange
        AutoValue_Model.Builder builder = newBuilder();
        // Act & Assert
        Model model = builder.build();
        assertEquals((Optional<String>) Optional.empty(), (Optional<String>) model.modelName());
    }
    @Test
    @Tag("valid")
    public void testModelNameOverridesPreviousValue() {
        // Arrange
        AutoValue_Model.Builder builder = newBuilder();
        // Act
        builder.modelName("First");
        builder.modelName("Second");
        // Assert
        Model model = builder.build();
        assertEquals((Optional<String>) Optional.of("Second"), (Optional<String>) model.modelName());
    }
    @Test
    @Tag("integration")
    public void testBuildAssignsModelNameCorrectly() {
        // Arrange
        AutoValue_Model.Builder builder = newBuilder();
        // Act
        builder.modelName("FinalName");
        Model model = builder.build();
        // Assert
        assertEquals((Optional<String>) Optional.of("FinalName"), (Optional<String>) model.modelName());
    }
    @Test
