    @Test
    @Tag("valid")
    void closeConcurrentlyFromMultipleThreads() throws Exception {
        CompletableFuture<AsyncSession> sessionFuture = new CompletableFuture<>();
        when(mockLive.connect(eq(MODEL_NAME), any(LiveConnectConfig.class))).thenReturn(sessionFuture);
        when(mockSession.receive(any())).thenReturn(CompletableFuture.completedFuture(null));
        when(mockSession.close()).thenReturn(CompletableFuture.completedFuture(null));
        GeminiLlmConnection connection = new GeminiLlmConnection(mockClient, MODEL_NAME, mockConnectConfig);
        sessionFuture.complete(mockSession);
        Thread.sleep(100);
        TestSubscriber<LlmResponse> testSubscriber = connection.receive().test();
        int threadCount = 10;
        CountDownLatch startLatch = new CountDownLatch(1);
        CountDownLatch doneLatch = new CountDownLatch(threadCount);
        AtomicInteger exceptionCount = new AtomicInteger(0);
        ExecutorService executor = Executors.newFixedThreadPool(threadCount);
        for (int i = 0; i < threadCount; i++) {
            executor.submit(() -> {
                try {
                    startLatch.await();
                    connection.close();
                } catch (Exception e) {
                    exceptionCount.incrementAndGet();
                } finally {
                    doneLatch.countDown();
                }
            });
        }
        startLatch.countDown();
        doneLatch.await(5, TimeUnit.SECONDS);
        executor.shutdown();
        testSubscriber.awaitDone(1, TimeUnit.SECONDS);
        testSubscriber.assertComplete();
        testSubscriber.assertNoErrors();
        assertThat(exceptionCount.get()).isEqualTo(0);
        assertThat(testSubscriber.completions()).isEqualTo(1);
    }
