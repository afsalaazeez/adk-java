        Part original = Part.builder().functionResponse(Optional.of(fr)).build();
        List<Part> list = new ArrayList<>(Collections.singleton(original));
        Content content = Content.builder().parts(Optional.of(ImmutableList.copyOf(list))).build();
        Completable toolExpected = Completable.complete();
        Completable clientExpected = Completable.complete();
        doReturn(toolExpected).when(connection).sendToolResponseInternal(any());
        doReturn(clientExpected).when(connection).sendClientContentInternal(any());
        Completable result1 = connection.sendContent(content);
        assertSame((Completable) toolExpected, (Completable) result1, "First call uses tool response");
        Part plainPart = Part.builder().build();
        List<Part> mutatedList = new ArrayList<>(list);
        mutatedList.add(plainPart);
        Content mutatedContent = Content.builder().parts(Optional.of(ImmutableList.copyOf(mutatedList))).build();
        Completable result2 = connection.sendContent(mutatedContent);
        assertSame((Completable) clientExpected, (Completable) result2, "After mutation, falls back to client content");
    }
    @Test
    @Tag("boundary")
    void sendContentHandlesMissingPartsField() {
        Content content = Content.builder().parts(Optional.empty()).build();
        Completable expected = Completable.complete();
        doReturn(expected).when(connection).sendClientContentInternal(any());
        Completable actual = connection.sendContent(content);
        assertSame((Completable) expected, (Completable) actual, "Missing parts field should go to client content internal");
    }
    @Test
    @Tag("integration")
    void sendContentHandlesSessionNotCompleted() throws Exception {
        Content content = Content.builder().parts(Optional.empty()).build();
        Completable returned = Completable.complete();
        doReturn(returned).when(connection).sendClientContentInternal(any());
        Completable actual = connection.sendContent(content);
        assertSame((Completable) returned, (Completable) actual, "Should return a Completable even if session not completed");
    }
    // -- Utility for setting private/final fields (reflection, test only) --
    static class TestUtil {
        static void setFinalField(Object target, String fieldName, Object value) {
            try {
                java.lang.reflect.Field f = target.getClass().getDeclaredField(fieldName);
                f.setAccessible(true);
                f.set(target, value);
            } catch (Exception e) {
                throw new RuntimeException(e);
            }
        }
    }
}