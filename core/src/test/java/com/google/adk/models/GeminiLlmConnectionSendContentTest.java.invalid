    @Test
    @Tag("valid")
    void sendContentMaintainsFunctionResponseOrderWhenExtracted() {
        geminiLlmConnection = createConnectionWithMockedSession();
        
        FunctionResponse response1 = FunctionResponse.builder()
            .name("function1")
            .response(ImmutableList.of())
            .build();
        FunctionResponse response2 = FunctionResponse.builder()
            .name("function2")
            .response(ImmutableList.of())
            .build();
        FunctionResponse response3 = FunctionResponse.builder()
            .name("function3")
            .response(ImmutableList.of())
            .build();
        
        Part part1 = Part.builder().functionResponse(response1).build();
        Part part2 = Part.builder().functionResponse(response2).build();
        Part part3 = Part.builder().functionResponse(response3).build();
        
        Content content = Content.builder()
            .parts(ImmutableList.of(part1, part2, part3))
            .build();
        
        when(mockAsyncSession.sendToolResponse(any(LiveSendToolResponseParameters.class)))
            .thenReturn(CompletableFuture.completedFuture(null));
        
        Completable result = geminiLlmConnection.sendContent(content);
        TestObserver<Void> testObserver = result.test();
        
        testObserver.awaitTerminalEvent();
        testObserver.assertComplete();
        
        ArgumentCaptor<LiveSendToolResponseParameters> captor = 
            ArgumentCaptor.forClass(LiveSendToolResponseParameters.class);
        verify(mockAsyncSession, times(1)).sendToolResponse(captor.capture());
        
        LiveSendToolResponseParameters params = captor.getValue();
        assertTrue(params.functionResponses().isPresent());
        List<FunctionResponse> responses = params.functionResponses().get();
        assertEquals(3, responses.size());
        assertEquals("function1", responses.get(0).name());
        assertEquals("function2", responses.get(1).name());
        assertEquals("function3", responses.get(2).name());
    }
