    private LiveConnectConfig connectConfig;
    private GeminiLlmConnection geminiLlmConnection;
    @BeforeEach
    void setUp() {
        modelName = "test-model";
        connectConfig = LiveConnectConfig.builder().build();
        
        when(mockClient.async()).thenReturn(mockAsync);
        when(mockAsync.live()).thenReturn(mockLive);
    }
    private GeminiLlmConnection createConnectionWithMockedSession() {
        CompletableFuture<AsyncSession> sessionFuture = CompletableFuture.completedFuture(mockAsyncSession);
        when(mockLive.connect(eq(modelName), eq(connectConfig))).thenReturn(sessionFuture);
        
        GeminiLlmConnection connection = new GeminiLlmConnection(mockClient, modelName, connectConfig);
        
        try {
            Thread.sleep(100);
        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
        }
        
        return connection;
    }
    @Test
    @Tag("invalid")
    void sendContentWithNullContentThrowsNullPointerException() {
        geminiLlmConnection = createConnectionWithMockedSession();
        
        NullPointerException exception = assertThrows(NullPointerException.class, () -> {
            geminiLlmConnection.sendContent(null);
        });
        
        assertEquals("content cannot be null", exception.getMessage());
    }
    @Test
    @Tag("valid")
    void sendContentWithFunctionResponsesCallsSendToolResponseInternal() {
        geminiLlmConnection = createConnectionWithMockedSession();
        
        FunctionResponse functionResponse1 = FunctionResponse.builder()
            .name("function1")
            .response(ImmutableList.of())
            .build();
        FunctionResponse functionResponse2 = FunctionResponse.builder()
            .name("function2")
            .response(ImmutableList.of())
            .build();
        
        Part part1 = Part.builder().functionResponse(functionResponse1).build();
        Part part2 = Part.builder().functionResponse(functionResponse2).build();
        
        Content content = Content.builder()
            .parts(ImmutableList.of(part1, part2))
            .build();
        
        when(mockAsyncSession.sendToolResponse(any(LiveSendToolResponseParameters.class)))
            .thenReturn(CompletableFuture.completedFuture(null));
        
        Completable result = geminiLlmConnection.sendContent(content);
        TestObserver<Void> testObserver = result.test();
        
        testObserver.awaitTerminalEvent();
        testObserver.assertComplete();
        testObserver.assertNoErrors();
        
        verify(mockAsyncSession, times(1)).sendToolResponse(any(LiveSendToolResponseParameters.class));
        verify(mockAsyncSession, never()).sendClientContent(any(LiveSendClientContentParameters.class));
    }
