            .build();
        
        Part part = Part.builder().functionResponse(functionResponse).build();
        Content content = Content.builder()
            .parts(ImmutableList.of(part))
            .build();
        
        RuntimeException testException = new RuntimeException("Send tool response failed");
        CompletableFuture<Void> failedFuture = new CompletableFuture<>();
        failedFuture.completeExceptionally(testException);
        
        when(mockAsyncSession.sendToolResponse(any(LiveSendToolResponseParameters.class)))
            .thenReturn(failedFuture);
        
        Completable result = geminiLlmConnection.sendContent(content);
        TestObserver<Void> testObserver = result.test();
        
        testObserver.awaitTerminalEvent();
        testObserver.assertError(throwable -> {
            Throwable cause = throwable instanceof CompletionException ? throwable.getCause() : throwable;
            return cause instanceof RuntimeException && 
                   cause.getMessage().equals("Send tool response failed");
        });
        
        verify(mockAsyncSession, times(1)).sendToolResponse(any(LiveSendToolResponseParameters.class));
    }
    @Test
    @Tag("valid")
    void sendContentWithMultipleFunctionResponsesCallsSendToolResponseInternal() {
        geminiLlmConnection = createConnectionWithMockedSession();
        
        FunctionResponse functionResponse1 = FunctionResponse.builder()
            .name("function1")
            .response(ImmutableList.of())
            .build();
        FunctionResponse functionResponse2 = FunctionResponse.builder()
            .name("function2")
            .response(ImmutableList.of())
            .build();
        FunctionResponse functionResponse3 = FunctionResponse.builder()
            .name("function3")
            .response(ImmutableList.of())
            .build();
        
        Part part1 = Part.builder().functionResponse(functionResponse1).build();
        Part part2 = Part.builder().functionResponse(functionResponse2).build();
        Part part3 = Part.builder().functionResponse(functionResponse3).build();
        
        Content content = Content.builder()
            .parts(ImmutableList.of(part1, part2, part3))
            .build();
        
        when(mockAsyncSession.sendToolResponse(any(LiveSendToolResponseParameters.class)))
            .thenReturn(CompletableFuture.completedFuture(null));
        
        Completable result = geminiLlmConnection.sendContent(content);
        TestObserver<Void> testObserver = result.test();
        
        testObserver.awaitTerminalEvent();
        testObserver.assertComplete();
        testObserver.assertNoErrors();
        
        ArgumentCaptor<LiveSendToolResponseParameters> captor = 
            ArgumentCaptor.forClass(LiveSendToolResponseParameters.class);
        verify(mockAsyncSession, times(1)).sendToolResponse(captor.capture());
        
        LiveSendToolResponseParameters params = captor.getValue();
        assertTrue(params.functionResponses().isPresent());
        assertEquals(3, params.functionResponses().get().size());
        
        verify(mockAsyncSession, never()).sendClientContent(any(LiveSendClientContentParameters.class));
    }
