        Part p2 = Part.builder().functionResponse(Optional.of(fr2)).build();
        Content content = Content.builder().parts(Optional.of(ImmutableList.of(p1, p2))).build();
        ArgumentCaptor<LiveSendToolResponseParameters> paramCaptor = ArgumentCaptor.forClass(LiveSendToolResponseParameters.class);
        Completable expected = Completable.complete();
