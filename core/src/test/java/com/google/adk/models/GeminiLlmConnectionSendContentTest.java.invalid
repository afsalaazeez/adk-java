    private GeminiLlmConnection createConnectionWithMockedSession() {
        Client.AsyncClient asyncClient = mock(Client.AsyncClient.class);
        when(mockApiClient.async).thenReturn(asyncClient);
        when(asyncClient.live).thenReturn(mockAsyncLive);
        when(mockAsyncLive.connect(any(String.class), any(LiveConnectConfig.class)))
                .thenReturn(CompletableFuture.completedFuture(mockAsyncSession));
        when(mockAsyncSession.receive(any())).thenReturn(CompletableFuture.completedFuture(null));
        
        return new GeminiLlmConnection(mockApiClient, MODEL_NAME, connectConfig);
    }
    @Test
    @Tag("invalid")
    void sendContentWithNullContentThrowsNullPointerException() {
        GeminiLlmConnection connection = createConnectionWithMockedSession();
        NullPointerException exception = assertThrows(NullPointerException.class, 
                () -> connection.sendContent(null));
        assertThat(exception.getMessage()).isEqualTo("content cannot be null");
    }
    @Test
    @Tag("valid")
    void sendContentWithFunctionResponsesCallsSendToolResponse() {
        GeminiLlmConnection connection = createConnectionWithMockedSession();
        
        FunctionResponse functionResponse = FunctionResponse.builder()
                .name("testFunction")
                .response(Map.of("result", "success"))
                .build();
        Part functionResponsePart = Part.builder()
                .functionResponse(functionResponse)
                .build();
        Content content = Content.builder()
                .parts(ImmutableList.of(functionResponsePart))
                .build();
        when(mockAsyncSession.sendToolResponse(any(LiveSendToolResponseParameters.class)))
                .thenReturn(CompletableFuture.completedFuture(null));
        Completable result = connection.sendContent(content);
        result.blockingAwait();
        ArgumentCaptor<LiveSendToolResponseParameters> captor = 
                ArgumentCaptor.forClass(LiveSendToolResponseParameters.class);
        verify(mockAsyncSession).sendToolResponse(captor.capture());
        
        LiveSendToolResponseParameters capturedParams = captor.getValue();
        assertThat(capturedParams.functionResponses()).isPresent();
        assertThat(capturedParams.functionResponses().get()).hasSize(1);
    }
    @Test
    @Tag("valid")
    void sendContentWithTextPartsCallsSendClientContent() {
