    @BeforeEach
    void setUp() {
        MockitoAnnotations.openMocks(this);
        // Prepare for Client.async/live/connect chain, due to the constructor signature.
        // Client.async and live are public fields, so we must mock "live" and "async" as fields.
        // - see business logic: this.apiClient.async.live.connect(this.modelName, this.connectConfig)
        // So, set-up custom mocks to simulate: mockClient.async.live.connect(...)
        // Prepare live mock object (must match type on Client.Async)
        // Here, "mockClient.async" and "mockClient.async.live" must be fields.
        // Since mockito cannot mock fields but only methods, use custom override instance.
        final class LiveMock {
            public CompletableFuture<AsyncSession> connect(String modelName, LiveConnectConfig connectConfig) {
                return sessionFuture;
            }
        }
        final class AsyncMock {
            public LiveMock live = new LiveMock();
        }
        // Assign a real mock client and forcibly attach async/live field objects to it.
        mockClient = mock(Client.class);
        sessionFuture = new CompletableFuture<>();
        AsyncMock asyncMock = new AsyncMock();
        // Set public field 'async' as 'asyncMock'
        TestUtil.setFinalField(mockClient, "async", asyncMock);
        connection = spy(new GeminiLlmConnection(mockClient, "test-model", mockLiveConnectConfig));
        TestUtil.setFinalField(connection, "sessionFuture", sessionFuture);
    }
