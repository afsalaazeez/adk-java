    @Test
    @Tag("valid")
    void convertServerMessageWithToolCallAndSingleFunctionCall() {
        FunctionCall functionCall = FunctionCall.builder()
                .name("singleFunction")
                .id("id1")
                .build();
        
        LiveServerToolCall toolCall = mock(LiveServerToolCall.class);
        when(toolCall.functionCalls()).thenReturn(Optional.of(ImmutableList.of(functionCall)));
        
        LiveServerMessage message = mock(LiveServerMessage.class);
        when(message.serverContent()).thenReturn(Optional.empty());
        when(message.toolCall()).thenReturn(Optional.of(toolCall));
        when(message.usageMetadata()).thenReturn(Optional.empty());
        when(message.toolCallCancellation()).thenReturn(Optional.empty());
        when(message.setupComplete()).thenReturn(Optional.empty());
        
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        
        assertTrue(result.isPresent());
        LlmResponse response = result.get();
        assertTrue(response.content().isPresent());
        Content content = response.content().get();
        assertTrue(content.parts().isPresent());
        assertEquals(1, content.parts().get().size());
        assertTrue(content.parts().get().get(0).functionCall().isPresent());
        assertEquals("singleFunction", content.parts().get().get(0).functionCall().get().name());
        assertTrue(response.partial().isPresent());
        assertFalse(response.partial().get());
        assertTrue(response.turnComplete().isPresent());
        assertFalse(response.turnComplete().get());
    }
    @Test
    @Tag("boundary")
    void convertServerMessagePriorityWithServerContentOverToolCall() {
        Content modelTurnContent = Content.builder()
                .parts(ImmutableList.of(Part.builder().text("Server content priority").build()))
                .build();
        
        LiveServerContent serverContent = mock(LiveServerContent.class);
        when(serverContent.modelTurn()).thenReturn(Optional.of(modelTurnContent));
        when(serverContent.turnComplete()).thenReturn(Optional.of(true));
        when(serverContent.interrupted()).thenReturn(Optional.of(false));
        
        FunctionCall functionCall = FunctionCall.builder()
                .name("function")
                .id("id1")
                .build();
        LiveServerToolCall toolCall = mock(LiveServerToolCall.class);
        when(toolCall.functionCalls()).thenReturn(Optional.of(ImmutableList.of(functionCall)));
        
        LiveServerMessage message = mock(LiveServerMessage.class);
        when(message.serverContent()).thenReturn(Optional.of(serverContent));
        when(message.toolCall()).thenReturn(Optional.of(toolCall));
        when(message.usageMetadata()).thenReturn(Optional.empty());
        when(message.toolCallCancellation()).thenReturn(Optional.empty());
        when(message.setupComplete()).thenReturn(Optional.empty());
        
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        
        assertTrue(result.isPresent());
        LlmResponse response = result.get();
        assertTrue(response.content().isPresent());
        assertEquals(modelTurnContent, response.content().get());
        assertTrue(response.turnComplete().isPresent());
        assertTrue(response.turnComplete().get());
    }
    @Test
    @Tag("boundary")
    void convertServerMessageWithServerContentMissingAllOptionalFields() {
        LiveServerContent serverContent = mock(LiveServerContent.class);
        when(serverContent.modelTurn()).thenReturn(Optional.empty());
        when(serverContent.turnComplete()).thenReturn(Optional.empty());
        when(serverContent.interrupted()).thenReturn(Optional.of(false));
        
        LiveServerMessage message = mock(LiveServerMessage.class);
        when(message.serverContent()).thenReturn(Optional.of(serverContent));
        when(message.toolCall()).thenReturn(Optional.empty());
        when(message.usageMetadata()).thenReturn(Optional.empty());
        when(message.toolCallCancellation()).thenReturn(Optional.empty());
        when(message.setupComplete()).thenReturn(Optional.empty());
        
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        
        assertTrue(result.isPresent());
        LlmResponse response = result.get();
        assertFalse(response.content().isPresent());
        assertTrue(response.partial().isPresent());
        assertFalse(response.partial().get());
        assertTrue(response.turnComplete().isPresent());
        assertFalse(response.turnComplete().get());
        assertTrue(response.interrupted().isPresent());
        assertFalse(response.interrupted().get());
    }
