    @Test
    @Tag("invalid")
    void convertServerMessageWithUnknownOrEmptyContent() {
        LiveServerMessage message = mock(LiveServerMessage.class);
        when(message.serverContent()).thenReturn(Optional.empty());
        when(message.toolCall()).thenReturn(Optional.empty());
        when(message.usageMetadata()).thenReturn(Optional.empty());
        when(message.toolCallCancellation()).thenReturn(Optional.empty());
        when(message.setupComplete()).thenReturn(Optional.empty());
        when(message.toJson()).thenReturn("{}");
        
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        
        assertTrue(result.isPresent());
        LlmResponse response = result.get();
        assertTrue(response.errorCode().isPresent());
        assertEquals("Unknown server message.", response.errorCode().get().toString());
        assertTrue(response.errorMessage().isPresent());
        assertEquals("Received unknown server message.", response.errorMessage().get());
    }
    @Test
    @Tag("valid")
    void convertServerMessageWithServerContentAndAllFieldsPresent() {
        Content modelTurnContent = Content.builder()
                .parts(ImmutableList.of(Part.builder().text("Complete response").build()))
                .build();
        
        LiveServerContent serverContent = mock(LiveServerContent.class);
        when(serverContent.modelTurn()).thenReturn(Optional.of(modelTurnContent));
        when(serverContent.turnComplete()).thenReturn(Optional.of(true));
        when(serverContent.interrupted()).thenReturn(Optional.of(true));
        
        LiveServerMessage message = mock(LiveServerMessage.class);
        when(message.serverContent()).thenReturn(Optional.of(serverContent));
        when(message.toolCall()).thenReturn(Optional.empty());
        when(message.usageMetadata()).thenReturn(Optional.empty());
        when(message.toolCallCancellation()).thenReturn(Optional.empty());
        when(message.setupComplete()).thenReturn(Optional.empty());
        
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        
        assertTrue(result.isPresent());
        LlmResponse response = result.get();
        assertTrue(response.content().isPresent());
        assertEquals(modelTurnContent, response.content().get());
        assertTrue(response.partial().isPresent());
        assertFalse(response.partial().get());
        assertTrue(response.turnComplete().isPresent());
        assertTrue(response.turnComplete().get());
        assertTrue(response.interrupted().isPresent());
        assertTrue(response.interrupted().get());
    }
