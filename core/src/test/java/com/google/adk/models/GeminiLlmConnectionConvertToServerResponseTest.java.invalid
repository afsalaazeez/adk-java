        assertFalse(ret.get().content().isPresent());
    }
    // SCENARIO 17
    @Test
    @Tag("valid")
    public void testToolCallFunctionCallsMapToExpectedContentStructure() {
        LiveServerMessage message = mock(LiveServerMessage.class);
        LiveServerToolCall toolCall = mock(LiveServerToolCall.class);
        FunctionCall funcCall1 = mock(FunctionCall.class);
        FunctionCall funcCall2 = mock(FunctionCall.class);
        FunctionCall funcCall3 = mock(FunctionCall.class);
        List<FunctionCall> funcCalls = ImmutableList.of(funcCall1, funcCall2, funcCall3);
        when(message.serverContent()).thenReturn(Optional.empty());
        when(message.toolCall()).thenReturn(Optional.of(toolCall));
        when(toolCall.functionCalls()).thenReturn(Optional.of(funcCalls));
        Optional<LlmResponse> ret = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue(ret.isPresent());
        LlmResponse resp = ret.get();
        Content content = resp.content().orElse(null);
        assertNotNull(content);
        List<Part> parts = content.parts().orElse(ImmutableList.of());
        assertEquals(3, parts.size());
        assertEquals(funcCall1, parts.get(0).functionCall().orElse(null));
        assertEquals(funcCall2, parts.get(1).functionCall().orElse(null));
        assertEquals(funcCall3, parts.get(2).functionCall().orElse(null));
    }
    // SCENARIO 18
    @Test
    @Tag("integration")
    public void testLoggingOccursForSpecialControlMessages() {
        LiveServerMessage usageMsg = mock(LiveServerMessage.class);
        GenerateContentResponseUsageMetadata usageMeta = mock(GenerateContentResponseUsageMetadata.class);
        when(usageMsg.serverContent()).thenReturn(Optional.empty());
        when(usageMsg.toolCall()).thenReturn(Optional.empty());
        when(usageMsg.usageMetadata()).thenReturn(Optional.of(usageMeta));
        Optional<LlmResponse> r1 = GeminiLlmConnection.convertToServerResponse(usageMsg);
        assertFalse(r1.isPresent());
        LiveServerMessage toolCancelMsg = mock(LiveServerMessage.class);
        when(toolCancelMsg.serverContent()).thenReturn(Optional.empty());
        when(toolCancelMsg.toolCall()).thenReturn(Optional.empty());
        when(toolCancelMsg.usageMetadata()).thenReturn(Optional.empty());
        Object toolCallCancel = mock(Object.class); // Can be any type
        when(toolCancelMsg.toolCallCancellation()).thenReturn(Optional.of(toolCallCancel));
        Optional<LlmResponse> r2 = GeminiLlmConnection.convertToServerResponse(toolCancelMsg);
        assertFalse(r2.isPresent());
        LiveServerMessage setupCompleteMsg = mock(LiveServerMessage.class);
        when(setupCompleteMsg.serverContent()).thenReturn(Optional.empty());
        when(setupCompleteMsg.toolCall()).thenReturn(Optional.empty());
        when(setupCompleteMsg.usageMetadata()).thenReturn(Optional.empty());
        when(setupCompleteMsg.toolCallCancellation()).thenReturn(Optional.empty());
        Object setupCompleteVal = mock(Object.class); // Can be any type
        when(setupCompleteMsg.setupComplete()).thenReturn(Optional.of(setupCompleteVal));
        Optional<LlmResponse> r3 = GeminiLlmConnection.convertToServerResponse(setupCompleteMsg);
        assertFalse(r3.isPresent());
    }
