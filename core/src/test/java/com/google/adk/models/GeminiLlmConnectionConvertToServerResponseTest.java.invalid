    // SCENARIO 1
    @Test
    @Tag("valid")
    public void testServerContentPresentAllFieldsFilled() {
        LiveServerMessage message = mock(LiveServerMessage.class);
        LiveServerContent serverContent = mock(LiveServerContent.class);
        Content modelTurnContent = Content.builder().build();
        when(message.serverContent()).thenReturn(Optional.of(serverContent));
        when(serverContent.modelTurn()).thenReturn(Optional.of(modelTurnContent));
        when(serverContent.turnComplete()).thenReturn(Optional.of(Boolean.TRUE));
        // Solution: interrupted() is boolean, not Boolean
        when(serverContent.interrupted()).thenReturn(true);
        Optional<LlmResponse> responseOpt = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue(responseOpt.isPresent());
        LlmResponse response = responseOpt.get();
        assertEquals(modelTurnContent, response.content().orElse(null));
        assertEquals((Boolean) false, response.partial().orElse(null)); // partial = !turnComplete (turnComplete true)
        assertEquals((Boolean) true, response.turnComplete().orElse(null));
        assertEquals((Boolean) true, response.interrupted().orElse(null));
    }
