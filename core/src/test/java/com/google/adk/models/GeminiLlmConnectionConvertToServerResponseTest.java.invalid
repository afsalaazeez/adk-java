    @Tag("valid")
    void convertServerMessageWithToolCallCancellation() {
        LiveServerMessage message = mock(LiveServerMessage.class);
        when(message.serverContent()).thenReturn(Optional.empty());
        when(message.toolCall()).thenReturn(Optional.empty());
        when(message.usageMetadata()).thenReturn(Optional.empty());
        when(message.toolCallCancellation()).thenReturn(Optional.of(mock(Object.class)));
        when(message.setupComplete()).thenReturn(Optional.empty());
        
        Optional<LlmResponse> result = GeminiLlmConnection.convertToServerResponse(message);
        
        assertFalse(result.isPresent());
    }
