    @Test
    @Tag("invalid")
    public void testHandlesExceptionThrownByToJsonInUnknownFieldHandling() {
        LiveServerMessage msg = mock(LiveServerMessage.class);
        when(msg.serverContent()).thenReturn(Optional.empty());
        when(msg.toolCall()).thenReturn(Optional.empty());
        when(msg.usageMetadata()).thenReturn(Optional.empty());
        when(msg.toolCallCancellation()).thenReturn(Optional.empty());
        when(msg.setupComplete()).thenReturn(Optional.empty());
        when(msg.toJson()).thenThrow(new RuntimeException("json fail"));
        Optional<LlmResponse> ret = GeminiLlmConnection.convertToServerResponse(msg);
        assertTrue(ret.isPresent());
        LlmResponse res = ret.get();
        assertTrue(res.errorCode().isPresent());
        assertTrue(res.errorMessage().isPresent());
    }
    // SCENARIO 20
    @Test
    @Tag("boundary")
    public void testPartialAndCompleteConflictResolvesProperly() {
        LiveServerMessage msg = mock(LiveServerMessage.class);
        LiveServerContent content = mock(LiveServerContent.class);
        when(msg.serverContent()).thenReturn(Optional.of(content));
        when(content.turnComplete()).thenReturn(Optional.of(Boolean.FALSE)); // last invocation is false
        when(content.interrupted()).thenReturn(false);
        Optional<LlmResponse> ret = GeminiLlmConnection.convertToServerResponse(msg);
        assertTrue(ret.isPresent());
        LlmResponse resp = ret.get();
        assertEquals((Boolean) true, resp.partial().orElse(null));
        assertEquals((Boolean) false, resp.turnComplete().orElse(null));
    }
