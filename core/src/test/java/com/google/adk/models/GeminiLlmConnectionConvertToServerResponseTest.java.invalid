    @Test
    @Tag("valid")
    public void testToolCallWithFunctionCallsPresent() {
        FunctionCall call = mock(FunctionCall.class);
        List<FunctionCall> calls = Collections.singletonList(call);
        LiveServerToolCall toolCall = mock(LiveServerToolCall.class);
        when(toolCall.functionCalls()).thenReturn(Optional.of(calls));
        LiveServerMessage message = mock(LiveServerMessage.class);
        when(message.serverContent()).thenReturn(Optional.empty());
        when(message.toolCall()).thenReturn(Optional.of(toolCall));
        when(message.usageMetadata()).thenReturn(Optional.empty());
        when(message.toolCallCancellation()).thenReturn(Optional.empty());
        when(message.setupComplete()).thenReturn(Optional.empty());
        Optional<LlmResponse> opt = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue(opt.isPresent());
        LlmResponse resp = opt.get();
        assertTrue(resp.content().isPresent());
        Content content = resp.content().get();
        List<Part> parts = content.parts().orElse(ImmutableList.of());
        assertEquals(1, parts.size());
        assertEquals(call, parts.get(0).functionCall().orElse(null));
        assertEquals((Optional<Boolean>) Optional.of(false), resp.partial());
        assertEquals((Optional<Boolean>) Optional.of(false), resp.turnComplete());
    }
