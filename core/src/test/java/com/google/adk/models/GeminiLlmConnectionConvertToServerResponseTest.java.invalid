    @Test
    @Tag("valid")
    public void testToolCallPresentWithFunctionCalls() {
        LiveServerMessage message = mock(LiveServerMessage.class);
        LiveServerToolCall toolCall = mock(LiveServerToolCall.class);
        FunctionCall funcCall1 = mock(FunctionCall.class);
        FunctionCall funcCall2 = mock(FunctionCall.class);
        List<FunctionCall> funcCalls = ImmutableList.of(funcCall1, funcCall2);
        when(message.serverContent()).thenReturn(Optional.empty());
        when(message.toolCall()).thenReturn(Optional.of(toolCall));
        when(toolCall.functionCalls()).thenReturn(Optional.of(funcCalls));
        Optional<LlmResponse> responseOpt = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue(responseOpt.isPresent());
        LlmResponse response = responseOpt.get();
        assertTrue(response.content().isPresent());
        Content content = response.content().get();
        assertTrue(content.parts().isPresent());
        List<Part> parts = content.parts().get();
        assertEquals(2, parts.size());
        assertEquals(funcCall1, parts.get(0).functionCall().orElse(null));
        assertEquals(funcCall2, parts.get(1).functionCall().orElse(null));
        assertEquals((Boolean) false, response.partial().orElse(true));
        assertEquals((Boolean) false, response.turnComplete().orElse(true));
    }
