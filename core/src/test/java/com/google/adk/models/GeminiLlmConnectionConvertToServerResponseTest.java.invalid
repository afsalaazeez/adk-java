class GeminiLlmConnectionConvertToServerResponseTest {
    @Test
    @Tag("valid")
    public void testServerContentWithModelTurnAndTurnComplete() {
        Content modelTurnContent = Content.builder().parts(ImmutableList.of()).build();
        LiveServerContent serverContent = mock(LiveServerContent.class);
        when(serverContent.modelTurn()).thenReturn(Optional.of(modelTurnContent));
        when(serverContent.turnComplete()).thenReturn(Optional.of(true));
        when(serverContent.interrupted()).thenReturn(false); // changed to Boolean, but should be primitive boolean
        LiveServerMessage message = mock(LiveServerMessage.class);
        when(message.serverContent()).thenReturn(Optional.of(serverContent));
        // Other fields should be empty
        when(message.toolCall()).thenReturn(Optional.empty());
        when(message.usageMetadata()).thenReturn(Optional.empty());
        when(message.toolCallCancellation()).thenReturn(Optional.empty());
        when(message.setupComplete()).thenReturn(Optional.empty());
        Optional<LlmResponse> opt = GeminiLlmConnection.convertToServerResponse(message);
        assertTrue(opt.isPresent());
        LlmResponse resp = opt.get();
        assertEquals((Optional<Content>) Optional.of(modelTurnContent), resp.content());
        assertEquals((Optional<Boolean>) Optional.of(false), resp.partial()); // partial = !turnComplete
        assertEquals((Optional<Boolean>) Optional.of(true), resp.turnComplete());
        assertEquals((Optional<Boolean>) Optional.of(false), resp.interrupted());
    }
