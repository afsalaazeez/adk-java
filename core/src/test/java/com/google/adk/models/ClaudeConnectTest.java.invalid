class ClaudeConnectTest extends BaseLlm {
    public ClaudeConnectTest() {
        super("test-model");
    }
    // Required by BaseLlm's abstract methods to allow this class to be concrete
    @Override
    public Flowable<LlmResponse> generateContent(LlmRequest llmRequest, boolean stream) {
        throw new UnsupportedOperationException();
    }
    @Override
    public BaseLlmConnection connect(LlmRequest llmRequest) {
        throw new UnsupportedOperationException("Live connection is not supported for Claude models.");
    }
    @Test
    @Tag("valid")
    @DisplayName("Connect throws UnsupportedOperationException for any LlmRequest")
    public void testConnectThrowsUnsupportedOperationForAnyLlmRequest() {
        AnthropicClient mockClient = mock(AnthropicClient.class);
        Claude claude = new Claude("test-model", mockClient);
        LlmRequest llmRequest = LlmRequest.builder()
                .model(Optional.of("test-model"))
                .contents(List.of(Content.builder().role("user").parts(List.of(
                        Part.builder().text("Hello!").build()
                )).build()))
                .tools(Map.of())
                .build();
        UnsupportedOperationException exception = assertThrows(
                UnsupportedOperationException.class,
                () -> claude.connect(llmRequest)
        );
        assertEquals("Live connection is not supported for Claude models.", (String)exception.getMessage());
    }
    @Test
    @Tag("invalid")
    @DisplayName("Connect throws UnsupportedOperationException when null LlmRequest is passed")
    public void testConnectThrowsUnsupportedOperationForNullLlmRequest() {
        AnthropicClient mockClient = mock(AnthropicClient.class);
        Claude claude = new Claude("test-model", mockClient);
        UnsupportedOperationException exception = assertThrows(
                UnsupportedOperationException.class,
                () -> claude.connect(null)
        );
        assertEquals("Live connection is not supported for Claude models.", (String)exception.getMessage());
    }
    @Test
