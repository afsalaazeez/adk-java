    @DisplayName("Connect throws UnsupportedOperationException for complex LlmRequest")
    public void testConnectThrowsUnsupportedOperationForComplexLlmRequest() {
        AnthropicClient mockClient = mock(AnthropicClient.class);
        Claude claude = new Claude("test-model", mockClient);
        GenerateContentConfig config = GenerateContentConfig.builder()
                .systemInstruction(Optional.of(Content.builder().role("system").parts(List.of(
                    Part.builder().text("System text").build(),
                    Part.builder().text("Additional instruction").build()
                )).build()))
                .build();
        LlmRequest llmRequest = LlmRequest.builder()
                .model(Optional.of("test-model"))
                .contents(List.of(
                        Content.builder().role("user").parts(List.of(
                                Part.builder().text("Edge case text").build(),
                                // FunctionCall is nullable, we'll pass null for demonstration or substitute with .build() if required by logic
                                Part.builder().functionCall((FunctionCall)null).build() 
                        )).build()
                ))
                .config(Optional.of(config))
                .tools(Map.of()) // Complex tools can be added here if needed
                .build();
        UnsupportedOperationException exception = assertThrows(
                UnsupportedOperationException.class,
                () -> claude.connect(llmRequest)
        );
        assertEquals("Live connection is not supported for Claude models.", (String)exception.getMessage());
    }
    @Test
    @Tag("boundary")
    @DisplayName("Connect throws UnsupportedOperationException regardless of Claude instance configuration")
    public void testConnectThrowsUnsupportedOperationRegardlessOfClaudeInstanceConfiguration() {
        AnthropicClient mockClient = mock(AnthropicClient.class);
        Claude claudeDefault = new Claude("test-model", mockClient);
        Claude claudeCustomTokens = new Claude("test-model", mockClient, 4096);
        LlmRequest llmRequest = LlmRequest.builder()
                .model(Optional.of("test-model"))
                .contents(List.of(Content.builder().role("user").parts(List.of(
                        Part.builder().text("Hello!").build()
                )).build()))
                .tools(Map.of())
                .build();
        UnsupportedOperationException exceptionDefault = assertThrows(
                UnsupportedOperationException.class,
                () -> claudeDefault.connect(llmRequest)
        );
        assertEquals("Live connection is not supported for Claude models.", (String)exceptionDefault.getMessage());
        UnsupportedOperationException exceptionCustomTokens = assertThrows(
                UnsupportedOperationException.class,
                () -> claudeCustomTokens.connect(llmRequest)
        );
        assertEquals("Live connection is not supported for Claude models.", (String)exceptionCustomTokens.getMessage());
    }
