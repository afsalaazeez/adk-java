    "@Test
private List<Event> runRunner(Runner runner, InvocationContext invocationContext) {
    Session session = invocationContext.session();
    
    RunConfig runConfig = RunConfig.builder().build();
    return runner.runAsync(session.userId(), session.id(), invocationContext.userContent().orElse(null), runConfig).toList().blockingGet();
}
