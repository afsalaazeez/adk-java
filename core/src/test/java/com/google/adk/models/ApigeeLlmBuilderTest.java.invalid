                .modelName(modelName)
                .proxyUrl(proxyUrl)
                .build();
        // Assert
        assertNotNull(apigeeLlm);
        assertNotNull(apigeeLlm.getHttpOptions());
        // When no version is specified, apiVersion should be empty or not set
        assertThat(apigeeLlm.getHttpOptions().apiVersion().orElse("")).isEmpty();
    }
