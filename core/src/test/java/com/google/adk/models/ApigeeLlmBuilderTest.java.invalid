    "@Test
public void prepareGenenerateContentRequest_withContentsAndConfig_appliesSanitizationAndEnsuresUserRole() {
    
    GenerateContentConfig config = GenerateContentConfig.builder().labels(ImmutableMap.of("key", "value")).build();
    
    
    Blob blobWithDisplayName = Blob.builder().mimeType("image/png").data("bytes".getBytes(UTF_8)).displayName("image1").build();
    Part inlineDataPart = Part.builder().inlineData(blobWithDisplayName).build();
    Content content1 = toContent(inlineDataPart);
    
    
    
    Content content2 = Content.builder().role("model").parts(ImmutableList.of()).build();
    LlmRequest request = LlmRequest.builder().contents(ImmutableList.of(content1, content2)).config(config).build();
    LlmRequest result = GeminiUtil.prepareGenenerateContentRequest(request, 
    true);
    
    assertThat(result.config()).isPresent();
    assertThat(result.config().get().labels().get()).isEmpty();
    
    Blob expectedBlob = Blob.builder().mimeType("image/png").data(blobWithDisplayName.data().get()).build();
    Part expectedInlineDataPart = Part.builder().inlineData(expectedBlob).build();
    Content expectedContent1 = toContent(expectedInlineDataPart);
    assertThat(result.contents()).containsExactly(expectedContent1, content2, CONTINUE_CONTENT).inOrder();
}
