    private static final String VALID_GEMINI_MODEL = "apigee/gemini/gemini-1.5-flash";
    private static final String VALID_VERTEX_AI_MODEL = "apigee/vertex_ai/gemini-1.5-flash";
    private static final String VALID_MODEL_WITH_VERSION = "apigee/v1beta/gemini-1.5-flash";
    private static final String VALID_VERTEX_AI_MODEL_WITH_VERSION = "apigee/vertex_ai/v1beta/gemini-1.5-flash";
    @Test
    @Tag("valid")
    void builderReturnsNewBuilderInstance() {
        // Arrange - No setup required
        // Act
        ApigeeLlm.Builder builder = ApigeeLlm.builder();
        // Assert
        assertNotNull(builder);
    }
    @Test
    @Tag("valid")
    void builderReturnsDistinctInstancesOnEachCall() {
        // Arrange - No setup required
        // Act
        ApigeeLlm.Builder builder1 = ApigeeLlm.builder();
        ApigeeLlm.Builder builder2 = ApigeeLlm.builder();
        // Assert
        assertThat(builder1).isNotSameInstanceAs(builder2);
    }
    @Test
    @Tag("valid")
    void builderSupportsMethodChaining() {
        // Arrange
        String modelName = VALID_SIMPLE_MODEL;
        String proxyUrl = VALID_PROXY_URL;
        // Act
        ApigeeLlm.Builder result = ApigeeLlm.builder()
                .modelName(modelName)
                .proxyUrl(proxyUrl);
        // Assert
        assertNotNull(result);
        assertThat(result).isInstanceOf(ApigeeLlm.Builder.class);
    }
    @Test
    @Tag("valid")
    void builderBuildsApigeeLlmWithValidModelAndProxyUrl() {
        // Arrange
        String modelName = VALID_SIMPLE_MODEL;
        String proxyUrl = VALID_PROXY_URL;
        // Act
        ApigeeLlm apigeeLlm = ApigeeLlm.builder()
                .modelName(modelName)
                .proxyUrl(proxyUrl)
                .build();
        // Assert
        assertNotNull(apigeeLlm);
    }
    @Test
    @Tag("valid")
    void builderBuildsApigeeLlmWithCustomHeaders() {
        // Arrange
        String modelName = VALID_VERTEX_AI_MODEL;
        String proxyUrl = VALID_PROXY_URL;
        Map<String, String> customHeaders = ImmutableMap.of("X-Custom-Header", "CustomValue");
        // Act
        ApigeeLlm apigeeLlm = ApigeeLlm.builder()
                .modelName(modelName)
                .proxyUrl(proxyUrl)
                .customHeaders(customHeaders)
                .build();
        // Assert
        assertNotNull(apigeeLlm);
        assertThat(apigeeLlm.getHttpOptions()).isNotNull();
        assertThat(apigeeLlm.getHttpOptions().headers().isPresent()).isTrue();
        assertThat(apigeeLlm.getHttpOptions().headers().get()).containsKey("X-Custom-Header");
    }
