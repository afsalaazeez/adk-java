    "@Test
public void processLlmRequestWithDeclarationAddsToolToConfig() {
    FunctionDeclaration functionDeclaration = FunctionDeclaration.builder().name("test_function").build();
    BaseTool tool = new BaseTool("test_tool", "test_description") {

