    Event event1 = Event.builder().id("event_id").invocationId("invocation_id").author("agent").timestamp(123456789L).build();
    Event event2 = Event.builder().id("event_id_2").invocationId("invocation_id").author("agent").timestamp(123456789L).build();
    ImmutableMap<Event, String> map = ImmutableMap.of(event1, "e1", event2, "e2");
