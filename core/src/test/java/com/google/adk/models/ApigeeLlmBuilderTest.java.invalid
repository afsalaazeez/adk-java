        assertThat(apigeeLlm.getHttpOptions().headers().isPresent()).isTrue();
        Map<String, String> headers = apigeeLlm.getHttpOptions().headers().get();
        assertThat(headers).containsKey("x-goog-api-client");
        assertThat(headers).containsKey("user-agent");
