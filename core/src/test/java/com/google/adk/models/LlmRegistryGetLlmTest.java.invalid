    @Test
    @Tag("integration")
    public void testOnlyOneInstanceCreatedUnderConcurrentAccess() throws InterruptedException {
        String pattern = "thread-model-.*";
        String modelName = "thread-model-concurrent";
        com.google.adk.models.LlmRegistry.LlmFactory factory = Mockito.mock(com.google.adk.models.LlmRegistry.LlmFactory.class);
        Mockito.when(factory.create(modelName)).thenReturn(new com.google.adk.models.LlmRegistry.BaseLlm(modelName));
        LlmRegistry.registerTestLlm(pattern, factory);
        final int threadCount = 10; // TODO: adjust thread count as needed
        com.google.adk.models.LlmRegistry.BaseLlm[] results = new com.google.adk.models.LlmRegistry.BaseLlm[threadCount];
        Thread[] threads = new Thread[threadCount];
        for (int i = 0; i < threadCount; i++) {
            final int idx = i;
            threads[i] = new Thread(() -> results[idx] = LlmRegistry.getLlm(modelName));
        }
        for (Thread t : threads) t.start();
        for (Thread t : threads) t.join();
        com.google.adk.models.LlmRegistry.BaseLlm expected = results[0];
        assertNotNull((Object)expected);
        for (int j = 1; j < threadCount; j++) {
            assertSame((Object)expected, (Object)results[j]);
        }
        Mockito.verify(factory, Mockito.times(1)).create(modelName);
    }
    @Test
    @Tag("integration")
    public void testMultipleFactoriesCreateDistinctLlmTypes() {
        String patternA = "multi-A-.*";
        String patternB = "multi-B-.*";
        String modelA = "multi-A-foo";
        String modelB = "multi-B-bar";
        com.google.adk.models.LlmRegistry.LlmFactory factoryA = (name) -> new com.google.adk.models.LlmRegistry.BaseLlm(name);
        com.google.adk.models.LlmRegistry.LlmFactory factoryB = (name) -> new com.google.adk.models.LlmRegistryGetLlmTest.SpecialBaseLlm(name);
        LlmRegistry.registerLlm(patternA, factoryA);
        LlmRegistry.registerLlm(patternB, factoryB);
        com.google.adk.models.LlmRegistry.BaseLlm llmA = LlmRegistry.getLlm(modelA);
        com.google.adk.models.LlmRegistry.BaseLlm llmB = LlmRegistry.getLlm(modelB);
        assertTrue(llmA instanceof com.google.adk.models.LlmRegistry.BaseLlm && !(llmA instanceof com.google.adk.models.LlmRegistryGetLlmTest.SpecialBaseLlm));
        assertTrue(llmB instanceof com.google.adk.models.LlmRegistryGetLlmTest.SpecialBaseLlm);
        assertEquals(modelA, llmA.modelName);
        assertEquals(modelB, llmB.modelName);
    }
