    @Test
    @Tag("integration")
    public void testCachedInstancesClearedAfterTestFactoryRegistration() {
        String pattern = "reset-model-.*";
        String modelName = "reset-model-one";
        com.google.adk.models.LlmRegistry.LlmFactory oldFactory = (name) -> new com.google.adk.models.LlmRegistry.BaseLlm(name);
        com.google.adk.models.LlmRegistry.LlmFactory newFactory = (name) -> new com.google.adk.models.LlmRegistryGetLlmTest.SpecialBaseLlm(name);
        LlmRegistry.registerLlm(pattern, oldFactory);
        com.google.adk.models.LlmRegistry.BaseLlm initial = LlmRegistry.getLlm(modelName);
        assertTrue(initial instanceof com.google.adk.models.LlmRegistry.BaseLlm);
        assertFalse(initial instanceof com.google.adk.models.LlmRegistryGetLlmTest.SpecialBaseLlm);
        LlmRegistry.registerTestLlm(pattern, newFactory);
        com.google.adk.models.LlmRegistry.BaseLlm refreshed = LlmRegistry.getLlm(modelName);
        assertNotNull((Object)refreshed);
        assertTrue(refreshed instanceof com.google.adk.models.LlmRegistryGetLlmTest.SpecialBaseLlm);
        assertNotSame((Object)initial, (Object)refreshed);
