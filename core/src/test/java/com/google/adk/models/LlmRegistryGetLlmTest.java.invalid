    @Test
    @Tag("valid")
    public void testLlmIsCreatedAndCachedWhenNoInstanceExists() {
        String pattern = "test-model-.*";
        String modelName = "test-model-001";
        com.google.adk.models.LlmRegistry.LlmFactory factory = (name) -> new com.google.adk.models.LlmRegistry.BaseLlm(name);
        LlmRegistry.registerTestLlm(pattern, factory);
        com.google.adk.models.LlmRegistry.BaseLlm actualLlm = LlmRegistry.getLlm(modelName);
        assertNotNull((Object)actualLlm);
        assertEquals(modelName, actualLlm.modelName);
        com.google.adk.models.LlmRegistry.BaseLlm cachedLlm = LlmRegistry.getLlm(modelName);
        assertSame((Object)actualLlm, (Object)cachedLlm);
    }
