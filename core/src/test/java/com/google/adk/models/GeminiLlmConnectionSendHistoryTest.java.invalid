    @Test
    @Tag("valid")
    void sendHistoryWithValidNonEmptyContentList() throws Exception {
        GeminiLlmConnection connection = createConnectionWithSuccessfulSession();
        
        Content content = Content.builder()
                .parts(ImmutableList.of(Part.builder().text("Hello").build()))
                .role("user")
                .build();
        List<Content> history = ImmutableList.of(content);
        TestObserver<Void> testObserver = connection.sendHistory(history).test();
        
        testObserver.await(5, TimeUnit.SECONDS);
        testObserver.assertComplete();
        testObserver.assertNoErrors();
        ArgumentCaptor<LiveSendClientContentParameters> captor = 
                ArgumentCaptor.forClass(LiveSendClientContentParameters.class);
        verify(mockSession).sendClientContent(captor.capture());
        
        LiveSendClientContentParameters capturedParams = captor.getValue();
        assertThat(capturedParams.turns()).isPresent();
        assertThat(capturedParams.turns().get()).hasSize(1);
    }
