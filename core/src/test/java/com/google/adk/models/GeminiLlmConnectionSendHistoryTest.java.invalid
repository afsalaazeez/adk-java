    @BeforeEach
    void setUp() throws Exception {
        // Set up the chain: mockClient.async.live.connect(...) returns sessionFuture
        mockAsync = mock(Client.Async.class);
        mockLive = mock(Client.Async.Live.class);
        when(mockClient.async).thenReturn(mockAsync);
        when(mockAsync.live).thenReturn(mockLive);
        sessionFuture = new CompletableFuture<>();
        when(mockLive.connect(anyString(), any(LiveConnectConfig.class))).thenReturn(sessionFuture);
        connection = new GeminiLlmConnection(mockClient, modelName, mockConfig);
    }
    @AfterEach
    void tearDown() {
        connection.close();
    }
    // Scenario 1: Sending a non-empty history list successfully
    @Test
    @Tag("valid")
    @DisplayName("sendHistory with non-empty list succeeds")
    public void testSendNonEmptyHistoryListSuccessfully() {
        List<Content> history = ImmutableList.of(Content.builder().build());
        when(mockSession.sendClientContent(any(LiveSendClientContentParameters.class)))
                .thenReturn(CompletableFuture.completedFuture(null));
        sessionFuture.complete(mockSession);
        Completable completable = connection.sendHistory(history);
        assertDoesNotThrow(() -> ((Completable) completable).blockingAwait());
    }
