        sessionFuture.complete(mockSession);
        List<Content> contents1 = ImmutableList.of(Content.builder().parts(ImmutableList.of(Part.builder().build())).build());
        List<Content> contents2 = ImmutableList.of(Content.builder().parts(ImmutableList.of(Part.builder().build())).build(), Content.builder().parts(ImmutableList.of(Part.builder().build())).build());
        CompletableFuture<Void> sendFuture1 = new CompletableFuture<>();
        CompletableFuture<Void> sendFuture2 = new CompletableFuture<>();
        when(mockSession.sendClientContent(any(LiveSendClientContentParameters.class)))
                .thenReturn(sendFuture1)
                .thenReturn(sendFuture2);
        Completable c1 = connection.sendHistory(contents1);
        Completable c2 = connection.sendHistory(contents2);
        sendFuture1.complete(null);
        sendFuture2.complete(null);
        assertDoesNotThrow((org.junit.jupiter.api.function.Executable) c1::blockingAwait);
        assertDoesNotThrow((org.junit.jupiter.api.function.Executable) c2::blockingAwait);
        // Should receive two calls, each corresponding to the provided contents
        verify(mockSession, times(2)).sendClientContent(any(LiveSendClientContentParameters.class));
