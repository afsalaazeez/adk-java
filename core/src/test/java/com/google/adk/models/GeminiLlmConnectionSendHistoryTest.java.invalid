    @BeforeEach
    void setUp() {
        sessionFuture = new CompletableFuture<>();
        // Mock apiClient.async.live.connect(...) to return our controllable sessionFuture
        when(mockApiClient.async()).thenReturn(mockAsync);
        when(mockAsync.live()).thenReturn(mockLive);
        when(mockLive.connect(anyString(), any())).thenReturn(sessionFuture);
        connection = new GeminiLlmConnection(mockApiClient, "test-model", mockConfig);
    }
    @AfterEach
    void tearDown() {
        if (!sessionFuture.isDone()) {
            sessionFuture.completeExceptionally(new RuntimeException("Test cleanup"));
        }
    }
    @Test
    @Tag("valid")
    void testSendHistoryWithValidContentList() {
        sessionFuture.complete(mockSession);
        List<Content> contents = ImmutableList.of(
                Content.builder().parts(ImmutableList.of(Part.builder().build())).build()
        );
        CompletableFuture<Void> sendFuture = new CompletableFuture<>();
        when(mockSession.sendClientContent(any(LiveSendClientContentParameters.class))).thenReturn(sendFuture);
        Completable completable = connection.sendHistory(contents);
        sendFuture.complete(null);
        assertDoesNotThrow((org.junit.jupiter.api.function.Executable) completable::blockingAwait);
        verify(mockSession, times(1)).sendClientContent(
                argThat(params -> params.turns().equals(Optional.of(contents)))
        );
    }
    @Test
