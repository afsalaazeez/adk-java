    void sendHistoryWithContentContainingVariousPartTypes() {
        when(mockClient.async().live().connect(eq(modelName), eq(connectConfig)))
            .thenReturn(sessionFuture);
        when(mockSession.sendClientContent(any(LiveSendClientContentParameters.class)))
            .thenReturn(CompletableFuture.completedFuture(null));
        when(mockSession.receive(any())).thenReturn(CompletableFuture.completedFuture(null));
        
        GeminiLlmConnection connection = new GeminiLlmConnection(mockClient, modelName, connectConfig);
        List<Content> history = ImmutableList.of(
            Content.builder().parts(ImmutableList.of(Part.builder().text("Text part").build())).build(),
            Content.builder().parts(ImmutableList.of(
                Part.builder().text("Multiple").build(),
                Part.builder().text("Parts").build()
            )).build()
        );
        
        TestObserver<Void> testObserver = connection.sendHistory(history).test();
        testObserver.awaitDone(5, TimeUnit.SECONDS);
        testObserver.assertComplete();
        testObserver.assertNoErrors();
        
        ArgumentCaptor<LiveSendClientContentParameters> captor = 
            ArgumentCaptor.forClass(LiveSendClientContentParameters.class);
        verify(mockSession, times(1)).sendClientContent(captor.capture());
        
        LiveSendClientContentParameters params = captor.getValue();
        assertTrue(params.turns().isPresent());
        assertTrue(params.turns().get().size() == 2);
    }
    
    @Test
    @Tag("invalid")
    void sendHistoryPropagatesCompletionExceptionFromSessionFuture() {
        IllegalStateException underlyingException = new IllegalStateException("Underlying error");
        CompletionException completionException = new CompletionException(underlyingException);
        CompletableFuture<AsyncSession> failedSessionFuture = new CompletableFuture<>();
        failedSessionFuture.completeExceptionally(completionException);
        
        when(mockClient.async().live().connect(eq(modelName), eq(connectConfig)))
            .thenReturn(failedSessionFuture);
        
        GeminiLlmConnection connection = new GeminiLlmConnection(mockClient, modelName, connectConfig);
        List<Content> history = ImmutableList.of(
            Content.builder().parts(ImmutableList.of(Part.builder().text("Test").build())).build()
        );
        
        TestObserver<Void> testObserver = connection.sendHistory(history).test();
        testObserver.awaitDone(5, TimeUnit.SECONDS);
        testObserver.assertError(throwable -> throwable != null);
    }
    
    @Test
    @Tag("integration")
    void sendHistoryMaintainsThreadSafety() throws Exception {
        when(mockClient.async().live().connect(eq(modelName), eq(connectConfig)))
            .thenReturn(sessionFuture);
        when(mockSession.sendClientContent(any(LiveSendClientContentParameters.class)))
            .thenReturn(CompletableFuture.completedFuture(null));
        when(mockSession.receive(any())).thenReturn(CompletableFuture.completedFuture(null));
        
        GeminiLlmConnection connection = new GeminiLlmConnection(mockClient, modelName, connectConfig);
        
        int threadCount = 10;
        ExecutorService executorService = Executors.newFixedThreadPool(threadCount);
        CountDownLatch latch = new CountDownLatch(threadCount);
        AtomicInteger successCount = new AtomicInteger(0);
        
        for (int i = 0; i < threadCount; i++) {
            final int index = i;
            executorService.submit(() -> {
                try {
                    List<Content> history = ImmutableList.of(
                        Content.builder().parts(ImmutableList.of(
                            Part.builder().text("Thread " + index).build()
                        )).build()
                    );
                    
                    TestObserver<Void> testObserver = connection.sendHistory(history).test();
                    testObserver.awaitDone(5, TimeUnit.SECONDS);
                    
                    if (testObserver.errors().isEmpty()) {
                        successCount.incrementAndGet();
                    }
                } finally {
                    latch.countDown();
                }
            });
        }
        
        latch.await(10, TimeUnit.SECONDS);
        executorService.shutdown();
        
        assertTrue(successCount.get() == threadCount);
        verify(mockSession, times(threadCount)).sendClientContent(any(LiveSendClientContentParameters.class));
    }
    
    @Test
    @Tag("boundary")
    void sendHistoryWithLargeHistoryList() {
        when(mockClient.async().live().connect(eq(modelName), eq(connectConfig)))
            .thenReturn(sessionFuture);
        when(mockSession.sendClientContent(any(LiveSendClientContentParameters.class)))
            .thenReturn(CompletableFuture.completedFuture(null));
        when(mockSession.receive(any())).thenReturn(CompletableFuture.completedFuture(null));
        
        GeminiLlmConnection connection = new GeminiLlmConnection(mockClient, modelName, connectConfig);
        
        List<Content> history = new ArrayList<>();
        for (int i = 0; i < 1000; i++) {
            history.add(Content.builder().parts(ImmutableList.of(
                Part.builder().text("Message " + i).build()
            )).build());
        }
        
        TestObserver<Void> testObserver = connection.sendHistory(history).test();
        testObserver.awaitDone(10, TimeUnit.SECONDS);
        testObserver.assertComplete();
        testObserver.assertNoErrors();
        
        ArgumentCaptor<LiveSendClientContentParameters> captor = 
            ArgumentCaptor.forClass(LiveSendClientContentParameters.class);
        verify(mockSession, times(1)).sendClientContent(captor.capture());
        
        LiveSendClientContentParameters params = captor.getValue();
        assertTrue(params.turns().isPresent());
        assertTrue(params.turns().get().size() == 1000);
    }
    
    @Test
    @Tag("valid")
    void sendHistoryPreservesContentOrder() {
        when(mockClient.async().live().connect(eq(modelName), eq(connectConfig)))
            .thenReturn(sessionFuture);
        when(mockSession.sendClientContent(any(LiveSendClientContentParameters.class)))
            .thenReturn(CompletableFuture.completedFuture(null));
        when(mockSession.receive(any())).thenReturn(CompletableFuture.completedFuture(null));
        
        GeminiLlmConnection connection = new GeminiLlmConnection(mockClient, modelName, connectConfig);
        List<Content> history = ImmutableList.of(
            Content.builder().parts(ImmutableList.of(Part.builder().text("First").build())).build(),
            Content.builder().parts(ImmutableList.of(Part.builder().text("Second").build())).build(),
            Content.builder().parts(ImmutableList.of(Part.builder().text("Third").build())).build()
        );
        
        TestObserver<Void> testObserver = connection.sendHistory(history).test();
        testObserver.awaitDone(5, TimeUnit.SECONDS);
        testObserver.assertComplete();
        testObserver.assertNoErrors();
        
        ArgumentCaptor<LiveSendClientContentParameters> captor = 
            ArgumentCaptor.forClass(LiveSendClientContentParameters.class);
        verify(mockSession, times(1)).sendClientContent(captor.capture());
        
        LiveSendClientContentParameters params = captor.getValue();
        assertTrue(params.turns().isPresent());
        List<Content> capturedTurns = params.turns().get();
        assertTrue(capturedTurns.size() == 3);
        assertTrue(capturedTurns.get(0).parts().get().get(0).text().get().equals("First"));
        assertTrue(capturedTurns.get(1).parts().get().get(0).text().get().equals("Second"));
        assertTrue(capturedTurns.get(2).parts().get().get(0).text().get().equals("Third"));
    }
}