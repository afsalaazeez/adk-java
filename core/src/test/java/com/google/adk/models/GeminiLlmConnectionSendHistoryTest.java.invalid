    @Test
    @Tag("integration")
    void sendHistoryConcurrentCalls() throws Exception {
        GeminiLlmConnection connection = createConnectionWithSuccessfulSession();
        
        int numConcurrentCalls = 5;
        CountDownLatch latch = new CountDownLatch(numConcurrentCalls);
        ExecutorService executor = Executors.newFixedThreadPool(numConcurrentCalls);
        List<TestObserver<Void>> observers = new ArrayList<>();
        for (int i = 0; i < numConcurrentCalls; i++) {
            final int index = i;
            executor.submit(() -> {
                Content content = Content.builder()
                        .parts(ImmutableList.of(Part.builder().text("Message " + index).build()))
                        .role("user")
                        .build();
                List<Content> history = ImmutableList.of(content);
                
                TestObserver<Void> observer = connection.sendHistory(history).test();
                synchronized (observers) {
                    observers.add(observer);
                }
                latch.countDown();
            });
        }
        latch.await(10, TimeUnit.SECONDS);
        executor.shutdown();
        executor.awaitTermination(5, TimeUnit.SECONDS);
        for (TestObserver<Void> observer : observers) {
            observer.await(5, TimeUnit.SECONDS);
        }
        
        assertThat(observers).hasSize(numConcurrentCalls);
    }
