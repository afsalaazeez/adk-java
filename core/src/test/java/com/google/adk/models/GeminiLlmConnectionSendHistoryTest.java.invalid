    @Test
    @Tag("valid")
    void testSendHistoryDoesNotAffectResponseFlowable() {
        sessionFuture.complete(mockSession);
        List<LlmResponse> emissions = new java.util.ArrayList<>();
        List<Throwable> errors = new java.util.ArrayList<>();
        List<org.reactivestreams.Subscription> subscriptions = new java.util.ArrayList<>();
        connection.receive().subscribe(new Subscriber<LlmResponse>() {
            @Override public void onSubscribe(Subscription s) { subscriptions.add(s); s.request(Long.MAX_VALUE); }
            @Override public void onNext(LlmResponse llmResponse) { emissions.add(llmResponse); }
            @Override public void onError(Throwable t) { errors.add(t); }
            @Override public void onComplete() {}
        });
        List<Content> contents = ImmutableList.of(Content.builder().parts(ImmutableList.of(Part.builder().build())).build());
        CompletableFuture<Void> sendFuture = new CompletableFuture<>();
        when(mockSession.sendClientContent(any(LiveSendClientContentParameters.class))).thenReturn(sendFuture);
        Completable completable = connection.sendHistory(contents);
        sendFuture.complete(null);
        assertDoesNotThrow((org.junit.jupiter.api.function.Executable) completable::blockingAwait);
        assertTrue(emissions.isEmpty(), "Flowable should have no emissions after sendHistory");
        assertTrue(errors.isEmpty(), "Flowable should have no errors after sendHistory");
        // Not completed either
    }
