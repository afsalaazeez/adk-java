                .build();
        Gemini.Builder returnedBuilder = builder.vertexCredentials(credentials);
        assertSame((VertexCredentials)credentials, getVertexCredentialsField(builder));
        assertSame((Gemini.Builder)builder, returnedBuilder);
    }
