    @Test
    @Tag("integration")
    public void testVertexCredentialsSetAfterApiClientDoesNotAffectPrecedence() {
        String modelName = "precedence-model";
        Client client = Client.builder()
                .httpOptions(HttpOptions.builder().build())
                .build();
        VertexCredentials credentials = VertexCredentials.builder()
                .project(Optional.of("precedence-project"))
                .build();
        Gemini.Builder tempBuilder = new Gemini.Builder()
                .modelName(modelName)
                .apiClient(client)
                .vertexCredentials(credentials);
        Gemini result = tempBuilder.build();
        assertNotNull(result);
        // Gemini created with apiClient when apiClient is present
        assertEquals(modelName, (String)getModelNameField(tempBuilder));
        assertSame((Client)client, getApiClientField(tempBuilder));
        assertSame((VertexCredentials)credentials, getVertexCredentialsField(tempBuilder));
    }
