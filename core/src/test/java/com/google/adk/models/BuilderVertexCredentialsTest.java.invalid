    }
    @Test
    @Tag("valid")
    public void testOverwriteVertexCredentialsWithNewObject() {
        VertexCredentials credentials1 = VertexCredentials.builder()
                .project(Optional.of("first-project"))
                .build();
        VertexCredentials credentials2 = VertexCredentials.builder()
                .project(Optional.of("second-project"))
                .build();
        builder.vertexCredentials(credentials1);
        Gemini.Builder returnedBuilder = builder.vertexCredentials(credentials2);
        assertSame((VertexCredentials)credentials2, getVertexCredentialsField(builder));
        assertSame((Gemini.Builder)builder, returnedBuilder);
        assertTrue(getVertexCredentialsField(builder) != credentials1);
    }
    @Test
    @Tag("valid")
    public void testVertexCredentialsChainWithOtherBuilderMethods() {
        String modelName = "test-model";
        String apiKey = "key123";
        Client mockClient = Client.builder()
                .httpOptions(HttpOptions.builder().build())
                .build();
        VertexCredentials credentials = VertexCredentials.builder()
                .project(Optional.of("chain-project"))
                .build();
        Gemini.Builder chainedBuilder = builder
                .apiKey(apiKey)
                .modelName(modelName)
                .vertexCredentials(credentials)
                .apiClient(mockClient);
        assertSame((Gemini.Builder)builder, chainedBuilder);
        assertEquals(modelName, (String)getModelNameField(builder));
        assertEquals(apiKey, (String)getApiKeyField(builder));
        assertSame((Client)mockClient, getApiClientField(builder));
        assertSame((VertexCredentials)credentials, getVertexCredentialsField(builder));
    }
