package com.google.adk.models;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import com.google.genai.types.Candidate;
import com.google.genai.types.Content;
import com.google.genai.types.FinishReason;
import com.google.genai.types.GenerateContentResponse;
import com.google.genai.types.Part;
import io.reactivex.rxjava3.core.Flowable;
import java.util.ArrayList;
import java.util.List;
import java.util.Optional;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.MockedStatic;
import org.mockito.junit.jupiter.MockitoExtension;
import org.junit.jupiter.api.*;
import static com.google.common.base.StandardSystemProperty.JAVA_VERSION;
import com.google.adk.Version;
import com.google.common.collect.ImmutableMap;
import com.google.errorprone.annotations.CanIgnoreReturnValue;
import com.google.genai.Client;
import com.google.genai.ResponseStream;
import com.google.genai.types.GenerateContentConfig;
import com.google.genai.types.HttpOptions;
import com.google.genai.types.LiveConnectConfig;
import java.util.Objects;
import java.util.concurrent.CompletableFuture;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

@ExtendWith(MockitoExtension.class)
public class GeminiProcessRawResponsesTest {
    @Test
    @Tag("valid")
    void processSingleRawResponseWithNonBlankTextContent() {
        Part mockPart = mock(Part.class);
        when(mockPart.text()).thenReturn(Optional.of("Hello World"));
        when(mockPart.thought()).thenReturn(Optional.of(false));
        GenerateContentResponse mockResponse = mock(GenerateContentResponse.class);
        LlmResponse mockLlmResponse = mock(LlmResponse.class);
        try (MockedStatic<LlmResponse> llmResponseMock = mockStatic(LlmResponse.class);
             MockedStatic<GeminiUtil> geminiUtilMock = mockStatic(GeminiUtil.class)) {
            llmResponseMock.when(() -> LlmResponse.create(mockResponse)).thenReturn(mockLlmResponse);
            geminiUtilMock.when(() -> GeminiUtil.getPart0FromLlmResponse(mockLlmResponse))
                    .thenReturn(Optional.of(mockPart));
            Flowable<GenerateContentResponse> rawResponses = Flowable.just(mockResponse);
            List<LlmResponse> results = Gemini.processRawResponses(rawResponses).toList().blockingGet();
            assertNotNull(results);
            assertEquals(1, results.size());
            assertTrue(results.get(0).partial().orElse(false));
        }
    }
    @Test
    @Tag("valid")
    void processMultipleRawResponsesWithAccumulatedText() {
        Part mockPart1 = mock(Part.class);
        when(mockPart1.text()).thenReturn(Optional.of("Hello "));
        when(mockPart1.thought()).thenReturn(Optional.of(false));
        Part mockPart2 = mock(Part.class);
        when(mockPart2.text()).thenReturn(Optional.of("World"));
        when(mockPart2.thought()).thenReturn(Optional.of(false));
        GenerateContentResponse mockResponse1 = mock(GenerateContentResponse.class);
        GenerateContentResponse mockResponse2 = mock(GenerateContentResponse.class);
        LlmResponse mockLlmResponse1 = mock(LlmResponse.class);
        LlmResponse mockLlmResponse2 = mock(LlmResponse.class);
        try (MockedStatic<LlmResponse> llmResponseMock = mockStatic(LlmResponse.class);
             MockedStatic<GeminiUtil> geminiUtilMock = mockStatic(GeminiUtil.class)) {
            llmResponseMock.when(() -> LlmResponse.create(mockResponse1)).thenReturn(mockLlmResponse1);
            llmResponseMock.when(() -> LlmResponse.create(mockResponse2)).thenReturn(mockLlmResponse2);
            geminiUtilMock.when(() -> GeminiUtil.getPart0FromLlmResponse(mockLlmResponse1))
                    .thenReturn(Optional.of(mockPart1));
            geminiUtilMock.when(() -> GeminiUtil.getPart0FromLlmResponse(mockLlmResponse2))
                    .thenReturn(Optional.of(mockPart2));
            Flowable<GenerateContentResponse> rawResponses = Flowable.just(mockResponse1, mockResponse2);
            List<LlmResponse> results = Gemini.processRawResponses(rawResponses).toList().blockingGet();
