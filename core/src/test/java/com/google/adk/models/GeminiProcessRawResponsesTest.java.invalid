                .thenReturn(Optional.of(Part.fromText("")));
            Flowable<LlmResponse> actualFlowable = Gemini.processRawResponses(Flowable.just(responseStop));
            List<LlmResponse> actualList = actualFlowable.toList().blockingGet();
            Assertions.assertTrue(((List<LlmResponse>) actualList).stream().allMatch(l -> l.content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse("").equals("")));
        }
    }
    @Test
    @Tag("valid")
    public void testOnlyPart0ConsideredFromMultiPartResponses() {
        Part part0 = Part.fromText("part0").toBuilder().thought(true).build();
        Part part1 = Part.fromText("part1");
