            Flowable<LlmResponse> actualFlowable = Gemini.processRawResponses(Flowable.just(response));
            List<LlmResponse> actualList = actualFlowable.toList().blockingGet();
            Assertions.assertEquals(1, ((List<LlmResponse>) actualList).size());
            Assertions.assertEquals("part0", ((List<LlmResponse>) actualList).get(0).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse(""));
        }
    }
    @Test
    @Tag("integration")
    public void testRepeatedBlankAndNonBlankPartsNoContentLoss() {
        Part p1 = Part.fromText("a");
        Part blank1 = Part.fromText("");
        Part p2 = Part.fromText("b").toBuilder().thought(true).build();
        Part blank2 = Part.fromText("");
        Candidate cand1 = Candidate.builder().content(Content.builder().role("model").parts(p1).build()).build();
        Candidate candBlank1 = Candidate.builder().content(Content.builder().role("model").parts(blank1).build()).build();
        Candidate cand2 = Candidate.builder().content(Content.builder().role("model").parts(p2).build()).build();
        Candidate candBlank2 = Candidate.builder().content(Content.builder().role("model").parts(blank2).build()).build();
        GenerateContentResponse resp1 = GenerateContentResponse.builder().candidates(List.of(cand1)).build();
        GenerateContentResponse respBlank1 = GenerateContentResponse.builder().candidates(List.of(candBlank1)).build();
        GenerateContentResponse resp2 = GenerateContentResponse.builder().candidates(List.of(cand2)).build();
        GenerateContentResponse respBlank2 = GenerateContentResponse.builder().candidates(List.of(candBlank2)).build();
        try (MockedStatic<GeminiUtil> mockedUtil = Mockito.mockStatic(GeminiUtil.class)) {
            mockedUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(Mockito.any()))
                .thenReturn(Optional.of(p1), Optional.of(blank1), Optional.of(p2), Optional.of(blank2));
            mockedUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(Mockito.any()))
                .thenReturn(true, true, true, true);
            Flowable<LlmResponse> actualFlowable = Gemini.processRawResponses(Flowable.just(resp1, respBlank1, resp2, respBlank2));
            List<LlmResponse> actualList = actualFlowable.toList().blockingGet();
            Assertions.assertTrue(((List<LlmResponse>) actualList).stream().anyMatch(l -> l.content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse("").equals("a")));
            Assertions.assertTrue(((List<LlmResponse>) actualList).stream().anyMatch(l -> l.content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse("").equals("b")));
        }
    }
