    @Test
    @Tag("valid")
    public void testRapidAlternatingThoughtAndTextChunksMaintainSeparation() {
        Part thoughtPart = Part.fromText("th1").toBuilder().thought(true).build();
        Part textPart = Part.fromText("tx1");
        GenerateContentResponse gcr1 = GenerateContentResponse.builder().candidates(List.of(Candidate.builder().content(Content.builder().role("model").parts(List.of(thoughtPart)).build()).build())).build();
        GenerateContentResponse gcr2 = GenerateContentResponse.builder().candidates(List.of(Candidate.builder().content(Content.builder().role("model").parts(List.of(textPart)).build()).build())).build();
        GenerateContentResponse blankGcr = GenerateContentResponse.builder().candidates(List.of(Candidate.builder().content(Content.builder().role("model").parts(List.of(Part.fromText(""))).build()).build())).build();
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class)))
                .thenReturn(Optional.of(thoughtPart))
                .thenReturn(Optional.of(textPart))
                .thenReturn(Optional.of(Part.fromText("")));
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(false, false, true);
            Flowable<LlmResponse> out = Gemini.processRawResponses(Flowable.just(gcr1, gcr2, blankGcr));
            List<LlmResponse> emissions = collect(out);
            assertTrue(emissions.size() > 0);
            assertEquals("th1", emissions.get(0).content().get().parts().get(0).text().orElse(""));
            assertEquals("tx1", emissions.get(1).content().get().parts().get(0).text().orElse(""));
        }
    }
    @Test
    @Tag("valid")
    public void testMultipleEmissionTriggerFlushesAccumulatorsSequentially() {
        Part partA = Part.fromText("X");
        Part partB = Part.fromText("Y");
        Candidate candidateA = Candidate.builder().content(Content.builder().role("model").parts(List.of(partA)).build()).build();
        Candidate candidateB = Candidate.builder().content(Content.builder().role("model").parts(List.of(partB)).build()).build();
        GenerateContentResponse gcrA = GenerateContentResponse.builder().candidates(List.of(candidateA)).build();
        GenerateContentResponse gcrB = GenerateContentResponse.builder().candidates(List.of(candidateB)).build();
        GenerateContentResponse blankGcr = GenerateContentResponse.builder().candidates(List.of(Candidate.builder().content(Content.builder().role("model").parts(List.of(Part.fromText(""))).build()).build())).build();
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class)))
                .thenReturn(Optional.of(partA))
                .thenReturn(Optional.of(partB))
                .thenReturn(Optional.of(Part.fromText("")))
                .thenReturn(Optional.of(Part.fromText("")));
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(false, false, true, true);
            Flowable<LlmResponse> out = Gemini.processRawResponses(Flowable.just(gcrA, gcrB, blankGcr, blankGcr));
            List<LlmResponse> emissions = collect(out);
            long flushCount = emissions.stream()
                .filter(lr -> lr.content().isPresent() &&
                              lr.content().get().parts().get(0).text().orElse("").equals("XY"))
                .count();
            assertTrue(flushCount >= 1);
        }
    }
    @Test
    @Tag("boundary")
    public void testWhitespaceOnlyTextChunkDoesNotCreateAccumulation() {
        Part whitespacePart = Part.fromText("   ");
        Content content = Content.builder().role("model").parts(List.of(whitespacePart)).build();
        Candidate candidate = Candidate.builder().content(content).build();
        GenerateContentResponse gcr = GenerateContentResponse.builder().candidates(List.of(candidate)).build();
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class))).thenReturn(Optional.of(whitespacePart));
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(true);
            Flowable<LlmResponse> out = Gemini.processRawResponses(Flowable.just(gcr));
            List<LlmResponse> emissions = collect(out);
            assertEquals(1, emissions.size());
            assertEquals(LlmResponse.create(gcr).content(), emissions.get(0).content());
        }
    }
    @Test
    @Tag("boundary")
    public void testFinalCandidateNotStopPreventsFinalAccumulatorEmission() {
        Part part = Part.fromText("neverflushed");
        // Use direct FinishReason.of method for valid code, and set Known.COMPLETION case suggestion
        Candidate candidate = Candidate.builder().content(Content.builder().role("model").parts(List.of(part)).build())
                .finishReason(FinishReason.of(FinishReason.Known.COMPLETION)).build(); // Not STOP
        GenerateContentResponse gcr = GenerateContentResponse.builder().candidates(List.of(candidate)).build();
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class))).thenReturn(Optional.of(part));
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(false);
            Flowable<LlmResponse> out = Gemini.processRawResponses(Flowable.just(gcr));
            List<LlmResponse> emissions = collect(out);
            boolean accumulatorFlushed = emissions.stream()
                .anyMatch(lr -> lr.content().isPresent() && lr.content().get().parts().stream().anyMatch(p -> p.text().orElse("").equals("neverflushed")));
            assertTrue(accumulatorFlushed);
        }
    }
    // Helper for accessing private static method responseFromText via reflection
    private static LlmResponse invokeResponseFromText(String txt) {
        try {
            java.lang.reflect.Method m = Gemini.class.getDeclaredMethod("responseFromText", String.class);
            m.setAccessible(true);
            return (LlmResponse) m.invoke(null, txt);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }
    // Helper for accessing private static method thinkingResponseFromText via reflection
    private static LlmResponse invokeThinkingResponseFromText(String txt) {
        try {
            java.lang.reflect.Method m = Gemini.class.getDeclaredMethod("thinkingResponseFromText", String.class);
            m.setAccessible(true);
            return (LlmResponse) m.invoke(null, txt);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }
}