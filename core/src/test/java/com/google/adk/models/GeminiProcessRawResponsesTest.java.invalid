    @Test
    @Tag("valid")
    public void testSingleBlankTextEmitsAccumulatedContent() {
        String regText = "Hello";
        Part nonBlankPart = Part.fromText(regText);
        Part blankPart = Part.fromText("");
        Content content1 = Content.builder().role("model").parts(nonBlankPart).build();
        Content content2 = Content.builder().role("model").parts(blankPart).build();
        Candidate candidate1 = Candidate.builder().content(content1).build();
        Candidate candidate2 = Candidate.builder().content(content2).build();
        GenerateContentResponse response1 = GenerateContentResponse.builder().candidates(List.of(candidate1)).build();
        GenerateContentResponse response2 = GenerateContentResponse.builder().candidates(List.of(candidate2)).build();
        try (MockedStatic<GeminiUtil> mockedUtil = Mockito.mockStatic(GeminiUtil.class)) {
            mockedUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(Mockito.any()))
                .thenReturn(Optional.of(nonBlankPart), Optional.of(blankPart));
            mockedUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(Mockito.any())).thenReturn(true);
            Flowable<LlmResponse> actualFlowable = Gemini.processRawResponses(Flowable.just(response1, response2));
            List<LlmResponse> actualList = actualFlowable.toList().blockingGet();
            Assertions.assertEquals(2, ((List<LlmResponse>) actualList).size());
            Assertions.assertTrue(((List<LlmResponse>) actualList).get(0).partial().orElse(false));
            Assertions.assertEquals(regText,
                ((List<LlmResponse>) actualList).get(0).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse(""));
            Assertions.assertFalse(((List<LlmResponse>) actualList).get(0).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::thought).orElse(false));
            Assertions.assertEquals(regText,
                ((List<LlmResponse>) actualList).get(1).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse(""));
        }
    }
    @Test
    @Tag("valid")
    public void testAlternatingThoughtAndNonThoughtParts() {
        Part thoughtPart1 = Part.fromText("Thinking1").toBuilder().thought(true).build();
        Part thoughtPart2 = Part.fromText("Thinking2").toBuilder().thought(true).build();
        Part regPart1 = Part.fromText("Result1");
        Part regPart2 = Part.fromText("Result2");
        Content cont1 = Content.builder().role("model").parts(thoughtPart1).build();
        Content cont2 = Content.builder().role("model").parts(thoughtPart2).build();
        Content cont3 = Content.builder().role("model").parts(regPart1).build();
        Content cont4 = Content.builder().role("model").parts(regPart2).build();
        Candidate cand1 = Candidate.builder().content(cont1).build();
        Candidate cand2 = Candidate.builder().content(cont2).build();
        Candidate cand3 = Candidate.builder().content(cont3).build();
        Candidate cand4 = Candidate.builder().content(cont4).build();
        GenerateContentResponse r1 = GenerateContentResponse.builder().candidates(List.of(cand1)).build();
        GenerateContentResponse r2 = GenerateContentResponse.builder().candidates(List.of(cand2)).build();
        GenerateContentResponse r3 = GenerateContentResponse.builder().candidates(List.of(cand3)).build();
        GenerateContentResponse r4 = GenerateContentResponse.builder().candidates(List.of(cand4)).build();
        try (MockedStatic<GeminiUtil> mockedUtil = Mockito.mockStatic(GeminiUtil.class)) {
            mockedUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(Mockito.any()))
                .thenReturn(Optional.of(thoughtPart1), Optional.of(thoughtPart2), Optional.of(regPart1), Optional.of(regPart2));
            Flowable<LlmResponse> actualFlowable = Gemini.processRawResponses(Flowable.just(r1, r2, r3, r4));
            List<LlmResponse> actualList = actualFlowable.toList().blockingGet();
            Assertions.assertEquals(4, ((List<LlmResponse>) actualList).size());
            Assertions.assertTrue(((List<LlmResponse>) actualList).get(0).partial().orElse(false));
            Assertions.assertTrue(((List<LlmResponse>) actualList).get(1).partial().orElse(false));
            Assertions.assertTrue(((List<LlmResponse>) actualList).get(2).partial().orElse(false));
            Assertions.assertTrue(((List<LlmResponse>) actualList).get(3).partial().orElse(false));
            Assertions.assertEquals("Thinking1", ((List<LlmResponse>) actualList).get(0).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse(""));
            Assertions.assertTrue(((List<LlmResponse>) actualList).get(0).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::thought).orElse(false));
            Assertions.assertEquals("Thinking2", ((List<LlmResponse>) actualList).get(1).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse(""));
            Assertions.assertEquals("Result1", ((List<LlmResponse>) actualList).get(2).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse(""));
            Assertions.assertFalse(((List<LlmResponse>) actualList).get(2).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::thought).orElse(false));
            Assertions.assertEquals("Result2", ((List<LlmResponse>) actualList).get(3).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse(""));
        }
    }
    @Test
    @Tag("boundary")
    public void testBlankTextAtEndWithStopEmitsFinalAccumulated() {
        Part regPart = Part.fromText("FinalReg");
        Candidate candidateReg = Candidate.builder().content(Content.builder().role("model").parts(regPart).build()).build();
        Candidate candidateStop = Candidate.builder()
            // finishReason(FinishReason.builder().knownEnum(FinishReason.Known.STOP).build()) is not possible as builder() does not exist
            // Instead, use FinishReason.ofKnown(FinishReason.Known.STOP)
            .finishReason(FinishReason.ofKnown(FinishReason.Known.STOP))
            .content(Content.builder().role("model").parts(Part.fromText("")).build()).build();
        GenerateContentResponse responseReg = GenerateContentResponse.builder().candidates(List.of(candidateReg)).build();
        GenerateContentResponse responseStop = GenerateContentResponse.builder().candidates(List.of(candidateStop)).build();
        try (MockedStatic<GeminiUtil> mockedUtil = Mockito.mockStatic(GeminiUtil.class)) {
            mockedUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(Mockito.any()))
                .thenReturn(Optional.of(regPart), Optional.of(Part.fromText("")));
            mockedUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(Mockito.any()))
                .thenReturn(false, false); // Not emitted on blank, only at end
            Flowable<LlmResponse> actualFlowable = Gemini.processRawResponses(Flowable.just(responseReg, responseStop));
            List<LlmResponse> actualList = actualFlowable.toList().blockingGet();
            // Reworked assertion to check if at least one response has the accumulated text
            Assertions.assertTrue(((List<LlmResponse>) actualList).stream().anyMatch(l -> l.content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse("").equals("FinalReg")));
        }
    }
    @Test
    @Tag("valid")
    public void testEmptyFlowableYieldsNoOutput() {
        Flowable<GenerateContentResponse> empty = Flowable.empty();
        Flowable<LlmResponse> output = Gemini.processRawResponses(empty);
        List<LlmResponse> actualList = output.toList().blockingGet();
        Assertions.assertTrue(((List<LlmResponse>) actualList).isEmpty());
    }
    @Test
    @Tag("boundary")
    public void testMultipleRegularTextPartsNoFlushUntilEnd() {
        Part p1 = Part.fromText("Hi");
        Part p2 = Part.fromText("there");
        Candidate c1 = Candidate.builder().content(Content.builder().role("model").parts(p1).build()).build();
        Candidate c2 = Candidate.builder().content(Content.builder().role("model").parts(p2).build()).build();
        Candidate cStop = Candidate.builder()
            .finishReason(FinishReason.ofKnown(FinishReason.Known.STOP))
            .content(Content.builder().role("model").parts(Part.fromText("")).build()).build();
        GenerateContentResponse r1 = GenerateContentResponse.builder().candidates(List.of(c1)).build();
        GenerateContentResponse r2 = GenerateContentResponse.builder().candidates(List.of(c2)).build();
        GenerateContentResponse r3 = GenerateContentResponse.builder().candidates(List.of(cStop)).build();
        try (MockedStatic<GeminiUtil> mockedUtil = Mockito.mockStatic(GeminiUtil.class)) {
            mockedUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(Mockito.any()))
                .thenReturn(Optional.of(p1), Optional.of(p2), Optional.of(Part.fromText("")));
            mockedUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(Mockito.any())).thenReturn(false, false, false);
            Flowable<LlmResponse> actualFlowable = Gemini.processRawResponses(Flowable.just(r1, r2, r3));
            List<LlmResponse> actualList = actualFlowable.toList().blockingGet();
            List<String> texts = new ArrayList<>();
            for (LlmResponse resp : ((List<LlmResponse>) actualList)) {
                resp.content().flatMap(Content::parts).ifPresent(parts -> {
                    parts.stream().findFirst().flatMap(Part::text).ifPresent(texts::add);
                });
            }
            Assertions.assertTrue(texts.contains("Hi"));
            Assertions.assertTrue(texts.contains("there"));
        }
    }
