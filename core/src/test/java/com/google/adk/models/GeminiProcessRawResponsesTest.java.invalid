    @Test
    @Tag("valid")
    public void testAllBlankTextChunksEmitProcessedRawResponses() {
        Part blankPart = Part.fromText("");
        Candidate blankCandidate = Candidate.builder().content(Content.builder().role("model").parts(List.of(blankPart)).build()).build();
        GenerateContentResponse blankGcr1 = GenerateContentResponse.builder().candidates(List.of(blankCandidate)).build();
        GenerateContentResponse blankGcr2 = GenerateContentResponse.builder().candidates(List.of(blankCandidate)).build();
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class))).thenReturn(Optional.of(blankPart));
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(true);
            Flowable<LlmResponse> out = Gemini.processRawResponses(Flowable.just(blankGcr1, blankGcr2));
            List<LlmResponse> emissions = collect(out);
            assertEquals(2, emissions.size());
        }
    }
    @Test
    @Tag("valid")
    public void testShouldNotEmitAccumulatedWhenShouldEmitReturnsFalse() {
        Part part = Part.fromText("preserve");
        Candidate candidate = Candidate.builder().content(Content.builder().role("model").parts(List.of(part)).build()).build();
        GenerateContentResponse gcr1 = GenerateContentResponse.builder().candidates(List.of(candidate)).build();
        GenerateContentResponse blankGcr = GenerateContentResponse.builder().candidates(List.of(Candidate.builder().content(Content.builder().role("model").parts(List.of(Part.fromText(""))).build()).build())).build();
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class)))
                .thenReturn(Optional.of(part))
                .thenReturn(Optional.of(Part.fromText("")));
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(false, false);
            Flowable<LlmResponse> out = Gemini.processRawResponses(Flowable.just(gcr1, blankGcr));
            List<LlmResponse> emissions = collect(out);
            boolean foundAggregated = emissions.stream()
                .anyMatch(lr -> lr.content().isPresent() && lr.content().get().parts().stream().anyMatch(p -> p.text().orElse("").equals("preserve")));
            assertTrue(foundAggregated);
        }
    }
    @Test
    @Tag("boundary")
    public void testInterruptedStreamCausesNoFinalEmission() {
        Flowable<GenerateContentResponse> interruptedFlowable = Flowable.empty();
