    @Test
    @Tag("valid")
    public void testSingleThoughtPartNonBlankText() {
        String thoughtText = "Thinking...";
        Part part = Part.fromText(thoughtText).toBuilder().thought(true).build();
        Content content = Content.builder().role("model").parts(part).build();
        Candidate candidate = Candidate.builder().content(content).build();
        GenerateContentResponse response = GenerateContentResponse.builder().candidates(List.of(candidate)).build();
        LlmResponse expectedPartialResponse = LlmResponse.builder()
            .content(Content.builder().role("model").parts(part).build())
            .partial(true)
            .build();
        try (MockedStatic<GeminiUtil> mockedUtil = Mockito.mockStatic(GeminiUtil.class)) {
            mockedUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(Mockito.any())).thenReturn(Optional.of(part));
            Flowable<LlmResponse> actualFlowable = Gemini.processRawResponses(Flowable.just(response));
            List<LlmResponse> actualList = actualFlowable.toList().blockingGet();
            Assertions.assertEquals(1, ((List<LlmResponse>) actualList).size());
            Assertions.assertTrue(((List<LlmResponse>) actualList).get(0).partial().orElse(false));
            Assertions.assertEquals(thoughtText,
                ((List<LlmResponse>) actualList).get(0).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse(""));
            Assertions.assertTrue(((List<LlmResponse>) actualList).get(0).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::thought).orElse(false));
        }
    }
    @Test
