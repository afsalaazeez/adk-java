    @Test
    @Tag("valid")
    public void testProcessMultipleTextChunksAggregateOnShouldEmit() {
        Part part1 = Part.fromText("A");
        Part part2 = Part.fromText("B");
        Content content1 = Content.builder().role("model").parts(List.of(part1)).build();
        Content content2 = Content.builder().role("model").parts(List.of(part2)).build();
        Candidate candidate1 = Candidate.builder().content(content1).build();
        Candidate candidate2 = Candidate.builder().content(content2).build();
        GenerateContentResponse gcr1 = GenerateContentResponse.builder().candidates(List.of(candidate1)).build();
        GenerateContentResponse gcr2 = GenerateContentResponse.builder().candidates(List.of(candidate2)).build();
        GenerateContentResponse blankGcr = GenerateContentResponse.builder().candidates(List.of(Candidate.builder().content(Content.builder().role("model").parts(List.of(Part.fromText(""))).build()).build())).build();
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class)))
                .thenReturn(Optional.of(part1))
                .thenReturn(Optional.of(part2))
                .thenReturn(Optional.of(Part.fromText("")));
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(false, false, true);
            Flowable<LlmResponse> out = Gemini.processRawResponses(Flowable.just(gcr1, gcr2, blankGcr));
            List<LlmResponse> emissions = collect(out);
            assertEquals(4, ((List<LlmResponse>) emissions).size());
            assertEquals("A", emissions.get(0).content().get().parts().get(0).text().orElse(""));
            assertEquals("B", emissions.get(1).content().get().parts().get(0).text().orElse(""));
            assertEquals("AB", emissions.get(2).content().get().parts().get(0).text().orElse(""));
        }
    }
    @Test
    @Tag("valid")
    public void testProcessMixedThoughtAndTextChunksEmitsCorrectAggregation() {
        Part thoughtPart = Part.fromText("think").toBuilder().thought(true).build();
        Part textPart = Part.fromText("write");
        Content thoughtContent = Content.builder().role("model").parts(List.of(thoughtPart)).build();
        Content textContent = Content.builder().role("model").parts(List.of(textPart)).build();
        Candidate thoughtCandidate = Candidate.builder().content(thoughtContent).build();
        Candidate textCandidate = Candidate.builder().content(textContent).build();
        GenerateContentResponse gcr1 = GenerateContentResponse.builder().candidates(List.of(thoughtCandidate)).build();
        GenerateContentResponse gcr2 = GenerateContentResponse.builder().candidates(List.of(textCandidate)).build();
        GenerateContentResponse blankGcr = GenerateContentResponse.builder().candidates(List.of(Candidate.builder().content(Content.builder().role("model").parts(List.of(Part.fromText(""))).build()).build())).build();
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class)))
                .thenReturn(Optional.of(thoughtPart))
                .thenReturn(Optional.of(textPart))
                .thenReturn(Optional.of(Part.fromText("")));
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(false, false, true);
            Flowable<LlmResponse> out = Gemini.processRawResponses(Flowable.just(gcr1, gcr2, blankGcr));
            List<LlmResponse> emissions = collect(out);
            assertEquals(5, ((List<LlmResponse>) emissions).size());
            assertEquals("think", emissions.get(0).content().get().parts().get(0).text().orElse(""));
            assertEquals(true, emissions.get(0).content().get().parts().get(0).thought().orElse(false));
            assertEquals("write", emissions.get(1).content().get().parts().get(0).text().orElse(""));
            assertEquals(false, emissions.get(1).content().get().parts().get(0).thought().orElse(false));
            assertEquals("think", emissions.get(2).content().get().parts().get(0).text().orElse(""));
            assertEquals(true, emissions.get(2).content().get().parts().get(0).thought().orElse(false));
            assertEquals("write", emissions.get(3).content().get().parts().get(0).text().orElse(""));
        }
    }
    @Test
    @Tag("boundary")
    public void testProcessFinalStopCandidateEmitsRemainingAccumulated() {
        Part part = Part.fromText("accum1");
        // Use direct method call instead of FinishReason.builder()
        Candidate candidate = Candidate.builder().content(Content.builder().role("model").parts(List.of(part)).build())
                .finishReason(FinishReason.of(FinishReason.Known.STOP)).build();
        GenerateContentResponse gcr = GenerateContentResponse.builder().candidates(List.of(candidate)).build();
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class))).thenReturn(Optional.of(part));
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(false);
            Flowable<LlmResponse> out = Gemini.processRawResponses(Flowable.just(gcr));
            List<LlmResponse> emissions = collect(out);
            assertTrue(emissions.size() > 0);
            boolean foundAccum = emissions.stream()
                .anyMatch(lr -> (lr.content().isPresent() && lr.content().get().parts().stream().anyMatch(p -> p.text().orElse("").equals("accum1"))));
            assertTrue(foundAccum);
        }
    }
