        Candidate candidate = Candidate.builder().content(content).build();
        GenerateContentResponse response = GenerateContentResponse.builder().candidates(List.of(candidate)).build();
        try (MockedStatic<GeminiUtil> mockedUtil = Mockito.mockStatic(GeminiUtil.class)) {
