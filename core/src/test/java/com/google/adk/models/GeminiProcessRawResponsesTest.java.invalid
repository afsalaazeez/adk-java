    @Test
    @Tag("valid")
    public void testProcessSingleTextChunkEmitsPartialTextResponse() {
        Part part = Part.fromText("hello world");
        Content content = Content.builder().role("model").parts(List.of(part)).build();
        Candidate candidate = Candidate.builder().content(content).build();
        GenerateContentResponse gcr = GenerateContentResponse.builder().candidates(List.of(candidate)).build();
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            // Use reflection to access private static method responseFromText
            LlmResponse expected = invokeResponseFromText("hello world").toBuilder().partial(true).build();
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class))).thenReturn(Optional.of(part));
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(false);
            Flowable<LlmResponse> out = Gemini.processRawResponses(Flowable.just(gcr));
            List<LlmResponse> emissions = collect(out);
            assertEquals(1, ((List<LlmResponse>) emissions).size());
            assertEquals(expected.content(), emissions.get(0).content());
            assertEquals(Optional.of(true), emissions.get(0).partial());
        }
    }
