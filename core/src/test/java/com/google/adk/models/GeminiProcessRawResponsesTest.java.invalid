        Content c3 = Content.builder().role("model").parts(blankPart).build();
        Content c4 = Content.builder().role("model").parts(thoughtPart2).build();
        Candidate cand1 = Candidate.builder().content(c1).build();
        Candidate cand2 = Candidate.builder().content(c2).build();
        Candidate cand3 = Candidate.builder().content(c3).build();
        Candidate cand4 = Candidate.builder().content(c4).build();
        GenerateContentResponse r1 = GenerateContentResponse.builder().candidates(List.of(cand1)).build();
        GenerateContentResponse r2 = GenerateContentResponse.builder().candidates(List.of(cand2)).build();
        GenerateContentResponse r3 = GenerateContentResponse.builder().candidates(List.of(cand3)).build();
        GenerateContentResponse r4 = GenerateContentResponse.builder().candidates(List.of(cand4)).build();
        try (MockedStatic<GeminiUtil> mockedUtil = Mockito.mockStatic(GeminiUtil.class)) {
            mockedUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(Mockito.any()))
                .thenReturn(Optional.of(thoughtPart), Optional.of(regPart), Optional.of(blankPart), Optional.of(thoughtPart2));
            mockedUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(Mockito.any()))
                .thenReturn(false);
            Flowable<LlmResponse> actualFlowable = Gemini.processRawResponses(Flowable.just(r1, r2, r3, r4));
            List<LlmResponse> actualList = actualFlowable.toList().blockingGet();
            Assertions.assertEquals(4, ((List<LlmResponse>) actualList).size());
            Assertions.assertEquals("Thought1", ((List<LlmResponse>) actualList).get(0).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse(""));
            Assertions.assertEquals("Result1", ((List<LlmResponse>) actualList).get(1).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse(""));
            Assertions.assertEquals("", ((List<LlmResponse>) actualList).get(2).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse(""));
            Assertions.assertEquals("Thought2", ((List<LlmResponse>) actualList).get(3).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse(""));
        }
    }
    @Test
    @Tag("valid")
    public void testMissingPartHandledGracefully() {
        Candidate candidate = Candidate.builder().content(Content.builder().role("model").build()).build();
        GenerateContentResponse response = GenerateContentResponse.builder().candidates(List.of(candidate)).build();
        LlmResponse outputResponse = LlmResponse.create(response);
        try (MockedStatic<GeminiUtil> mockedUtil = Mockito.mockStatic(GeminiUtil.class)) {
            mockedUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(Mockito.any())).thenReturn(Optional.empty());
            Flowable<LlmResponse> actualFlowable = Gemini.processRawResponses(Flowable.just(response));
            List<LlmResponse> actualList = actualFlowable.toList().blockingGet();
            Assertions.assertEquals(1, ((List<LlmResponse>) actualList).size());
            Assertions.assertEquals(outputResponse.toBuilder().build().toBuilder().build(), ((List<LlmResponse>) actualList).get(0));
        }
    }
    @Test
    @Tag("boundary")
    public void testWhitespaceOnlyTextNotTreatedAsContent() {
        String whitespaceText = "   ";
        Part whitespacePart = Part.fromText(whitespaceText);
        Candidate candidate = Candidate.builder().content(Content.builder().role("model").parts(whitespacePart).build()).build();
        GenerateContentResponse response = GenerateContentResponse.builder().candidates(List.of(candidate)).build();
        try (MockedStatic<GeminiUtil> mockedUtil = Mockito.mockStatic(GeminiUtil.class)) {
            mockedUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(Mockito.any())).thenReturn(Optional.of(whitespacePart));
            mockedUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(Mockito.any())).thenReturn(true);
            Flowable<LlmResponse> actualFlowable = Gemini.processRawResponses(Flowable.just(response));
            List<LlmResponse> actualList = actualFlowable.toList().blockingGet();
            Assertions.assertEquals(1, ((List<LlmResponse>) actualList).size());
            Assertions.assertTrue(((List<LlmResponse>) actualList).get(0).content().flatMap(Content::parts).flatMap(parts -> parts.stream().findFirst()).flatMap(Part::text).orElse("").isBlank());
        }
    }
    @Test
    @Tag("integration")
    public void testInterleavedThoughtNonThoughtWithBlanks() {
        Part t1 = Part.fromText("t1").toBuilder().thought(true).build();
        Part r1 = Part.fromText("r1");
        Part blank = Part.fromText("");
        Part t2 = Part.fromText("t2").toBuilder().thought(true).build();
        Candidate candT1 = Candidate.builder().content(Content.builder().role("model").parts(t1).build()).build();
        Candidate candR1 = Candidate.builder().content(Content.builder().role("model").parts(r1).build()).build();
        Candidate candBlank = Candidate.builder().content(Content.builder().role("model").parts(blank).build()).build();
        Candidate candT2 = Candidate.builder().content(Content.builder().role("model").parts(t2).build()).build();
        GenerateContentResponse respT1 = GenerateContentResponse.builder().candidates(List.of(candT1)).build();
        GenerateContentResponse respR1 = GenerateContentResponse.builder().candidates(List.of(candR1)).build();
        GenerateContentResponse respBlank = GenerateContentResponse.builder().candidates(List.of(candBlank)).build();
        GenerateContentResponse respT2 = GenerateContentResponse.builder().candidates(List.of(candT2)).build();
        try (MockedStatic<GeminiUtil> mockedUtil = Mockito.mockStatic(GeminiUtil.class)) {
            mockedUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(Mockito.any()))
                .thenReturn(Optional.of(t1), Optional.of(r1), Optional.of(blank), Optional.of(t2));
            mockedUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(Mockito.any()))
                .thenReturn(true, true, true, true);
            Flowable<LlmResponse> actualFlowable = Gemini.processRawResponses(Flowable.just(respT1, respR1, respBlank, respT2, respBlank));
            List<LlmResponse> actualList = actualFlowable.toList().blockingGet();
            List<String> outputTexts = new ArrayList<>();
            for (LlmResponse resp : ((List<LlmResponse>) actualList)) {
                resp.content().flatMap(Content::parts).ifPresent(parts -> {
                    parts.stream().findFirst().flatMap(Part::text).ifPresent(outputTexts::add);
                });
            }
            Assertions.assertTrue(outputTexts.contains("t1"));
            Assertions.assertTrue(outputTexts.contains("r1"));
            Assertions.assertTrue(outputTexts.contains("t2"));
        }
    }
    @Test
    @Tag("boundary")
    public void testStopFinishReasonWithNoAccumulatedYieldsNothing() {
        Candidate candidateStop = Candidate.builder()
            .finishReason(FinishReason.ofKnown(FinishReason.Known.STOP))
            .content(Content.builder().role("model").parts(Part.fromText("")).build()).build();
        GenerateContentResponse responseStop = GenerateContentResponse.builder().candidates(List.of(candidateStop)).build();
