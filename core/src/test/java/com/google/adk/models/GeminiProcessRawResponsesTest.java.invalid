    @Test
    @Tag("valid")
    public void testMultipleBlankChunksCauseSelectiveEmissionUponTrigger() {
        Part part = Part.fromText("X");
        Candidate candidate = Candidate.builder().content(Content.builder().role("model").parts(List.of(part)).build()).build();
        GenerateContentResponse gcr = GenerateContentResponse.builder().candidates(List.of(candidate)).build();
        GenerateContentResponse blankGcr = GenerateContentResponse.builder().candidates(List.of(Candidate.builder().content(Content.builder().role("model").parts(List.of(Part.fromText(""))).build()).build())).build();
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class)))
                .thenReturn(Optional.of(part))
                .thenReturn(Optional.of(Part.fromText("")))
                .thenReturn(Optional.of(Part.fromText("")));
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(false, true, false);
            Flowable<LlmResponse> out = Gemini.processRawResponses(Flowable.just(gcr, blankGcr, blankGcr));
            List<LlmResponse> emissions = collect(out);
            assertTrue(emissions.stream().anyMatch(lr -> lr.content().isPresent() && lr.content().get().parts().stream().anyMatch(p -> p.text().orElse("").equals("X"))));
        }
    }
    @Test
    @Tag("valid")
    public void testTextChunkWithFunctionCallProcessesLikeTextChunk() {
        Part part = Part.fromText("abc");
        Content content = Content.builder().role("model").parts(List.of(part)).build();
        Candidate candidate = Candidate.builder().content(content).build();
        GenerateContentResponse gcr = GenerateContentResponse.builder().candidates(List.of(candidate)).build();
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            LlmResponse expected = invokeResponseFromText("abc").toBuilder().partial(true).build();
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class))).thenReturn(Optional.of(part));
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(false);
            Flowable<LlmResponse> out = Gemini.processRawResponses(Flowable.just(gcr));
            List<LlmResponse> emissions = collect(out);
            assertEquals(1, emissions.size());
            assertEquals(expected.content().get().parts().get(0).text().orElse(""), emissions.get(0).content().get().parts().get(0).text().orElse(""));
        }
    }
    @Test
    @Tag("invalid")
    public void testErrorInInputStreamPropagatesAndHaltsProcessing() {
        GenerateContentResponse gcr = GenerateContentResponse.builder().build();
        Flowable<GenerateContentResponse> erroneousFlowable = Flowable.just(gcr).concatWith(Flowable.error(new RuntimeException("fail")));
        try (MockedStatic<GeminiUtil> mockUtil = mockStatic(GeminiUtil.class)) {
            mockUtil.when(() -> GeminiUtil.getPart0FromLlmResponse(any(LlmResponse.class))).thenReturn(Optional.empty());
            mockUtil.when(() -> GeminiUtil.shouldEmitAccumulatedText(any(LlmResponse.class))).thenReturn(false);
            assertThrows(RuntimeException.class, () -> {
                collect(Gemini.processRawResponses(erroneousFlowable));
            });
        }
    }
    @Test
    @Tag("valid")
    public void testMultiCandidateStopFinishReasonEvaluatesFirstCandidate() {
        Candidate firstStop = Candidate.builder().finishReason(FinishReason.of(FinishReason.Known.STOP)).build();
        Candidate secondNonStop = Candidate.builder().build();
        GenerateContentResponse gcr = GenerateContentResponse.builder().candidates(List.of(firstStop, secondNonStop)).build();
