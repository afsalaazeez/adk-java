    @Test
    @Tag("boundary")
    public void testProcessEmptyStreamProducesNoResponses() {
        Flowable<GenerateContentResponse> emptyFlowable = Flowable.empty();
        Flowable<LlmResponse> result = Gemini.processRawResponses(emptyFlowable);
