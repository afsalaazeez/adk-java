package com.google.adk.memory;
import static com.google.common.truth.Truth.assertThat;
import static org.junit.jupiter.api.Assertions.assertThrows;
import com.google.common.collect.ImmutableList;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.*;
import com.google.auto.value.AutoValue;

class SearchMemoryResponseMemoriesTest {
  private MemoryEntry createMemoryEntry(String contentText, String author, String timestamp) {
    // NOTE: Content class needs to be imported or defined. Assuming it's in the same package.
    // If Content.builder() is not available, the business logic needs to provide a proper way to create Content objects.
    com.google.adk.memory.Content content = com.google.adk.memory.Content.builder().setText(contentText).build();
    return MemoryEntry.builder()
        .setContent(content)
        .setAuthor(author)
        .setTimestamp(timestamp)
        .build();
  }
  @Test
  @Tag("valid")
  void memoriesReturnsMultipleMemoryEntries() {
    MemoryEntry entry1 = createMemoryEntry("Content 1", "Author 1", "2024-01-01T10:00:00Z");
    MemoryEntry entry2 = createMemoryEntry("Content 2", "Author 2", "2024-01-02T10:00:00Z");
    MemoryEntry entry3 = createMemoryEntry("Content 3", "Author 3", "2024-01-03T10:00:00Z");
    MemoryEntry entry4 = createMemoryEntry("Content 4", "Author 4", "2024-01-04T10:00:00Z");
    MemoryEntry entry5 = createMemoryEntry("Content 5", "Author 5", "2024-01-05T10:00:00Z");
    SearchMemoryResponse response =
        SearchMemoryResponse.builder()
            .setMemories(ImmutableList.of(entry1, entry2, entry3, entry4, entry5))
            .build();
    ImmutableList<MemoryEntry> memories = response.memories();
    assertThat(memories).isNotNull();
    assertThat(memories).hasSize(5);
    assertThat(memories).containsExactly(entry1, entry2, entry3, entry4, entry5).inOrder();
  }
  @Test
  @Tag("valid")
  void memoriesReturnsSingleMemoryEntry() {
    MemoryEntry entry = createMemoryEntry("Single Content", "Single Author", "2024-01-01T10:00:00Z");
    SearchMemoryResponse response =
        SearchMemoryResponse.builder().setMemories(ImmutableList.of(entry)).build();
    ImmutableList<MemoryEntry> memories = response.memories();
    assertThat(memories).isNotNull();
    assertThat(memories).hasSize(1);
    assertThat(memories).containsExactly(entry);
  }
  @Test
  @Tag("boundary")
  void memoriesReturnsEmptyListWhenNoMemoriesSet() {
    SearchMemoryResponse response = SearchMemoryResponse.builder().build();
    ImmutableList<MemoryEntry> memories = response.memories();
    assertThat(memories).isNotNull();
    assertThat(memories).isEmpty();
    assertThat(memories).hasSize(0);
  }
  @Test
  @Tag("valid")
  void memoriesReturnsImmutableList() {
    MemoryEntry entry1 = createMemoryEntry("Content 1", "Author 1", "2024-01-01T10:00:00Z");
    MemoryEntry entry2 = createMemoryEntry("Content 2", "Author 2", "2024-01-02T10:00:00Z");
    SearchMemoryResponse response =
        SearchMemoryResponse.builder().setMemories(ImmutableList.of(entry1, entry2)).build();
    ImmutableList<MemoryEntry> memories = response.memories();
    assertThrows(UnsupportedOperationException.class, () -> memories.add(entry1));
    assertThrows(UnsupportedOperationException.class, () -> memories.remove(0));
    assertThrows(UnsupportedOperationException.class, () -> memories.clear());
    assertThat(memories).hasSize(2);
    assertThat(memories).containsExactly(entry1, entry2).inOrder();
  }
  @Test
  @Tag("valid")
  void memoriesReturnsConsistentResultsOnMultipleCalls() {
    MemoryEntry entry1 = createMemoryEntry("Content 1", "Author 1", "2024-01-01T10:00:00Z");
    MemoryEntry entry2 = createMemoryEntry("Content 2", "Author 2", "2024-01-02T10:00:00Z");
    MemoryEntry entry3 = createMemoryEntry("Content 3", "Author 3", "2024-01-03T10:00:00Z");
    SearchMemoryResponse response =
        SearchMemoryResponse.builder()
            .setMemories(ImmutableList.of(entry1, entry2, entry3))
            .build();
    ImmutableList<MemoryEntry> memories1 = response.memories();
    ImmutableList<MemoryEntry> memories2 = response.memories();
    ImmutableList<MemoryEntry> memories3 = response.memories();
    ImmutableList<MemoryEntry> memories4 = response.memories();
    ImmutableList<MemoryEntry> memories5 = response.memories();
    assertThat(memories1).isEqualTo(memories2);
    assertThat(memories2).isEqualTo(memories3);
    assertThat(memories3).isEqualTo(memories4);
    assertThat(memories4).isEqualTo(memories5);
    assertThat(memories1).hasSize(3);
    assertThat(memories1).containsExactly(entry1, entry2, entry3).inOrder();
  }
  @Test
  @Tag("valid")
  void memoriesPreservesInsertionOrder() {
    MemoryEntry entry1 = createMemoryEntry("First", "Author 1", "2024-01-01T10:00:00Z");
    MemoryEntry entry2 = createMemoryEntry("Second", "Author 2", "2024-01-02T10:00:00Z");
    MemoryEntry entry3 = createMemoryEntry("Third", "Author 3", "2024-01-03T10:00:00Z");
    MemoryEntry entry4 = createMemoryEntry("Fourth", "Author 4", "2024-01-04T10:00:00Z");
    SearchMemoryResponse response =
        SearchMemoryResponse.builder()
            .setMemories(ImmutableList.of(entry1, entry2, entry3, entry4))
            .build();
    ImmutableList<MemoryEntry> memories = response.memories();
    assertThat(memories).hasSize(4);
    assertThat(memories.get(0)).isEqualTo(entry1);
    assertThat(memories.get(1)).isEqualTo(entry2);
    assertThat(memories.get(2)).isEqualTo(entry3);
    assertThat(memories.get(3)).isEqualTo(entry4);
    assertThat(memories).containsExactly(entry1, entry2, entry3, entry4).inOrder();
  }
  @Test
  @Tag("valid")
  void memoriesReturnsEntriesWhenBuiltWithList() {
    MemoryEntry entry1 = createMemoryEntry("Content 1", "Author 1", "2024-01-01T10:00:00Z");
    MemoryEntry entry2 = createMemoryEntry("Content 2", "Author 2", "2024-01-02T10:00:00Z");
    MemoryEntry entry3 = createMemoryEntry("Content 3", "Author 3", "2024-01-03T10:00:00Z");
    List<MemoryEntry> mutableList = new ArrayList<>();
    mutableList.add(entry1);
    mutableList.add(entry2);
    mutableList.add(entry3);
    SearchMemoryResponse response =
        SearchMemoryResponse.builder().setMemories(mutableList).build();
    mutableList.add(createMemoryEntry("Content 4", "Author 4", "2024-01-04T10:00:00Z"));
    mutableList.remove(0);
    ImmutableList<MemoryEntry> memories = response.memories();
    assertThat(memories).hasSize(3);
    assertThat(memories).containsExactly(entry1, entry2, entry3).inOrder();
  }
  @Test
  @Tag("invalid")
  void memoriesHandlesListContainingNullEntries() {
    MemoryEntry entry1 = createMemoryEntry("Content 1", "Author 1", "2024-01-01T10:00:00Z");
    MemoryEntry entry2 = createMemoryEntry("Content 2", "Author 2", "2024-01-02T10:00:00Z");
    List<MemoryEntry> listWithNulls = new ArrayList<>();
    listWithNulls.add(entry1);
    listWithNulls.add(null);
    listWithNulls.add(entry2);
    assertThrows(
        NullPointerException.class,
        () -> SearchMemoryResponse.builder().setMemories(listWithNulls).build());
  }
  @Test
  @Tag("valid")
  void memoriesReturnsIndependentCopyNotAffectedByBuilderChanges() {
    MemoryEntry entry1 = createMemoryEntry("Content 1", "Author 1", "2024-01-01T10:00:00Z");
    MemoryEntry entry2 = createMemoryEntry("Content 2", "Author 2", "2024-01-02T10:00:00Z");
    List<MemoryEntry> mutableList = new ArrayList<>();
    mutableList.add(entry1);
    mutableList.add(entry2);
    SearchMemoryResponse response =
        SearchMemoryResponse.builder().setMemories(mutableList).build();
    mutableList.add(createMemoryEntry("Content 3", "Author 3", "2024-01-03T10:00:00Z"));
    mutableList.remove(entry1);
    mutableList.clear();
    ImmutableList<MemoryEntry> memories = response.memories();
    assertThat(memories).hasSize(2);
    assertThat(memories).containsExactly(entry1, entry2).inOrder();
  }
  @Test
  @Tag("valid")
  void memoriesHandlesLargeNumberOfEntries() {
    List<MemoryEntry> largeList = new ArrayList<>();
    for (int i = 0; i < 10000; i++) {
      largeList.add(
          createMemoryEntry(
              "Content " + i, "Author " + i, "2024-01-01T10:00:00Z"));
    }
    SearchMemoryResponse response =
        SearchMemoryResponse.builder().setMemories(largeList).build();
    ImmutableList<MemoryEntry> memories = response.memories();
    assertThat(memories).isNotNull();
    assertThat(memories).hasSize(10000);
    assertThat(memories.get(0).content().text()).isEqualTo("Content 0");
    assertThat(memories.get(9999).content().text()).isEqualTo("Content 9999");
  }
  @Test
  @Tag("valid")
  void memoriesReturnsCorrectGenericType() {
    MemoryEntry entry1 = createMemoryEntry("Content 1", "Author 1", "2024-01-01T10:00:00Z");
    MemoryEntry entry2 = createMemoryEntry("Content 2", "Author 2", "2024-01-02T10:00:00Z");
    SearchMemoryResponse response =
        SearchMemoryResponse.builder().setMemories(ImmutableList.of(entry1, entry2)).build();
    ImmutableList<MemoryEntry> memories = response.memories();
    assertThat(memories).isNotNull();
    for (MemoryEntry entry : memories) {
      assertThat(entry).isInstanceOf(MemoryEntry.class);
      assertThat(entry.content()).isNotNull();
      assertThat(entry.author()).isNotNull();
      assertThat(entry.timestamp()).isNotNull();
    }
  }
  @Test
  @Tag("boundary")
  void memoriesReturnsEmptyListWhenExplicitlySetToEmpty() {
    List<MemoryEntry> emptyList = Collections.emptyList();
    SearchMemoryResponse response =
        SearchMemoryResponse.builder().setMemories(emptyList).build();
    ImmutableList<MemoryEntry> memories = response.memories();
    assertThat(memories).isNotNull();
    assertThat(memories).isEmpty();
    assertThat(memories).hasSize(0);
  }
}