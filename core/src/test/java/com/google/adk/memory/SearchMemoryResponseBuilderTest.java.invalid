import com.google.auto.value.AutoValue;
import java.util.List;

class SearchMemoryResponseBuilderTest {
  @Test
  @Tag("valid")
  void builder_shouldReturnNonNullBuilder() {
    SearchMemoryResponse.Builder builder = SearchMemoryResponse.builder();
    
    assertThat(builder).isNotNull();
  }
  @Test
  @Tag("valid")
  void builder_shouldCreateBuilderWithEmptyMemoriesByDefault() {
    SearchMemoryResponse.Builder builder = SearchMemoryResponse.builder();
    SearchMemoryResponse response = builder.build();
    
    assertThat(response.memories()).isNotNull();
    assertThat(response.memories()).isEmpty();
  }
  @Test
  @Tag("valid")
  void builder_shouldAllowSettingMemoriesWithImmutableList() {
    MemoryEntry entry = MemoryEntry.builder()
        .setContent(createDummyContent())
        .setAuthor("test-author")
        .setTimestamp("2024-01-01T00:00:00Z")
        .build();
    
    SearchMemoryResponse response = SearchMemoryResponse.builder()
        .setMemories(ImmutableList.of(entry))
        .build();
    
    assertThat(response.memories()).hasSize(1);
    assertThat(response.memories().get(0)).isEqualTo(entry);
  }
  @Test
  @Tag("valid")
  void builder_shouldAllowSettingMemoriesWithList() {
    MemoryEntry entry1 = MemoryEntry.builder()
        .setContent(createDummyContent())
        .setAuthor("author1")
        .setTimestamp("2024-01-01T00:00:00Z")
        .build();
    MemoryEntry entry2 = MemoryEntry.builder()
        .setContent(createDummyContent())
        .setAuthor("author2")
        .setTimestamp("2024-01-02T00:00:00Z")
        .build();
    
    SearchMemoryResponse response = SearchMemoryResponse.builder()
        .setMemories(java.util.Arrays.asList(entry1, entry2))
        .build();
    
    assertThat(response.memories()).hasSize(2);
    assertThat(response.memories()).containsExactly(entry1, entry2).inOrder();
  }
  @Test
  @Tag("valid")
  void builder_shouldAllowMultipleBuilderInstances() {
    SearchMemoryResponse.Builder builder1 = SearchMemoryResponse.builder();
    SearchMemoryResponse.Builder builder2 = SearchMemoryResponse.builder();
    
    assertThat(builder1).isNotNull();
    assertThat(builder2).isNotNull();
    assertThat(builder1).isNotSameInstanceAs(builder2);
  }
  @Test
  @Tag("boundary")
  void builder_shouldHandleEmptyMemoriesList() {
    SearchMemoryResponse response = SearchMemoryResponse.builder()
        .setMemories(ImmutableList.of())
        .build();
    
    assertThat(response.memories()).isEmpty();
  }
  @Test
  @Tag("valid")
  void builder_shouldHandleSingleMemoryEntry() {
    MemoryEntry entry = MemoryEntry.builder()
        .setContent(createDummyContent())
        .setAuthor("single-author")
        .setTimestamp("2024-01-01T00:00:00Z")
        .build();
    
    SearchMemoryResponse response = SearchMemoryResponse.builder()
        .setMemories(ImmutableList.of(entry))
        .build();
    
    assertThat(response.memories()).hasSize(1);
  }
  @Test
  @Tag("valid")
  void builder_shouldHandleMultipleMemoryEntries() {
    ImmutableList.Builder<MemoryEntry> entriesBuilder = ImmutableList.builder();
    for (int i = 0; i < 10; i++) {
      entriesBuilder.add(MemoryEntry.builder()
          .setContent(createDummyContent())
          .setAuthor("author-" + i)
          .setTimestamp("2024-01-0" + (i + 1) + "T00:00:00Z")
          .build());
    }
    
    SearchMemoryResponse response = SearchMemoryResponse.builder()
        .setMemories(entriesBuilder.build())
        .build();
    
    assertThat(response.memories()).hasSize(10);
  }
  @Test
  @Tag("valid")
  void builder_shouldOverwritePreviousMemoriesWhenSetMultipleTimes() {
    MemoryEntry entry1 = MemoryEntry.builder()
        .setContent(createDummyContent())
        .setAuthor("author1")
        .setTimestamp("2024-01-01T00:00:00Z")
        .build();
    MemoryEntry entry2 = MemoryEntry.builder()
        .setContent(createDummyContent())
        .setAuthor("author2")
        .setTimestamp("2024-01-02T00:00:00Z")
        .build();
    
    SearchMemoryResponse response = SearchMemoryResponse.builder()
        .setMemories(ImmutableList.of(entry1))
