    assertThat(response.memories()).hasSize(1);
    assertThat(response.memories().get(0)).isEqualTo(entry2);
  }
  @Test
  @Tag("valid")
  void builder_shouldCreateImmutableMemoriesList() {
    MemoryEntry entry = MemoryEntry.builder()
        .setContent(createDummyContent())
        .setAuthor("test-author")
        .setTimestamp("2024-01-01T00:00:00Z")
        .build();
    
    SearchMemoryResponse response = SearchMemoryResponse.builder()
