        when(content1.parts()).thenReturn(Optional.of(Collections.emptyList()));
        when(e.content()).thenReturn(Optional.of(content1));
        Session session = mock(Session.class);
        when(session.appName()).thenReturn(appName);
        when(session.userId()).thenReturn(userId);
        when(session.id()).thenReturn(sessionId);
        when(session.events()).thenReturn(List.of(e));
        service.addSessionToMemory(session).blockingAwait();
        List<Event> actual = ((Map<String, List<Event>>) service.getSessionEvents().get(appName + "/" + userId)).get(sessionId);
        assertEquals((List<Event>) Collections.emptyList(), actual, "Session should contain empty list with only events having empty parts");
    }
    @Test
    @Tag("valid")
    public void testAddSessionWhenSessionEventsMapIsEmpty() throws Exception {
        String appName = "firstApp";
        String userId = "firstUser";
        String sessionId = "firstSession";
        assertTrue(service.getSessionEvents().isEmpty(), "sessionEvents should be empty initially");
        Event e = mock(Event.class);
        Part p = mock(Part.class);
        when(p.text()).thenReturn(Optional.of("vmsg"));
        var c = mock(com.google.genai.types.Content.class);
        when(c.parts()).thenReturn(Optional.of(List.of(p)));
        when(e.content()).thenReturn(Optional.of(c));
        Session session = mock(Session.class);
        when(session.appName()).thenReturn(appName);
        when(session.userId()).thenReturn(userId);
        when(session.id()).thenReturn(sessionId);
        when(session.events()).thenReturn(List.of(e));
        service.addSessionToMemory(session).blockingAwait();
        String key = appName + "/" + userId;
        assertTrue(service.getSessionEvents().containsKey(key), "sessionEvents should now contain the user after insertion");
        assertEquals((List<Event>) List.of(e), ((Map<String, List<Event>>) service.getSessionEvents().get(key)).get(sessionId), "Events should match inserted one");
    }
    @Test
    @Tag("valid")
    public void testAddSessionWithDuplicateEvents() throws Exception {
        String appName = "dupEv";
        String userId = "dupEvUser";
        String sessionId = "dupEvSid";
        Event e = mock(Event.class);
        Part part = mock(Part.class);
        when(part.text()).thenReturn(Optional.of("keep me"));
        var cont = mock(com.google.genai.types.Content.class);
        when(cont.parts()).thenReturn(Optional.of(List.of(part)));
        when(e.content()).thenReturn(Optional.of(cont));
        Session session = mock(Session.class);
        when(session.appName()).thenReturn(appName);
        when(session.userId()).thenReturn(userId);
        when(session.id()).thenReturn(sessionId);
        when(session.events()).thenReturn(List.of(e, e, e));
        service.addSessionToMemory(session).blockingAwait();
        List<Event> actual = ((Map<String, List<Event>>) service.getSessionEvents().get(appName + "/" + userId)).get(sessionId);
        assertEquals((List<Event>)List.of(e, e, e), actual, "All duplicates must be stored; no deduplication occurs");
    }
    @Test
    @Tag("integration")
    public void testAddSessionsConcurrently() throws Exception {
        // Multiple threads, same service instance, overlapping keys
        String app = "conc";
        Runnable r1 = () -> {
            Event e1 = mock(Event.class);
            Part p1 = mock(Part.class);
            when(p1.text()).thenReturn(Optional.of("thread 1 msg"));
            var c1 = mock(com.google.genai.types.Content.class);
            when(c1.parts()).thenReturn(Optional.of(List.of(p1)));
            when(e1.content()).thenReturn(Optional.of(c1));
            Session s1 = mock(Session.class);
            when(s1.appName()).thenReturn(app);
            when(s1.userId()).thenReturn("u1");
            when(s1.id()).thenReturn("t1");
            when(s1.events()).thenReturn(List.of(e1));
            service.addSessionToMemory(s1).blockingAwait();
        };
        Runnable r2 = () -> {
            Event e2 = mock(Event.class);
            Part p2 = mock(Part.class);
            when(p2.text()).thenReturn(Optional.of("msg"));
            var c2 = mock(com.google.genai.types.Content.class);
            when(c2.parts()).thenReturn(Optional.of(List.of(p2)));
            when(e2.content()).thenReturn(Optional.of(c2));
            Session s2 = mock(Session.class);
            when(s2.appName()).thenReturn(app);
            when(s2.userId()).thenReturn("u1");
            when(s2.id()).thenReturn("t2");
            when(s2.events()).thenReturn(List.of(e2));
            service.addSessionToMemory(s2).blockingAwait();
        };
        Runnable r3 = () -> {
            Event e3 = mock(Event.class);
            Part p3 = mock(Part.class);
            when(p3.text()).thenReturn(Optional.of("B"));
            var c3 = mock(com.google.genai.types.Content.class);
            when(c3.parts()).thenReturn(Optional.of(List.of(p3)));
            when(e3.content()).thenReturn(Optional.of(c3));
            Session s3 = mock(Session.class);
            when(s3.appName()).thenReturn(app);
            when(s3.userId()).thenReturn("u2");
            when(s3.id()).thenReturn("t3");
            when(s3.events()).thenReturn(List.of(e3));
            service.addSessionToMemory(s3).blockingAwait();
        };
        Thread th1 = new Thread(r1);
        Thread th2 = new Thread(r2);
        Thread th3 = new Thread(r3);
        th1.start(); th2.start(); th3.start();
        th1.join(); th2.join(); th3.join();
        assertTrue(service.getSessionEvents().containsKey("conc/u1"), "Concurrent insert: Key for u1 must exist");
        assertEquals(2, ((Map<String, List<Event>>) service.getSessionEvents().get("conc/u1")).size(), "Two sessions for u1 (concurrent)");
        assertTrue(service.getSessionEvents().containsKey("conc/u2"), "Concurrent insert: Key for u2 must exist");
        assertEquals(1, ((Map<String, List<Event>>) service.getSessionEvents().get("conc/u2")).size(), "One session for u2 (concurrent)");
    }
    @Test
    @Tag("invalid")
    public void testAddSessionWithNullSession() {
        assertThrows(NullPointerException.class, () -> service.addSessionToMemory(null).blockingAwait());
    }
    @Test
    @Tag("boundary")
    public void testAddSessionWithEventsHavingNullParts() throws Exception {
        String appName = "nullPartsApp";
        String userId = "nullPartsUser";
        String sessionId = "nullPartsSid";
        Event e1 = mock(Event.class);
        var content = mock(com.google.genai.types.Content.class);
        when(content.parts()).thenReturn(null); // This is an error, illegal, but we test it
        when(e1.content()).thenReturn(Optional.of(content));
        Session session = mock(Session.class);
        when(session.appName()).thenReturn(appName);
        when(session.userId()).thenReturn(userId);
        when(session.id()).thenReturn(sessionId);
        when(session.events()).thenReturn(List.of(e1));
        assertThrows(NullPointerException.class, () -> service.addSessionToMemory(session).blockingAwait());
        // Because .flatMap(...).filter(...) will call .isPresent() on null.
    }
