        when(normalContent.parts()).thenReturn(Optional.of(List.of(normalPart)));
        when(normalEvent.content()).thenReturn(Optional.of(normalContent));
        Session session = mock(Session.class);
        when(session.appName()).thenReturn(appName);
        when(session.userId()).thenReturn(userId);
        when(session.id()).thenReturn(sessionId);
        when(session.events()).thenReturn(List.of(emptyEvent, normalEvent));
        service.addSessionToMemory(session).blockingAwait();
        List<Event> actual = ((Map<String, List<Event>>) service.getSessionEvents().get(appName + "/" + userId)).get(sessionId);
        assertEquals((List<Event>) List.of(normalEvent), actual, "Only valid event with content should be persisted");
    }
    @Test
    @Tag("boundary")
    public void testAddSessionWithEventsHavingEmptyParts() throws Exception {
        String appName = "emptyParts";
        String userId = "emptyPartsU";
        String sessionId = "s";
