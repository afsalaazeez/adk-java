    @Test
    @Tag("valid")
    public void testOverwriteExistingSessionWithSameSessionId() throws Exception {
        String appName = "myApp";
        String userId = "myUser";
        String sessionId = "sId";
        // Initial Event
        Event event1 = mock(Event.class);
        Part part1 = mock(Part.class);
        when(part1.text()).thenReturn(Optional.of("first"));
        var content1 = mock(com.google.genai.types.Content.class);
        when(content1.parts()).thenReturn(Optional.of(List.of(part1)));
        when(event1.content()).thenReturn(Optional.of(content1));
        Session session1 = mock(Session.class);
        when(session1.appName()).thenReturn(appName);
        when(session1.userId()).thenReturn(userId);
        when(session1.id()).thenReturn(sessionId);
        when(session1.events()).thenReturn(List.of(event1));
        // Different Event (same sessionId)
        Event event2 = mock(Event.class);
        Part part2 = mock(Part.class);
        when(part2.text()).thenReturn(Optional.of("new second"));
        var content2 = mock(com.google.genai.types.Content.class);
        when(content2.parts()).thenReturn(Optional.of(List.of(part2)));
        when(event2.content()).thenReturn(Optional.of(content2));
        Session session2 = mock(Session.class);
        when(session2.appName()).thenReturn(appName);
        when(session2.userId()).thenReturn(userId);
        when(session2.id()).thenReturn(sessionId);
        when(session2.events()).thenReturn(List.of(event2));
        service.addSessionToMemory(session1).blockingAwait();
        service.addSessionToMemory(session2).blockingAwait();
        String key = appName + "/" + userId;
        List<Event> events = ((Map<String, List<Event>>) service.getSessionEvents().get(key)).get(sessionId);
        assertEquals((List<Event>) List.of(event2), events, "Session must be overwritten on second put");
    }
    @Test
    @Tag("boundary")
    public void testAddSessionWithNullOrEmptyEvents() throws Exception {
        String appName = "App";
        String userId = "User";
        String sessionId = "eSession";
        // Session with null events (edge case)
        Session nullEventsSession = mock(Session.class);
        when(nullEventsSession.appName()).thenReturn(appName);
        when(nullEventsSession.userId()).thenReturn(userId);
        when(nullEventsSession.id()).thenReturn(sessionId);
        when(nullEventsSession.events()).thenReturn(null);
        // Session with empty events
        Session emptyEventsSession = mock(Session.class);
        when(emptyEventsSession.appName()).thenReturn(appName);
        when(emptyEventsSession.userId()).thenReturn(userId);
        when(emptyEventsSession.id()).thenReturn("eSession2"); // TODO: Optionally vary the sessionId if you want
        when(emptyEventsSession.events()).thenReturn(Collections.emptyList());
        // Null events - should handle with NPE or treat as empty
        assertThrows(NullPointerException.class, () -> service.addSessionToMemory(nullEventsSession).blockingAwait());
        // Empty events - stores empty
        service.addSessionToMemory(emptyEventsSession).blockingAwait();
        Map<String, List<Event>> actual = (Map<String, List<Event>>) service.getSessionEvents().get(appName + "/" + userId);
        assertTrue(actual.containsKey("eSession2"), "Should insert session for empty event list");
        assertEquals((List<Event>) Collections.emptyList(), actual.get("eSession2"), "Events list should be empty if session.events() is empty");
    }
