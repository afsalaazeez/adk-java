class InMemoryMemoryServiceAddSessionToMemoryTest {
    private InMemoryMemoryService service;
    @BeforeEach
    void setUp() {
        service = new InMemoryMemoryService();
    }
    @Test
    @Tag("valid")
    public void testAddSessionWithOnlyNonEmptyEvents() throws Exception {
        String appName = "appX";
        String userId = "userY";
        String sessionId = "sess1";
        Event event1 = mock(Event.class);
        Part part1 = mock(Part.class);
        when(part1.text()).thenReturn(Optional.of("Hello there!"));
        var content1 = mock(com.google.genai.types.Content.class);
        when(content1.parts()).thenReturn(Optional.of(List.of(part1)));
        when(event1.content()).thenReturn(Optional.of(content1));
        Event event2 = mock(Event.class);
        Part part2 = mock(Part.class);
        when(part2.text()).thenReturn(Optional.of("Another message"));
        var content2 = mock(com.google.genai.types.Content.class);
        when(content2.parts()).thenReturn(Optional.of(List.of(part2)));
        when(event2.content()).thenReturn(Optional.of(content2));
        Session session = mock(Session.class);
        when(session.appName()).thenReturn(appName);
        when(session.userId()).thenReturn(userId);
        when(session.id()).thenReturn(sessionId);
        when(session.events()).thenReturn(List.of(event1, event2));
        service.addSessionToMemory(session).blockingAwait();
        String key = appName + "/" + userId;
        Map<String, List<Event>> actualMap = (Map<String, List<Event>>) service.getSessionEvents().get(key);
        assertNotNull(actualMap, "sessionEvents should contain the userKey");
        assertTrue(actualMap.containsKey(sessionId), "Session map should contain the correct sessionId");
        List<Event> actual = actualMap.get(sessionId);
        assertEquals((List<Event>) List.of(event1, event2), actual, "All non-empty events must be stored for the session");
    }
