    @Test
    @Tag("integration")
    @DisplayName("Scenario 10: Concurrent Addition of Sessions for the Same User")
    public void testConcurrentSessionAddition() throws InterruptedException {
        String appName = "concurrentApp";
        String userId = "concurrentUser";
        int numThreads = 5; // TODO: Change for extensive concurrency test
        List<Thread> threads = new ArrayList<>();
        List<String> sessionIds = new ArrayList<>();
        List<Session> sessions = new ArrayList<>();
        for (int i = 0; i < numThreads; i++) {
            String sessionId = "threadSession" + i;
            sessionIds.add(sessionId);
            List<Part> parts = Collections.singletonList(Mockito.mock(Part.class));
            Event event = mockEventWithParts(parts, true);
            Session session = mockSession(appName, userId, sessionId, ImmutableList.of(event));
            sessions.add(session);
        }
        for (int i = 0; i < numThreads; i++) {
            final Session session = sessions.get(i);
            Thread thread = new Thread(() -> memoryService.addSessionToMemory(session).blockingAwait());
            threads.add(thread);
            thread.start();
        }
        for (Thread thread : threads) {
            thread.join();
        }
        String key = appName + "/" + userId;
        Map<String, List<Event>> userSessions = (Map<String, List<Event>>) ((ConcurrentHashMap<String, Map<String, List<Event>>>)memoryService.sessionEvents).get(key);
        assertNotNull(userSessions);
        for (int i = 0; i < numThreads; i++) {
            String sessionId = sessionIds.get(i);
            List<Event> events = (List<Event>) userSessions.get(sessionId);
            assertNotNull(events);
            assertEquals(1, events.size());
            assertTrue(events.contains(sessions.get(i).events().get(0)));
        }
    }
