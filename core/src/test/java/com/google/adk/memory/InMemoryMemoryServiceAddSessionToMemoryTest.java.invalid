public class InMemoryMemoryServiceAddSessionToMemoryTest {
    private InMemoryMemoryService memoryService;
    @BeforeEach
    public void setup() {
        memoryService = new InMemoryMemoryService();
    }
    // Helper to build mock Event with content and parts
    private Event mockEventWithParts(List<Part> parts, boolean contentPresent) {
        Event mockEvent = Mockito.mock(Event.class);
        com.google.genai.types.Content mockContent = Mockito.mock(com.google.genai.types.Content.class);
        if (contentPresent) {
            Mockito.when(mockEvent.content()).thenReturn(Optional.of(mockContent));
            Mockito.when(mockContent.parts()).thenReturn(Optional.of(parts));
        } else {
            Mockito.when(mockEvent.content()).thenReturn(Optional.empty());
        }
        return mockEvent;
    }
    // Helper to build mock Session
    private Session mockSession(String appName, String userId, String sessionId, List<Event> events) {
        Session mockSession = Mockito.mock(Session.class);
        Mockito.when(mockSession.appName()).thenReturn(appName);
        Mockito.when(mockSession.userId()).thenReturn(userId);
        Mockito.when(mockSession.id()).thenReturn(sessionId);
        Mockito.when(mockSession.events()).thenReturn(events);
        return mockSession;
    }
    @Test
    @Tag("valid")
    @DisplayName("Scenario 1: Add a Session with Multiple Non-Empty Events")
    public void testAddSessionWithMultipleNonEmptyEvents() {
        String appName = "testApp";
        String userId = "user1";
        String sessionId = "session123";
        List<Part> parts1 = Collections.singletonList(Mockito.mock(Part.class));
        List<Part> parts2 = Collections.singletonList(Mockito.mock(Part.class));
        Event event1 = mockEventWithParts(parts1, true);
        Event event2 = mockEventWithParts(parts2, true);
        Session session = mockSession(appName, userId, sessionId, ImmutableList.of(event1, event2));
        Completable result = memoryService.addSessionToMemory(session);
        result.blockingAwait();
        String key = appName + "/" + userId;
        Map<String, List<Event>> userSessions = (Map<String, List<Event>>) ((ConcurrentHashMap<String, Map<String, List<Event>>>)memoryService.sessionEvents).get(key);
        assertNotNull(userSessions, "Session map should not be null");
        assertTrue(userSessions.containsKey(sessionId));
        List<Event> stored = (List<Event>) userSessions.get(sessionId);
        assertEquals(2, stored.size());
        assertTrue(stored.contains(event1));
        assertTrue(stored.contains(event2));
    }
