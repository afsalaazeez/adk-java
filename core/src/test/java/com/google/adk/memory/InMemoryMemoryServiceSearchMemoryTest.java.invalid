    @Test
    @Tag("integration")
    public void testSearchIsolatedByUserKey() {
        String query = "cake";
        // "main" user
        Part partMain = mockPart("cake");
        Content contentMain = mockContent(Optional.of(Collections.singletonList(partMain)));
        Event eventMain = mockEvent(Optional.of(contentMain), "mainUser", 10L);
        Map<String, List<Event>> userSessionsA = new ConcurrentHashMap<>();
        userSessionsA.put("sess1", Collections.singletonList(eventMain));
        ((Map<String, Map<String, List<Event>>>)getSessionEventsMap(memoryService))
                .put(APP_NAME + "/" + USER_ID, userSessionsA);
        // Another user
        final String OTHER_USER_ID = "otheruser";
        Part partOther = mockPart("cake");
        Content contentOther = mockContent(Optional.of(Collections.singletonList(partOther)));
        Event eventOther = mockEvent(Optional.of(contentOther), "otherUser", 11L);
        Map<String, List<Event>> userSessionsB = new ConcurrentHashMap<>();
        userSessionsB.put("sessX", Collections.singletonList(eventOther));
        ((Map<String, Map<String, List<Event>>>)getSessionEventsMap(memoryService))
                .put(APP_NAME + "/" + OTHER_USER_ID, userSessionsB);
        // Search via user:id=USER_ID
        TestObserver<SearchMemoryResponse> observer = memoryService.searchMemory(APP_NAME, USER_ID, query).test();
        observer.awaitCount(1);
        List<MemoryEntry> entries = ((List<MemoryEntry>) observer.values().get(0).memories());
        assertEquals(1, entries.size());
        assertEquals("mainUser", entries.get(0).author());
    }
