    // ==================== MOCK/HELPERS ====================
    @SuppressWarnings("unchecked")
    private static Object getSessionEventsMap(InMemoryMemoryService memoryService) {
        try {
            java.lang.reflect.Field f = InMemoryMemoryService.class.getDeclaredField("sessionEvents");
            f.setAccessible(true);
            return f.get(memoryService);
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }
    private static Event mockEvent(Optional<Content> content, String author, long timestamp) {
        Event event = Mockito.mock(Event.class);
        Mockito.when(event.content()).thenReturn(content);
        Mockito.when(event.author()).thenReturn(author);
        Mockito.when(event.timestamp()).thenReturn(timestamp);
        return event;
    }
    private static Content mockContent(Optional<List<Part>> partsOpt) {
        Content content = Mockito.mock(Content.class);
        Mockito.when(content.parts()).thenReturn(partsOpt);
        return content;
    }
    private static Part mockPart(String text) {
        Part part = Mockito.mock(Part.class);
        Optional<String> textOpt = (text == null) ? Optional.empty() : Optional.of(text);
        Mockito.when(part.text()).thenReturn(textOpt);
        return part;
    }
}