    // ---------- TEST 7 ----------
    @Test
    @Tag("valid")
    public void testSearchFindsEventWhenQueryMatchesEventText() {
        String query = "hello";
        Part part = mockPart("hello world");
        Content content = mockContent(Optional.of(Collections.singletonList(part)));
        String author = "theAuthor";
        long timestamp = 888L;
        Event event = mockEvent(Optional.of(content), author, timestamp);
        Map<String, List<Event>> userSessions = new ConcurrentHashMap<>();
        userSessions.put(SESSION_ID, Collections.singletonList(event));
        ((Map<String, Map<String, List<Event>>>)getSessionEventsMap(memoryService))
                .put(APP_NAME + "/" + USER_ID, userSessions);
        TestObserver<SearchMemoryResponse> observer = memoryService.searchMemory(APP_NAME, USER_ID, query).test();
        observer.awaitCount(1);
        SearchMemoryResponse response = observer.values().get(0);
        List<MemoryEntry> list = ((List<MemoryEntry>) response.memories());
        assertEquals(1, list.size());
        assertEquals(content, list.get(0).content());
        assertEquals(author, list.get(0).author());
        assertEquals(Instant.ofEpochSecond(timestamp).toString(), list.get(0).timestamp());
    }
