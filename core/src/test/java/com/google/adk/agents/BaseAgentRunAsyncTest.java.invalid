    @Test
    @Tag("valid")
    void runAsyncWithMultipleBeforeCallbacksFirstReturnsContent() {
        try (MockedStatic<Telemetry> telemetryMock = Mockito.mockStatic(Telemetry.class);
             MockedStatic<Context> contextMock = Mockito.mockStatic(Context.class)) {
            
            telemetryMock.when(Telemetry::getTracer).thenReturn(tracer);
            contextMock.when(Context::current).thenReturn(context);
            AtomicBoolean secondCallbackCalled = new AtomicBoolean(false);
            BeforeAgentCallback firstCallback = ctx -> {
                ctx.invocationContext.setEndInvocation(true);
                return Maybe.just(Content.builder().build());
            };
            BeforeAgentCallback secondCallback = ctx -> {
                secondCallbackCalled.set(true);
                return Maybe.empty();
            };
            agent = new TestBaseAgent("testAgent", "Test Agent", ImmutableList.of(), 
                ImmutableList.of(firstCallback, secondCallback), null);
            agent.setRunAsyncImplResult(Flowable.just(createTestEvent("should-not-emit")));
            telemetryMock.when(() -> Telemetry.traceFlowable(any(), any(), any()))
                .thenAnswer(invocation -> {
                    Function<Void, Flowable<Event>> supplier = invocation.getArgument(2);
                    return supplier.apply(null);
                });
            List<Event> events = agent.runAsync(parentContext).toList().blockingGet();
            assert events.size() == 1;
            assert !secondCallbackCalled.get();
        }
    }
    @Test
