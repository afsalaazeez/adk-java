    @Test
    @Tag("valid")
    void runAsyncWithDeferredFlowableCreation() {
        try (MockedStatic<Telemetry> telemetryMock = Mockito.mockStatic(Telemetry.class);
             MockedStatic<Context> contextMock = Mockito.mockStatic(Context.class)) {
            
            telemetryMock.when(Telemetry::getTracer).thenReturn(tracer);
            contextMock.when(Context::current).thenReturn(context);
            AtomicBoolean executionTriggered = new AtomicBoolean(false);
            agent = new TestBaseAgent("testAgent", "Test Agent", ImmutableList.of(), null, null);
            agent.setRunAsyncImplResult(Flowable.defer(() -> {
                executionTriggered.set(true);
                return Flowable.just(createTestEvent("main-event"));
            }));
            telemetryMock.when(() -> Telemetry.traceFlowable(any(), any(), any()))
                .thenAnswer(invocation -> {
                    Function<Void, Flowable<Event>> supplier = invocation.getArgument(2);
                    return supplier.apply(null);
                });
            Flowable<Event> flowable = agent.runAsync(parentContext);
            assert !executionTriggered.get();
            flowable.toList().blockingGet();
            assert executionTriggered.get();
        }
    }
