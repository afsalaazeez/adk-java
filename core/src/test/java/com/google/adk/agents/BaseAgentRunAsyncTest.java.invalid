    void runAsyncWithParentContextHavingNullPluginManager() {
        try (MockedStatic<Telemetry> telemetryMock = Mockito.mockStatic(Telemetry.class);
             MockedStatic<Context> contextMock = Mockito.mockStatic(Context.class)) {
            
            telemetryMock.when(Telemetry::getTracer).thenReturn(tracer);
            contextMock.when(Context::current).thenReturn(context);
            Session session = mock(Session.class);
            when(session.appName()).thenReturn("testApp");
            when(session.userId()).thenReturn("testUser");
            when(session.id()).thenReturn("sessionId");
            InvocationContext nullPluginContext = new InvocationContext(
                mock(BaseSessionService.class),
                mock(BaseArtifactService.class),
                mock(BaseMemoryService.class),
                null,
                Optional.empty(),
                Optional.empty(),
                "invocation-123",
                null,
                session,
                Optional.empty(),
                mock(RunConfig.class),
                false
            );
            agent = new TestBaseAgent("testAgent", "Test Agent", ImmutableList.of(), null, null);
            agent.setRunAsyncImplResult(Flowable.just(createTestEvent("main-event")));
            telemetryMock.when(() -> Telemetry.traceFlowable(any(), any(), any()))
                .thenAnswer(invocation -> {
                    Function<Void, Flowable<Event>> supplier = invocation.getArgument(2);
                    return supplier.apply(null);
                });
            try {
                agent.runAsync(nullPluginContext).toList().blockingGet();
                assert false : "Expected NullPointerException";
            } catch (NullPointerException e) {
                assert true;
            }
        }
    }
    @Test
    @Tag("integration")
    void runAsyncWithTelemetryTraceFlowableWrappingExecution() {
        try (MockedStatic<Telemetry> telemetryMock = Mockito.mockStatic(Telemetry.class);
             MockedStatic<Context> contextMock = Mockito.mockStatic(Context.class)) {
            
            telemetryMock.when(Telemetry::getTracer).thenReturn(tracer);
            contextMock.when(Context::current).thenReturn(context);
            AtomicBoolean traceFlowableCalled = new AtomicBoolean(false);
            agent = new TestBaseAgent("testAgent", "Test Agent", ImmutableList.of(), null, null);
            agent.setRunAsyncImplResult(Flowable.just(createTestEvent("main-event")));
            telemetryMock.when(() -> Telemetry.traceFlowable(any(), any(), any()))
                .thenAnswer(invocation -> {
                    traceFlowableCalled.set(true);
                    Function<Void, Flowable<Event>> supplier = invocation.getArgument(2);
                    return supplier.apply(null);
                });
            agent.runAsync(parentContext).toList().blockingGet();
            assert traceFlowableCalled.get();
        }
    }
    private Event createTestEvent(String id) {
        return Event.builder()
            .id(id)
            .invocationId("invocation-123")
            .author("testAgent")
            .branch(Optional.of("testBranch"))
            .build();
    }
    private static class TestBaseAgent extends BaseAgent {
        private Flowable<Event> runAsyncImplResult;
        InvocationContext capturedContext;
        public TestBaseAgent(String name, String description, List<? extends BaseAgent> subAgents,
                           List<? extends BeforeAgentCallback> beforeAgentCallback,
                           List<? extends AfterAgentCallback> afterAgentCallback) {
            super(name, description, subAgents, beforeAgentCallback, afterAgentCallback);
        }
        public void setRunAsyncImplResult(Flowable<Event> result) {
            this.runAsyncImplResult = result;
        }
        @Override
        protected Flowable<Event> runAsyncImpl(InvocationContext invocationContext) {
            this.capturedContext = invocationContext;
            return runAsyncImplResult != null ? runAsyncImplResult : Flowable.empty();
        }
        @Override
        protected Flowable<Event> runLiveImpl(InvocationContext invocationContext) {
            return Flowable.empty();
        }
    }
}