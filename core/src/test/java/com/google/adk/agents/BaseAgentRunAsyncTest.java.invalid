    void setUp() {
        pluginManager = mock(PluginManager.class);
        tracer = mock(Tracer.class);
        span = mock(Span.class);
        spanBuilder = mock(SpanBuilder.class);
        context = mock(Context.class);
        when(spanBuilder.setParent(any(Context.class))).thenReturn(spanBuilder);
        when(spanBuilder.startSpan()).thenReturn(span);
        when(tracer.spanBuilder(anyString())).thenReturn(spanBuilder);
        when(context.with(any(Span.class))).thenReturn(context);
        Session session = mock(Session.class);
        when(session.appName()).thenReturn("testApp");
        when(session.userId()).thenReturn("testUser");
        when(session.id()).thenReturn("sessionId");
        RunConfig runConfig = mock(RunConfig.class);
        BaseSessionService sessionService = mock(BaseSessionService.class);
        BaseArtifactService artifactService = mock(BaseArtifactService.class);
        BaseMemoryService memoryService = mock(BaseMemoryService.class);
        parentContext = new InvocationContext(
            sessionService,
            artifactService,
            memoryService,
            pluginManager,
            Optional.empty(),
            Optional.empty(),
            "invocation-123",
            null,
            session,
            Optional.empty(),
            runConfig,
            false
        );
        when(pluginManager.runBeforeAgentCallback(any(), any())).thenReturn(Maybe.empty());
        when(pluginManager.runAfterAgentCallback(any(), any())).thenReturn(Maybe.empty());
    }
    @Test
    @Tag("valid")
    void runAsyncWithNoCallbacksAndNoEarlyTermination() {
        try (MockedStatic<Telemetry> telemetryMock = Mockito.mockStatic(Telemetry.class);
             MockedStatic<Context> contextMock = Mockito.mockStatic(Context.class)) {
            
            telemetryMock.when(Telemetry::getTracer).thenReturn(tracer);
            contextMock.when(Context::current).thenReturn(context);
            Event mainEvent = createTestEvent("main-event");
            agent = new TestBaseAgent("testAgent", "Test Agent", ImmutableList.of(), null, null);
            agent.setRunAsyncImplResult(Flowable.just(mainEvent));
            telemetryMock.when(() -> Telemetry.traceFlowable(any(), any(), any()))
                .thenAnswer(invocation -> {
                    Function<Void, Flowable<Event>> supplier = invocation.getArgument(2);
                    return supplier.apply(null);
                });
            List<Event> events = agent.runAsync(parentContext).toList().blockingGet();
            assert events.size() == 1;
            assert events.get(0).id().equals("main-event");
            verify(spanBuilder).startSpan();
        }
    }
    @Test
    @Tag("valid")
    void runAsyncWithBeforeCallbackReturningContentAndEndingInvocation() {
        try (MockedStatic<Telemetry> telemetryMock = Mockito.mockStatic(Telemetry.class);
             MockedStatic<Context> contextMock = Mockito.mockStatic(Context.class)) {
            
            telemetryMock.when(Telemetry::getTracer).thenReturn(tracer);
            contextMock.when(Context::current).thenReturn(context);
            BeforeAgentCallback beforeCallback = ctx -> {
                ctx.invocationContext.setEndInvocation(true);
                return Maybe.just(Content.builder().build());
            };
            agent = new TestBaseAgent("testAgent", "Test Agent", ImmutableList.of(), 
                ImmutableList.of(beforeCallback), null);
            agent.setRunAsyncImplResult(Flowable.just(createTestEvent("should-not-emit")));
            telemetryMock.when(() -> Telemetry.traceFlowable(any(), any(), any()))
                .thenAnswer(invocation -> {
                    Function<Void, Flowable<Event>> supplier = invocation.getArgument(2);
                    return supplier.apply(null);
                });
            List<Event> events = agent.runAsync(parentContext).toList().blockingGet();
            assert events.size() == 1;
            assert !events.get(0).id().equals("should-not-emit");
        }
    }
