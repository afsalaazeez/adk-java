        Flowable<Event> result = agent.runAsyncImpl(invocationContext);
        CountDownLatch latch = new CountDownLatch(3);
        List<TestSubscriber<Event>> subscribers = new ArrayList<>();
        for (int i = 0; i < 3; i++) {
            TestSubscriber<Event> subscriber = new TestSubscriber<>();
            subscribers.add(subscriber);
            result.subscribe(subscriber);
            subscriber.doOnComplete(() -> latch.countDown());
        }
        latch.await(5, TimeUnit.SECONDS);
        for (TestSubscriber<Event> subscriber : subscribers) {
            subscriber.assertComplete();
            subscriber.assertNoErrors();
        }
    }
