    @Test
    @Tag("valid")
    void runLiveHandlesConcurrentSubscriptionsIndependently() throws InterruptedException {
        AtomicInteger executionCount = new AtomicInteger(0);
        testAgent.setRunLiveImplBehavior(() -> {
            executionCount.incrementAndGet();
            return Flowable.just(createTestEvent("event-" + executionCount.get()));
        });
        
        setupMocksForSuccessfulExecution();
        try (MockedStatic<Telemetry> telemetryMock = mockStatic(Telemetry.class)) {
            telemetryMock.when(Telemetry::getTracer).thenReturn(mockTracer);
            telemetryMock.when(() -> Telemetry.traceFlowable(any(), any(), any()))
                    .thenAnswer(invocation -> {
                        java.util.function.Supplier<Flowable<Event>> supplier = invocation.getArgument(2);
                        return supplier.get();
                    });
            Flowable<Event> flowable = testAgent.runLive(mockParentContext);
            
            CountDownLatch latch = new CountDownLatch(2);
            List<Event> results1 = new ArrayList<>();
            List<Event> results2 = new ArrayList<>();
            flowable.subscribe(
                    results1::add,
                    Throwable::printStackTrace,
                    latch::countDown
            );
            flowable.subscribe(
                    results2::add,
                    Throwable::printStackTrace,
                    latch::countDown
            );
            latch.await(10, TimeUnit.SECONDS);
            assertEquals(1, results1.size());
            assertEquals(1, results2.size());
            assertEquals(2, executionCount.get());
        }
    }
