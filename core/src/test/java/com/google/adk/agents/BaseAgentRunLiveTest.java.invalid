    @Test
    @Tag("integration")
    void runLiveCallsTraceFlowableWithCorrectParameters() {
        testAgent.setRunLiveImplBehavior(() -> Flowable.just(createTestEvent("event-1")));
        setupMocksForSuccessfulExecution();
        try (MockedStatic<Telemetry> telemetryMock = mockStatic(Telemetry.class);
             MockedStatic<Context> contextMock = mockStatic(Context.class)) {
            
            telemetryMock.when(Telemetry::getTracer).thenReturn(mockTracer);
            contextMock.when(Context::current).thenReturn(mockContext);
            when(mockContext.with(mockSpan)).thenReturn(mockContext);
            AtomicBoolean traceFlowableCalled = new AtomicBoolean(false);
            telemetryMock.when(() -> Telemetry.traceFlowable(any(Context.class), any(Span.class), any()))
                    .thenAnswer(invocation -> {
                        traceFlowableCalled.set(true);
                        Context ctx = invocation.getArgument(0);
                        Span span = invocation.getArgument(1);
                        java.util.function.Supplier<Flowable<Event>> supplier = invocation.getArgument(2);
                        
                        assertEquals(mockContext, ctx);
                        assertEquals(mockSpan, span);
                        
                        return supplier.get();
                    });
            testAgent.runLive(mockParentContext).test().awaitDone(5, TimeUnit.SECONDS);
            assertTrue(traceFlowableCalled.get());
        }
    }
