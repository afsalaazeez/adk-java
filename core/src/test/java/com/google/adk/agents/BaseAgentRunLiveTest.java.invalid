    @Test
    @Tag("valid")
    void runLiveStartsSpanBeforeRunLiveImplExecution() {
        AtomicBoolean spanStarted = new AtomicBoolean(false);
        AtomicBoolean runLiveImplCalled = new AtomicBoolean(false);
        
        testAgent.setRunLiveImplBehavior(() -> {
            runLiveImplCalled.set(true);
            assertTrue(spanStarted.get(), "Span should be started before runLiveImpl is called");
            return Flowable.just(createTestEvent("event-1"));
        });
        when(mockTracer.spanBuilder(anyString())).thenReturn(mockSpanBuilder);
        when(mockSpanBuilder.setParent(any(Context.class))).thenReturn(mockSpanBuilder);
        when(mockSpanBuilder.startSpan()).thenAnswer(invocation -> {
            spanStarted.set(true);
            return mockSpan;
        });
        setupMocksForSuccessfulExecution();
        try (MockedStatic<Telemetry> telemetryMock = mockStatic(Telemetry.class);
             MockedStatic<Context> contextMock = mockStatic(Context.class)) {
            
            telemetryMock.when(Telemetry::getTracer).thenReturn(mockTracer);
            contextMock.when(Context::current).thenReturn(mockContext);
            when(mockContext.with(mockSpan)).thenReturn(mockContext);
            
            telemetryMock.when(() -> Telemetry.traceFlowable(any(), any(), any()))
                    .thenAnswer(invocation -> {
                        java.util.function.Supplier<Flowable<Event>> supplier = invocation.getArgument(2);
                        return supplier.get();
                    });
            testAgent.runLive(mockParentContext).test().awaitDone(5, TimeUnit.SECONDS);
            assertTrue(spanStarted.get());
            assertTrue(runLiveImplCalled.get());
        }
    }
    @Test
    @Tag("valid")
    void runLiveSetsAgentInInvocationContext() {
        AtomicReference<BaseAgent> capturedAgent = new AtomicReference<>();
        testAgent.setRunLiveImplBehavior(() -> {
            InvocationContext ctx = testAgent.getCapturedInvocationContext();
            if (ctx != null) {
                capturedAgent.set(ctx.agent());
            }
            return Flowable.just(createTestEvent("event-1"));
        });
        setupMocksForSuccessfulExecution();
        try (MockedStatic<Telemetry> telemetryMock = mockStatic(Telemetry.class)) {
            telemetryMock.when(Telemetry::getTracer).thenReturn(mockTracer);
            telemetryMock.when(() -> Telemetry.traceFlowable(any(), any(), any()))
                    .thenAnswer(invocation -> {
                        java.util.function.Supplier<Flowable<Event>> supplier = invocation.getArgument(2);
                        return supplier.get();
                    });
            testAgent.runLive(mockParentContext).test().awaitDone(5, TimeUnit.SECONDS);
            assertNotNull(capturedAgent.get());
            assertSame(testAgent, capturedAgent.get());
        }
    }
    private void setupMocksForSuccessfulExecution() {
        when(mockTracer.spanBuilder(anyString())).thenReturn(mockSpanBuilder);
        when(mockSpanBuilder.setParent(any(Context.class))).thenReturn(mockSpanBuilder);
        when(mockSpanBuilder.startSpan()).thenReturn(mockSpan);
        
        when(mockParentContext.sessionService()).thenReturn(mockSessionService);
        when(mockParentContext.artifactService()).thenReturn(mockArtifactService);
        when(mockParentContext.memoryService()).thenReturn(mockMemoryService);
        when(mockParentContext.pluginManager()).thenReturn(mockPluginManager);
        when(mockParentContext.session()).thenReturn(mockSession);
        when(mockParentContext.runConfig()).thenReturn(mockRunConfig);
        when(mockParentContext.invocationId()).thenReturn("test-invocation-id");
        when(mockParentContext.branch()).thenReturn(Optional.empty());
        when(mockParentContext.userContent()).thenReturn(Optional.empty());
        when(mockParentContext.liveRequestQueue()).thenReturn(Optional.empty());
    }
    private Event createTestEvent(String id) {
        return Event.builder()
                .id(id)
                .invocationId("test-invocation")
                .author("TestAgent")
                .build();
    }
    private static class TestableBaseAgent extends BaseAgent {
        private java.util.function.Supplier<Flowable<Event>> runLiveImplBehavior;
        private InvocationContext capturedInvocationContext;
        public TestableBaseAgent(String name, String description, List<? extends BaseAgent> subAgents,
                                 List<? extends BeforeAgentCallback> beforeAgentCallback,
                                 List<? extends AfterAgentCallback> afterAgentCallback) {
            super(name, description, subAgents, beforeAgentCallback, afterAgentCallback);
        }
        public void setRunLiveImplBehavior(java.util.function.Supplier<Flowable<Event>> behavior) {
            this.runLiveImplBehavior = behavior;
        }
        public InvocationContext getCapturedInvocationContext() {
            return capturedInvocationContext;
        }
        @Override
        protected Flowable<Event> runAsyncImpl(InvocationContext invocationContext) {
            return Flowable.empty();
        }
        @Override
        protected Flowable<Event> runLiveImpl(InvocationContext invocationContext) {
            this.capturedInvocationContext = invocationContext;
            if (runLiveImplBehavior != null) {
                return runLiveImplBehavior.get();
            }
            return Flowable.empty();
        }
    }
}