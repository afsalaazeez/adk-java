public class LoopAgentRunAsyncImplTest extends BaseAgent {
    public LoopAgentRunAsyncImplTest() {
        super("TestLoop", "Test Loop Description", ImmutableList.of(), ImmutableList.of(), ImmutableList.of());
    }
    // Required by abstract subclassing.
    @Override
    protected Flowable<Event> runAsyncImpl(InvocationContext invocationContext) {
        return Flowable.empty();
    }
    @Override
    protected Flowable<Event> runLiveImpl(InvocationContext invocationContext) {
        return Flowable.empty();
    }
    // Utility method for building events with escalate actions
    private Event buildEvent(String id, boolean escalate) {
        // Create EventActions mock
        EventActions actionsMock = mock(EventActions.class);
        when(actionsMock.escalate()).thenReturn(escalate ? Optional.of(Boolean.TRUE) : Optional.of(Boolean.FALSE));
        // Create Event mock and stub actions() to return actionsMock
        Event eventMock = mock(Event.class);
        when(eventMock.actions()).thenReturn(actionsMock);
        when(eventMock.toString()).thenReturn(id);
        return eventMock;
    }
    private Event buildEventEscalateOptionalEmpty(String id) {
        EventActions actionsMock = mock(EventActions.class);
        when(actionsMock.escalate()).thenReturn(Optional.empty());
        Event eventMock = mock(Event.class);
        when(eventMock.actions()).thenReturn(actionsMock);
        when(eventMock.toString()).thenReturn(id);
        return eventMock;
    }
    // Helper for build LoopAgent
    private LoopAgent buildLoopAgent(String name, String desc, List<? extends BaseAgent> subs, Optional<Integer> maxIterations) {
        return LoopAgent.builder()
                .name(name)
                .description(desc)
                .subAgents(subs)
                .maxIterations(maxIterations)
                .build();
    }
    // Helper to create a LoopAgent with direct parameters
    private LoopAgent buildLoopAgentNoMaxIterations(String name, String desc, List<? extends BaseAgent> subs) {
        return LoopAgent.builder()
                .name(name)
                .description(desc)
                .subAgents(subs)
                .build();
    }
    // Helper for InvocationContext dummy
    private InvocationContext dummyInvocationContext() {
        BaseSessionService sessionService = mock(BaseSessionService.class);
        BaseArtifactService artifactService = mock(BaseArtifactService.class);
        Session session = mock(Session.class);
        when(session.appName()).thenReturn("AppName");
        when(session.userId()).thenReturn("UserId");
        RunConfig runConfig = mock(RunConfig.class);
        return InvocationContext.create(sessionService, artifactService, "invId", this, session, null, runConfig);
    }
    // Scenario 1: Sub-agent List is Null
    @Test
    @Tag("boundary")
    public void testSubAgentListIsNullReturnsEmptyFlowable() {
        LoopAgent loopAgent = buildLoopAgent("Agent", "Desc", null, Optional.of(1));
        InvocationContext ctx = dummyInvocationContext();
        Flowable<Event> flowable = loopAgent.runAsyncImpl(ctx);
        TestSubscriber<Event> subscriber = new TestSubscriber<>();
        flowable.subscribe(subscriber);
        subscriber.assertNoValues();
        subscriber.assertComplete();
    }
    // Scenario 2: Sub-agent List is Empty
    @Test
    @Tag("boundary")
    public void testSubAgentListIsEmptyReturnsEmptyFlowable() {
        LoopAgent loopAgent = buildLoopAgent("Agent", "Desc", ImmutableList.of(), Optional.of(1));
        InvocationContext ctx = dummyInvocationContext();
        Flowable<Event> flowable = loopAgent.runAsyncImpl(ctx);
        TestSubscriber<Event> subscriber = new TestSubscriber<>();
        flowable.subscribe(subscriber);
        subscriber.assertNoValues();
        subscriber.assertComplete();
    }
    // Scenario 3: Single Sub-agent, No maxIterations Specified, No Escalate Action
    @Test
    @Tag("valid")
    public void testSingleSubAgentNoMaxIterationsNoEscalationRunsOnce() {
        BaseAgent sub = mock(BaseAgent.class);
        Event event = buildEvent("E1", false);
        when(sub.runAsync(any())).thenReturn(Flowable.just(event));
        LoopAgent loopAgent = buildLoopAgentNoMaxIterations("Agent", "Desc", ImmutableList.of(sub));
        InvocationContext ctx = dummyInvocationContext();
        Flowable<Event> flowable = loopAgent.runAsyncImpl(ctx);
        TestSubscriber<Event> subscriber = new TestSubscriber<>();
        flowable.take(3).subscribe(subscriber); // Limit for practical sampling
        List<Event> received = subscriber.values();
        assertEquals(3, (int)received.size(), "Should repeat indefinitely. We validate first 3.");
        assertTrue(received.stream().allMatch(e -> e == event), "All events must be same mock.");
        // for RxJava take(), not necessarily completed
    }
    // Scenario 4: Multiple Sub-agents, All Return Events Without Escalate, maxIterations Specified
    @Test
    @Tag("valid")
    public void testMultipleSubAgentsWithMaxIterationsExecutions() {
        BaseAgent subA = mock(BaseAgent.class);
        BaseAgent subB = mock(BaseAgent.class);
        Event eventA = buildEvent("A", false);
        Event eventB = buildEvent("B", false);
        when(subA.runAsync(any())).thenReturn(Flowable.just(eventA));
        when(subB.runAsync(any())).thenReturn(Flowable.just(eventB));
        LoopAgent loopAgent = buildLoopAgent("Agent", "Desc", ImmutableList.of(subA, subB), Optional.of(3));
        InvocationContext ctx = dummyInvocationContext();
        TestSubscriber<Event> subscriber = new TestSubscriber<>();
        loopAgent.runAsyncImpl(ctx).subscribe(subscriber);
        List<Event> received = subscriber.values();
        List<Event> expected = new ArrayList<>();
        for (int i = 0; i < 3; i++) {
            expected.add(eventA);
            expected.add(eventB);
        }
        assertEquals(expected, received, "Should repeat sub-agents order for each iteration, maxIterations times.");
        subscriber.assertComplete();
    }
    // Scenario 5: Sub-agent Emits Event That Triggers Escalate Action
    @Test
    @Tag("boundary")
    public void testSubAgentEventTriggersEscalationStopsLoop() {
        BaseAgent subA = mock(BaseAgent.class);
        BaseAgent subB = mock(BaseAgent.class);
        Event eventA = buildEvent("A", false);
        Event eventB = buildEvent("B", true);
        when(subA.runAsync(any())).thenReturn(Flowable.just(eventA));
        when(subB.runAsync(any())).thenReturn(Flowable.just(eventB));
        LoopAgent loopAgent = buildLoopAgent("Agent", "Desc", ImmutableList.of(subA, subB), Optional.of(10));
        InvocationContext ctx = dummyInvocationContext();
        TestSubscriber<Event> subscriber = new TestSubscriber<>();
        loopAgent.runAsyncImpl(ctx).subscribe(subscriber);
        List<Event> events = subscriber.values();
        assertEquals(2, (int)events.size(), "Should stop after escalation event.");
        assertEquals(eventA, events.get(0));
        assertEquals(eventB, events.get(1));
        subscriber.assertComplete();
    }
