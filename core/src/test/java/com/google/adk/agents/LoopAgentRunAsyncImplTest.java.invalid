        subscriber.assertComplete();
    }
    // Scenario 15: mix of Escalate and Non-Escalate Events in Sub-agent Outputs
    @Test
    @Tag("boundary")
    public void testSubAgentsMixedEscalationsTerminatesAtFirstEscalation() {
        BaseAgent subA = mock(BaseAgent.class);
        BaseAgent subB = mock(BaseAgent.class);
        BaseAgent subC = mock(BaseAgent.class);
        Event eventA = buildEvent("A", false);
        Event eventB = buildEvent("B", true); // escalate
        Event eventC = buildEvent("C", false);
        when(subA.runAsync(any())).thenReturn(Flowable.just(eventA));
        when(subB.runAsync(any())).thenReturn(Flowable.just(eventB));
        when(subC.runAsync(any())).thenReturn(Flowable.just(eventC));
        LoopAgent loopAgent = buildLoopAgent("Agent", "Desc", ImmutableList.of(subA, subB, subC), Optional.of(10));
        InvocationContext ctx = dummyInvocationContext();
        TestSubscriber<Event> subscriber = new TestSubscriber<>();
        loopAgent.runAsyncImpl(ctx).subscribe(subscriber);
        List<Event> events = subscriber.values();
        assertEquals(2, (int)events.size());
        assertEquals(eventA, events.get(0));
        assertEquals(eventB, events.get(1));
        subscriber.assertComplete();
    }
    // Scenario 16: InvocationContext is Null
    @Test
    @Tag("invalid")
    public void testNullInvocationContextHandledGracefully() {
        BaseAgent subA = mock(BaseAgent.class);
        when(subA.runAsync(isNull())).thenReturn(Flowable.just(buildEvent("A", false)));
        LoopAgent loopAgent = buildLoopAgent("Agent", "Desc", ImmutableList.of(subA), Optional.of(1));
        Flowable<Event> flowable = loopAgent.runAsyncImpl(null);
        TestSubscriber<Event> subscriber = new TestSubscriber<>();
        flowable.subscribe(subscriber);
        assertEquals(1, (int)subscriber.values().size());
        assertEquals("A", (String)subscriber.values().get(0).toString());
        subscriber.assertComplete();
    }
    // Scenario 17: Sub-agents List Contains Null Elements
    @Test
    @Tag("invalid")
    public void testSubAgentsListContainsNullHandlesWithoutCrash() {
        BaseAgent subA = mock(BaseAgent.class);
        Event eventA = buildEvent("A", false);
        when(subA.runAsync(any())).thenReturn(Flowable.just(eventA));
        List<BaseAgent> subs = new ArrayList<>();
        subs.add(subA);
        subs.add(null); // Illegal, but should test defensively
        LoopAgent loopAgent = buildLoopAgent("Agent", "Desc", subs, Optional.of(1));
        InvocationContext ctx = dummyInvocationContext();
        TestSubscriber<Event> subscriber = new TestSubscriber<>();
        loopAgent.runAsyncImpl(ctx).subscribe(subscriber);
        List<Event> events = subscriber.values();
        // There should be an error as RxJava concatMap can't call method on null
        // Using TestSubscriber.getEvents().get(1) to check errors
        List<Throwable> errors = subscriber.getEvents().get(1);
        assertTrue(!errors.isEmpty() || events.size() == 1, "Handles null sub-agent without unhandled crash (expect error or skip).");
    }
    // Scenario 18: Sub-agent Emits Event with escalate() Returning False
    @Test
    @Tag("valid")
    public void testEscalateOptionalFalseContinuesLoop() {
        BaseAgent subA = mock(BaseAgent.class);
        Event event = buildEvent("A", false);
        when(subA.runAsync(any())).thenReturn(Flowable.just(event));
        LoopAgent loopAgent = buildLoopAgent("Agent", "Desc", ImmutableList.of(subA), Optional.of(3));
        InvocationContext ctx = dummyInvocationContext();
        TestSubscriber<Event> subscriber = new TestSubscriber<>();
        loopAgent.runAsyncImpl(ctx).subscribe(subscriber);
        List<Event> expected = Arrays.asList(event, event, event);
        assertEquals(expected, subscriber.values());
        subscriber.assertComplete();
    }
    // Scenario 19: All Sub-agents are Invoked in Correct Order in Each Iteration
    @Test
    @Tag("valid")
    public void testAllSubAgentsInvokedInOrderPerIteration() {
        BaseAgent subA = mock(BaseAgent.class);
        BaseAgent subB = mock(BaseAgent.class);
        BaseAgent subC = mock(BaseAgent.class);
        Event eventA = buildEvent("A", false);
        Event eventB = buildEvent("B", false);
        Event eventC = buildEvent("C", false);
        when(subA.runAsync(any())).thenReturn(Flowable.just(eventA));
        when(subB.runAsync(any())).thenReturn(Flowable.just(eventB));
        when(subC.runAsync(any())).thenReturn(Flowable.just(eventC));
        LoopAgent loopAgent = buildLoopAgent("Agent", "Desc", ImmutableList.of(subA, subB, subC), Optional.of(2));
        InvocationContext ctx = dummyInvocationContext();
        TestSubscriber<Event> subscriber = new TestSubscriber<>();
        loopAgent.runAsyncImpl(ctx).subscribe(subscriber);
        List<Event> expected = Arrays.asList(eventA, eventB, eventC, eventA, eventB, eventC);
        assertEquals(expected, subscriber.values());
        subscriber.assertComplete();
    }
}