        List<Event> allEvents = new ArrayList<>();
        for (int i = 0; i < agentsCount; i++) {
            BaseAgent sub = mock(BaseAgent.class);
            Event event = buildEvent("E" + i, false);
            when(sub.runAsync(any())).thenReturn(Flowable.just(event));
            subs.add(sub);
            allEvents.add(event);
        }
        LoopAgent loopAgent = buildLoopAgent("Agent", "Desc", subs, Optional.of(iterations));
        InvocationContext ctx = dummyInvocationContext();
        TestSubscriber<Event> subscriber = new TestSubscriber<>();
        loopAgent.runAsyncImpl(ctx).subscribe(subscriber);
        List<Event> expected = new ArrayList<>();
        for (int i = 0; i < iterations; i++) {
            expected.addAll(allEvents);
        }
        assertEquals(expected, subscriber.values());
        subscriber.assertComplete();
    }
